// flux_orm, an ORM for MeoSQL, as a library: no mb_bin. `mbuild check` and
// `mbuild build` type-check src/flux_orm.mettle and everything it imports;
// `mbuild test` runs the tests' @test entries. Apps add it with
// mb_dep_path("flux_orm", "../flux_orm") and `import "flux_orm/flux_orm"`.
//
// No toolchain pin: flux_orm needs the dev compiler (compile-time reflection,
// `Kind`, comptime for). Select it with METTLE or `mbuild --mettle PATH`.
import "mbuild/api";

fn project() {
  mb_package("flux_orm", "0.1.0");
  mb_import_root("src");
  mb_targets("linux");
}
