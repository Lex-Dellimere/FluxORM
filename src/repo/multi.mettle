// flux_orm/repo/multi.mettle — named steps in one transaction, after Ecto.Multi.
//
//   var m: RcMulti = rc_multi_new();
//   rc_multi_insert(&m, "post", &cs, &post);
//   rc_multi_update(&m, "author", &acs, &author);
//   rc = rc_repo_multi(&s, &m, RC_TX_DEFAULT);
//   // on failure: rc_multi_failed_name(&m) is "author", say, and nothing is
//   // written.
//   rc_multi_free(&m);
//
// Steps run in the order added. The first failure rolls the transaction back
// and returns that step's code. A failed commit is reported as step "commit".
//
// Models are changed in place, so after a rollback the steps that had run are
// put back as far as the ORM can: an inserted entity is NEW again with no
// auto key, an updated one gets its old version back and is DIRTY (its model
// keeps the new values, the store does not), and a deleted one gets its old
// state back. Running the same Multi again then retries every step.
//
// Inside an open transaction a Multi nests like any begin; its failure dooms
// the outer transaction.

import "std/mem";

import "../core/status";
import "../core/value";
import "../core/meta";
import "../core/entity";
import "../core/session";
import "../query/builder";
import "../changeset/changeset";
import "repo";

const RC_MS_INSERT: int32 = 1;
const RC_MS_UPDATE: int32 = 2;
const RC_MS_DELETE: int32 = 3;
const RC_MS_UPDATE_ALL: int32 = 4;
const RC_MS_DELETE_ALL: int32 = 5;
const RC_MS_RUN: int32 = 6;

export struct RcMultiStep {
  name: string;
  kind: int32;
  cs: RcChangeset*;
  e: RcEntity*;
  q: RcQuery*;
  body: fn(rawptr, RcSession*) -> int32;
  ctx: rawptr;
  n: int32;            // rows changed, for update_all / delete_all
  prior_state: int32;  // entity state before the step ran
  prior_version: int64;
}

export struct RcMulti {
  steps: RcMultiStep*;
  n_steps: int32;
  cap: int32;
  failed: int32;  // index of the failed step, n_steps for the commit, -1 none
  code: int32;
}

export fn rc_multi_new() -> RcMulti {
  var m: RcMulti;
  m.steps = 0;
  m.n_steps = 0;
  m.cap = 0;
  m.failed = -1;
  m.code = RC_OK;
  return m;
}

export fn rc_multi_free(m: RcMulti*) {
  if (m == 0) { return; }
  if (m->steps != 0) {
    free((rawptr)m->steps);
    m->steps = 0;
  }
  m->n_steps = 0;
  m->cap = 0;
}

// Appends a step with an empty body. Names must be unique and non-empty.
fn rc_multi_add(m: RcMulti*, name: string, kind: int32) -> RcMultiStep* {
  if (m == 0 || name.length == (uint64)0) { return 0; }
  var i: int32 = 0;
  while (i < m->n_steps) {
    if (m->steps[i].name == name) { return 0; }
    i = i + 1;
  }
  if (m->n_steps == m->cap) {
    var cap: int32 = m->cap * 2;
    if (cap < 4) { cap = 4; }
    var p: rawptr = realloc((rawptr)m->steps, (int64)cap * (int64)sizeof(RcMultiStep));
    if (p == 0) { return 0; }
    m->steps = (RcMultiStep*)p;
    m->cap = cap;
  }
  var st: RcMultiStep* = &m->steps[m->n_steps];
  st->name = name;
  st->kind = kind;
  st->cs = 0;
  st->e = 0;
  st->q = 0;
  st->body = 0;
  st->ctx = 0;
  st->n = 0;
  st->prior_state = RC_ST_NEW;
  st->prior_version = 0;
  m->n_steps = m->n_steps + 1;
  return st;
}

export fn rc_multi_insert(m: RcMulti*, name: string, cs: RcChangeset*, e: RcEntity*) -> int32 {
  if (e == 0) { return RC_ERR_USAGE; }
  var st: RcMultiStep* = rc_multi_add(m, name, RC_MS_INSERT);
  if (st == 0) { return RC_ERR_USAGE; }
  st->cs = cs;
  st->e = e;
  return RC_OK;
}

export fn rc_multi_update(m: RcMulti*, name: string, cs: RcChangeset*, e: RcEntity*) -> int32 {
  if (cs == 0 || e == 0) { return RC_ERR_USAGE; }
  var st: RcMultiStep* = rc_multi_add(m, name, RC_MS_UPDATE);
  if (st == 0) { return RC_ERR_USAGE; }
  st->cs = cs;
  st->e = e;
  return RC_OK;
}

export fn rc_multi_delete(m: RcMulti*, name: string, e: RcEntity*) -> int32 {
  if (e == 0) { return RC_ERR_USAGE; }
  var st: RcMultiStep* = rc_multi_add(m, name, RC_MS_DELETE);
  if (st == 0) { return RC_ERR_USAGE; }
  st->e = e;
  return RC_OK;
}

export fn rc_multi_update_all(m: RcMulti*, name: string, q: RcQuery*) -> int32 {
  if (q == 0) { return RC_ERR_USAGE; }
  var st: RcMultiStep* = rc_multi_add(m, name, RC_MS_UPDATE_ALL);
  if (st == 0) { return RC_ERR_USAGE; }
  st->q = q;
  return RC_OK;
}

export fn rc_multi_delete_all(m: RcMulti*, name: string, q: RcQuery*) -> int32 {
  if (q == 0) { return RC_ERR_USAGE; }
  var st: RcMultiStep* = rc_multi_add(m, name, RC_MS_DELETE_ALL);
  if (st == 0) { return RC_ERR_USAGE; }
  st->q = q;
  return RC_OK;
}

// A step of your own: `body(ctx, s)` returns RC_OK to go on.
export fn rc_multi_run(m: RcMulti*, name: string, body: fn(rawptr, RcSession*) -> int32,
                       ctx: rawptr) -> int32 {
  if (body == 0) { return RC_ERR_USAGE; }
  var st: RcMultiStep* = rc_multi_add(m, name, RC_MS_RUN);
  if (st == 0) { return RC_ERR_USAGE; }
  st->body = body;
  st->ctx = ctx;
  return RC_OK;
}

// The failed step's name: "" when nothing failed, "commit" for the commit.
export fn rc_multi_failed_name(m: RcMulti*) -> string {
  if (m == 0 || m->failed < 0) { return ""; }
  if (m->failed >= m->n_steps) { return "commit"; }
  return m->steps[m->failed].name;
}

export fn rc_multi_failed_step(m: RcMulti*) -> int32 {
  if (m == 0) { return -1; }
  return m->failed;
}

// Rows changed by the update_all / delete_all step called `name`, or -1.
export fn rc_multi_rows(m: RcMulti*, name: string) -> int32 {
  if (m == 0) { return -1; }
  var i: int32 = 0;
  while (i < m->n_steps) {
    if (m->steps[i].name == name) { return m->steps[i].n; }
    i = i + 1;
  }
  return -1;
}

fn rc_multi_version_of(e: RcEntity*, out: int64*) {
  *out = 0;
  var vf: int32 = rc_meta_version(e->meta);
  if (vf < 0) { return; }
  var v: RcValue = RcNull;
  if (rc_entity_get(e, vf, &v) != RC_OK) { return; }
  rc_value_as_i64(v, out);
}

fn rc_multi_step(s: RcSession*, st: RcMultiStep*) -> int32 {
  if (st->e != 0) {
    st->prior_state = st->e->state;
    rc_multi_version_of(st->e, &st->prior_version);
  }
  if (st->kind == RC_MS_INSERT) { return rc_repo_insert(s, st->cs, st->e); }
  if (st->kind == RC_MS_UPDATE) { return rc_repo_update(s, st->cs, st->e); }
  if (st->kind == RC_MS_DELETE) { return rc_repo_delete(s, st->e); }
  if (st->kind == RC_MS_UPDATE_ALL) { return rc_repo_update_all(s, st->q, &st->n); }
  if (st->kind == RC_MS_DELETE_ALL) { return rc_repo_delete_all(s, st->q, &st->n); }
  if (st->kind == RC_MS_RUN) { return st->body(st->ctx, s); }
  return RC_ERR_USAGE;
}

// Puts a step that ran back the way it was, after its write was rolled back.
fn rc_multi_undo(st: RcMultiStep*) {
  st->n = 0;
  var e: RcEntity* = st->e;
  if (e == 0) { return; }
  if (st->kind == RC_MS_INSERT) {
    e->state = RC_ST_NEW;
    var pk: int32 = rc_meta_pk(e->meta);
    if (pk >= 0 && (e->meta.fields[pk].flags & RC_F_AUTO) != 0) {
      e->nulls = rc_nulls_set(e->nulls, pk);
    }
    return;
  }
  if (st->kind == RC_MS_UPDATE) {
    var vf: int32 = rc_meta_version(e->meta);
    if (vf >= 0) {
      rc_meta_set(e->meta, e->model, &e->nulls, vf, RcInt(st->prior_version));
    }
    e->state = RC_ST_DIRTY;
    return;
  }
  if (st->kind == RC_MS_DELETE) { e->state = st->prior_state; }
}

// Runs every step of m inside one transaction (see the header).
export fn rc_repo_multi(s: RcSession*, m: RcMulti*, mode: int32) -> int32 {
  if (s == 0 || m == 0) { return RC_ERR_USAGE; }
  m->failed = -1;
  m->code = RC_OK;
  var rc: int32 = rc_session_begin(s, mode);
  if (rc != RC_OK) { return rc; }
  var i: int32 = 0;
  while (i < m->n_steps) {
    rc = rc_multi_step(s, &m->steps[i]);
    if (rc != RC_OK) {
      rc_session_rollback(s);
      m->failed = i;
      m->code = rc;
      var k: int32 = i - 1;
      while (k >= 0) {
        rc_multi_undo(&m->steps[k]);
        k = k - 1;
      }
      return rc;
    }
    i = i + 1;
  }
  rc = rc_session_commit(s);
  if (rc != RC_OK) {
    m->failed = m->n_steps;
    m->code = rc;
    var k: int32 = m->n_steps - 1;
    while (k >= 0) {
      rc_multi_undo(&m->steps[k]);
      k = k - 1;
    }
  }
  return rc;
}
