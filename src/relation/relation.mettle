// flux_orm/relation/relation.mettle — association metadata, checked at startup.
//
// A relation is *metadata*, not a column and not a method on a model. The
// models stay exactly what they are (`User`, `Post`: an int64 field is the
// foreign key) and the association is declared beside them:
//
//   posts  = rc_relation("posts", RC_REL_HAS_MANY, 0, "posts", 1)
//   user   = rc_relation("user", RC_REL_BELONGS_TO, 1, "users", 0)
//   tags   = rc_relation_through("posts", 0, "tags", 0, "post_tags",
//                                "post_id", "tag_id")
//
// Everything a relation can get wrong is wrong *at startup* and is refused by
// `rc_relation_check` here: a field index that does not exist, a key that is
// not RC_T_I64, a foreign table that is not the target model's table, a
// through table whose two columns are not the ones the loader projects. A
// loader that runs against unchecked metadata is the bug class this file
// exists to prevent, which is why `rc_relation_load` calls this check itself
// rather than trusting its caller.
//
// Nothing here touches a store. `src/relation/load.mettle` is the only place
// that emits a statement.

import "../core/status";
import "../core/value";
import "../core/meta";

// Relation kinds. Unique to this phase, so RC_REL_* cannot collide with a
// status code or a flag.
export const RC_REL_HAS_MANY: int32 = 0;
export const RC_REL_BELONGS_TO: int32 = 1;
export const RC_REL_HAS_MANY_THROUGH: int32 = 2;

export struct RcRelation {
  name: string;            // "posts" / "user" / "tags"
  kind: int32;             // RC_REL_*
  local_field: int32;      // owner-side field index
  foreign_table: string;   // target table name, must equal target_meta.table
  foreign_field: int32;    // target-side field index
  through_table: string;   // RC_REL_HAS_MANY_THROUGH only, else ""
  through_local: string;   // through column holding the owner key
  through_foreign: string; // through column holding the target key
}

// `foreign_table` is stored (not derived) so the declaration reads like the
// schema it describes and a typo is caught by rc_relation_check's string
// comparison instead of silently selecting from the target's own table.
export fn rc_relation(name: string, kind: int32, local_field: int32,
                      foreign_table: string, foreign_field: int32) -> RcRelation {
  var r: RcRelation;
  r.name = name;
  r.kind = kind;
  r.local_field = local_field;
  r.foreign_table = foreign_table;
  r.foreign_field = foreign_field;
  r.through_table = "";
  r.through_local = "";
  r.through_foreign = "";
  return r;
}

export fn rc_relation_through(name: string, local_field: int32,
                              foreign_table: string, foreign_field: int32,
                              through_table: string, through_local: string,
                              through_foreign: string) -> RcRelation {
  var r: RcRelation;
  r.name = name;
  r.kind = RC_REL_HAS_MANY_THROUGH;
  r.local_field = local_field;
  r.foreign_table = foreign_table;
  r.foreign_field = foreign_field;
  r.through_table = through_table;
  r.through_local = through_local;
  r.through_foreign = through_foreign;
  return r;
}

fn rc_relation_kind_known(kind: int32) -> bool {
  if (kind == RC_REL_HAS_MANY) { return true; }
  if (kind == RC_REL_BELONGS_TO) { return true; }
  if (kind == RC_REL_HAS_MANY_THROUGH) { return true; }
  return false;
}

// Returns RC_OK or the refusal code. No statement is run and no allocation is
// made, so this is safe to call from a loader and cheap enough to call on
// every load (it is six comparisons and a string compare per check).
//
// Two rules make a batch loader possible:
//
//   * the key fields on both sides are RC_T_I64 — an int64 field the model
//     already has, never a new column;
//   * for BELONGS_TO / THROUGH the target side is the target's primary key,
//     so "find the target" is a primary-key lookup and never a scan by a
//     non-unique column.
//
// A HAS_MANY groups by the *owner's* local field, so that field must be
// NOT NULL (a NULL grouping key is not a key). BELONGS_TO and
// THROUGH allow a nullable local field on purpose: a NULL foreign key means "no
// relation", and the loader skips NULL owner keys before it builds the IN list.
//
// The through metadata contract is positional, not name-searched: field 0 is
// the owner column and field 1 is the target column. That is what lets the
// loader project `SELECT "user_id", "post_id"` without a column list of its
// own, and what makes a swapped through table a startup refusal instead of a
// silently inverted mapping.
export fn rc_relation_check(rel: RcRelation*, owner_meta: RcMeta,
                            target_meta: RcMeta, through_meta: RcMeta*) -> int32 {
  if (rel == 0) { return RC_ERR_USAGE; }
  if (!rc_relation_kind_known(rel->kind)) { return RC_ERR_UNSUPPORTED; }
  if (rel->name.length == (uint64)0) { return RC_ERR_USAGE; }

  if (owner_meta.fields == 0 || owner_meta.n_fields <= 0) { return RC_ERR_USAGE; }
  if (rel->local_field < 0) { return RC_ERR_USAGE; }
  if (rel->local_field >= owner_meta.n_fields) { return RC_ERR_USAGE; }
  if (owner_meta.fields[rel->local_field].ty != RC_T_I64) { return RC_ERR_CAST; }

  if (rel->foreign_table != target_meta.table) { return RC_ERR_USAGE; }
  if (target_meta.fields == 0 || target_meta.n_fields <= 0) { return RC_ERR_USAGE; }
  if (rel->foreign_field < 0) { return RC_ERR_USAGE; }
  if (rel->foreign_field >= target_meta.n_fields) { return RC_ERR_USAGE; }
  if (target_meta.fields[rel->foreign_field].ty != RC_T_I64) { return RC_ERR_CAST; }

  if (rel->kind == RC_REL_HAS_MANY) {
    // The owner's grouping key must exist as a value; NULL keys are skipped by
    // the loader, so a nullable local field would silently drop owners.
    if ((owner_meta.fields[rel->local_field].flags & RC_F_NOT_NULL) == 0) {
      return RC_ERR_USAGE;
    }
  } else {
    // BELONGS_TO / THROUGH: the target side is the primary key.
    if (target_meta.pk < 0) { return RC_ERR_USAGE; }
    if (rel->foreign_field != target_meta.pk) { return RC_ERR_USAGE; }
    // rc_meta_check already guarantees this for a finalized meta; assert it
    // here too so a hand-built table cannot slip a nullable key past us.
    if ((target_meta.fields[target_meta.pk].flags & RC_F_NOT_NULL) == 0) {
      return RC_ERR_USAGE;
    }
  }

  if (rel->kind != RC_REL_HAS_MANY_THROUGH) {
    // A through_* name on a two-table relation is a declaration bug: the loader
    // would silently ignore it and the author would believe the mapping table
    // is involved.
    if (rel->through_table.length != (uint64)0) { return RC_ERR_USAGE; }
    if (rel->through_local.length != (uint64)0) { return RC_ERR_USAGE; }
    if (rel->through_foreign.length != (uint64)0) { return RC_ERR_USAGE; }
    return RC_OK;
  }

  if (through_meta == 0) { return RC_ERR_USAGE; }
  var tm: RcMeta = *through_meta;
  if (tm.fields == 0 || tm.n_fields != 2) { return RC_ERR_USAGE; }
  if (rel->through_table.length == (uint64)0) { return RC_ERR_USAGE; }
  if (rel->through_local.length == (uint64)0) { return RC_ERR_USAGE; }
  if (rel->through_foreign.length == (uint64)0) { return RC_ERR_USAGE; }
  if (tm.table != rel->through_table) { return RC_ERR_USAGE; }
  if (tm.fields[0].name != rel->through_local) { return RC_ERR_USAGE; }
  if (tm.fields[1].name != rel->through_foreign) { return RC_ERR_USAGE; }
  if (tm.fields[0].ty != RC_T_I64) { return RC_ERR_USAGE; }
  if (tm.fields[1].ty != RC_T_I64) { return RC_ERR_USAGE; }
  return RC_OK;
}
