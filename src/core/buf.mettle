// flux_orm/core/buf.mettle — a growable byte buffer for statement text.
//
// Mettle's `+` on strings allocates a new string per operator, so building a
// statement by concatenation is one allocation per token. This is one buffer,
// one realloc growth policy, and an exact-length result view.

import "std/mem";
import "std/conv";

import "status";

export struct RcBuf { data: uint8*; len: int64; cap: int64; }

export fn rc_buf_new(cap: int64) -> RcBuf {
  var b: RcBuf;
  b.len = 0;
  b.cap = 0;
  b.data = 0;
  if (cap < 16) { cap = 16; }
  var p: uint8* = malloc(cap);
  if (p == 0) { return b; }
  b.data = p;
  b.cap = cap;
  return b;
}

export fn rc_buf_free(b: RcBuf*) {
  if (b == 0) { return; }
  if (b.data != 0) { free(b.data); }
  b.data = 0;
  b.len = 0;
  b.cap = 0;
}

export fn rc_buf_clear(b: RcBuf*) {
  if (b == 0) { return; }
  b.len = 0;
}

fn rc_buf_reserve(b: RcBuf*, extra: int64) -> int32 {
  if (b == 0) { return RC_ERR_USAGE; }
  if (extra < 0) { return RC_ERR_USAGE; }
  var need: int64 = b.len + extra;
  if (need <= b.cap) { return RC_OK; }
  var cap: int64 = b.cap;
  if (cap < 16) { cap = 16; }
  while (cap < need) { cap = cap * 2; }
  var p: rawptr = realloc((rawptr)b.data, cap);
  if (p == 0) { return RC_ERR_NOMEM; }
  b.data = (uint8*)p;
  b.cap = cap;
  return RC_OK;
}

export fn rc_buf_putc(b: RcBuf*, c: uint8) -> int32 {
  var rc: int32 = rc_buf_reserve(b, 1);
  if (rc != RC_OK) { return rc; }
  b.data[b.len] = c;
  b.len = b.len + 1;
  return RC_OK;
}

export fn rc_buf_put(b: RcBuf*, s: string) -> int32 {
  if (b == 0) { return RC_ERR_USAGE; }
  var n: int64 = (int64)s.length;
  if (n <= 0) { return RC_OK; }
  if (s.chars == 0) { return RC_ERR_USAGE; }
  var rc: int32 = rc_buf_reserve(b, n);
  if (rc != RC_OK) { return rc; }
  memcpy((rawptr)(b.data + b.len), (rawptr)s.chars, n);
  b.len = b.len + n;
  return RC_OK;
}

export fn rc_buf_put_i64(b: RcBuf*, v: int64) -> int32 {
  if (b == 0) { return RC_ERR_USAGE; }
  var tmp: uint8[24];
  var n: int32 = 0;
  var neg: bool = false;
  var mag: uint64 = (uint64)v;
  if (v < 0) {
    neg = true;
    // Two's-complement negation, so int64 min has a representable magnitude.
    mag = (uint64)0 - (uint64)v;
  }
  if (mag == (uint64)0) {
    tmp[0] = (uint8)48;
    n = 1;
  }
  while (mag > (uint64)0) {
    tmp[n] = (uint8)(48 + (int32)(mag % (uint64)10));
    n = n + 1;
    mag = mag / (uint64)10;
  }
  var rc: int32 = 0;
  if (neg) {
    rc = rc_buf_putc(b, (uint8)45);
    if (rc != RC_OK) { return rc; }
  }
  while (n > 0) {
    n = n - 1;
    rc = rc_buf_putc(b, tmp[n]);
    if (rc != RC_OK) { return rc; }
  }
  return RC_OK;
}

// Quotes an identifier with double quotes, doubling any embedded quote. dacor
// has no reserved-word list yet; quoting everything is the only safe default.
export fn rc_buf_ident(b: RcBuf*, s: string) -> int32 {
  var rc: int32 = rc_buf_putc(b, (uint8)34);
  if (rc != RC_OK) { return rc; }
  var i: int64 = 0;
  var n: int64 = (int64)s.length;
  while (i < n) {
    var c: uint8 = s.chars[i];
    if (c == (uint8)34) {
      rc = rc_buf_putc(b, (uint8)34);
      if (rc != RC_OK) { return rc; }
    }
    rc = rc_buf_putc(b, c);
    if (rc != RC_OK) { return rc; }
    i = i + 1;
  }
  return rc_buf_putc(b, (uint8)34);
}

// Borrowed view of the buffer's bytes. Valid until the next mutation or free.
export fn rc_buf_text(b: RcBuf*) -> string {
  if (b == 0) { return str_from_bytes((cstring)0, 0); }
  return str_from_bytes((cstring)b.data, b.len);
}
