// flux_orm/core/session.mettle — one connection and its transaction.
//
// Make one session per connection and pass it around; it is not a global.
//
// Nesting is flattened here, because MeoSQL and adapter/mem both refuse a
// nested begin. Only the outermost begin/commit reaches the adapter; inner
// levels only count depth. An inner rollback cannot undo part of a flat
// transaction, so it dooms the whole one: the outer commit rolls back and
// returns RC_ERR_TX.
//
// A failed commit leaves no transaction open: the session rolls back whatever
// the adapter still holds. With a distributed store a failed commit can be
// ambiguous (the write may have landed).
//
// One thread per session while a transaction is open: MeoSQL's lock belongs
// to the thread that called begin.
//
// Loaded rows: a model's text fields point into the result it was loaded
// from, so the session keeps those results (rc_session_keep) until
// rc_session_clear or rc_session_free. Clear when the models from a batch of
// work are no longer used; every model loaded before that is invalid after.

import "std/mem";

import "status";
import "../adapter/adapter";

export struct RcSession {
  adapter: RcAdapter*;
  depth: int32;   // 0 = no transaction open; 1 = the adapter's transaction
  doomed: bool;   // an inner level rolled back: the outer commit rolls back
  mode: int32;    // RC_TX_* of the outermost begin
  kept: RcResult**; // results loaded models point into, owned
  n_kept: int32;
  cap_kept: int32;
}

export fn rc_session_new(a: RcAdapter*) -> RcSession {
  var s: RcSession;
  s.adapter = a;
  s.depth = 0;
  s.doomed = false;
  s.mode = RC_TX_DEFAULT;
  s.kept = 0;
  s.n_kept = 0;
  s.cap_kept = 0;
  return s;
}

// Moves `*res` into the session and points `*out` at the kept copy, which
// stays valid until rc_session_clear. `*res` is left empty.
export fn rc_session_keep(s: RcSession*, res: RcResult*, out: RcResult**) -> int32 {
  if (s == 0 || res == 0 || out == 0) { return RC_ERR_USAGE; }
  if (s->n_kept == s->cap_kept) {
    var cap: int32 = s->cap_kept * 2;
    if (cap < 8) { cap = 8; }
    var p: rawptr = realloc((rawptr)s->kept, (int64)cap * (int64)sizeof(RcResult*));
    if (p == 0) { return RC_ERR_NOMEM; }
    s->kept = (RcResult**)p;
    s->cap_kept = cap;
  }
  var r: RcResult* = malloc(sizeof(RcResult));
  if (r == 0) { return RC_ERR_NOMEM; }
  *r = *res;
  rc_result_init(res);
  s->kept[s->n_kept] = r;
  s->n_kept = s->n_kept + 1;
  *out = r;
  return RC_OK;
}

// Frees every kept result. Models loaded through this session are invalid
// afterwards; the session itself stays usable.
export fn rc_session_clear(s: RcSession*) {
  if (s == 0) { return; }
  var i: int32 = 0;
  while (i < s->n_kept) {
    rc_result_free(s->kept[i]);
    free(s->kept[i]);
    i = i + 1;
  }
  s->n_kept = 0;
}

// Clears and releases the session's own memory. It does not close the adapter.
export fn rc_session_free(s: RcSession*) {
  if (s == 0) { return; }
  rc_session_clear(s);
  if (s->kept != 0) {
    free(s->kept);
    s->kept = 0;
  }
  s->cap_kept = 0;
}

export fn rc_session_kept(s: RcSession*) -> int32 {
  if (s == 0) { return 0; }
  return s->n_kept;
}

export fn rc_session_adapter(s: RcSession*) -> RcAdapter* {
  if (s == 0) { return 0; }
  return s->adapter;
}

export fn rc_session_depth(s: RcSession*) -> int32 {
  if (s == 0) { return 0; }
  return s->depth;
}

export fn rc_session_in_tx(s: RcSession*) -> bool {
  if (s == 0) { return false; }
  if (s->depth > 0) { return true; }
  return false;
}

// True once an inner level has rolled back: the transaction can still run
// statements, but it will not commit.
export fn rc_session_doomed(s: RcSession*) -> bool {
  if (s == 0) { return false; }
  return s->doomed;
}

// The adapter's state is unknown after a failed commit or rollback; this puts
// the session back to "no transaction" either way.
fn rc_session_end(s: RcSession*) {
  s->depth = 0;
  s->doomed = false;
  s->mode = RC_TX_DEFAULT;
}

export fn rc_session_begin(s: RcSession*, mode: int32) -> int32 {
  if (s == 0 || s->adapter == 0) { return RC_ERR_USAGE; }
  if (mode != RC_TX_DEFAULT && mode != RC_TX_DEFERRED && mode != RC_TX_IMMEDIATE) {
    return RC_ERR_USAGE;
  }
  if (s->depth > 0) {
    if (s->depth == 2147483647) { return RC_ERR_TX; }
    s->depth = s->depth + 1;
    return RC_OK;
  }
  var rc: int32 = rc_adapter_begin(s->adapter, mode);
  if (rc != RC_OK) { return rc; }
  s->depth = 1;
  s->doomed = false;
  s->mode = mode;
  return RC_OK;
}

export fn rc_session_commit(s: RcSession*) -> int32 {
  if (s == 0 || s->adapter == 0) { return RC_ERR_USAGE; }
  if (s->depth == 0) { return RC_ERR_TX; }
  if (s->depth > 1) {
    s->depth = s->depth - 1;
    return RC_OK;
  }
  if (s->doomed) {
    rc_adapter_rollback(s->adapter);
    rc_session_end(s);
    return RC_ERR_TX;
  }
  var rc: int32 = rc_adapter_commit(s->adapter);
  if (rc != RC_OK) {
    rc_adapter_rollback(s->adapter);
  }
  rc_session_end(s);
  return rc;
}

export fn rc_session_rollback(s: RcSession*) -> int32 {
  if (s == 0 || s->adapter == 0) { return RC_ERR_USAGE; }
  if (s->depth == 0) { return RC_ERR_TX; }
  if (s->depth > 1) {
    s->depth = s->depth - 1;
    s->doomed = true;
    return RC_OK;
  }
  var rc: int32 = rc_adapter_rollback(s->adapter);
  rc_session_end(s);
  return rc;
}

// Runs `body(ctx, s)` inside a transaction: begin, the body, then commit when
// the body answers RC_OK and roll back otherwise. The body's own code wins over
// the rollback's, so a CONFLICT inside the body is what the caller sees.
// Inside an open transaction this nests like any other begin.
export fn rc_session_transaction(s: RcSession*, mode: int32,
                                 body: fn(rawptr, RcSession*) -> int32,
                                 ctx: rawptr) -> int32 {
  if (s == 0 || body == 0) { return RC_ERR_USAGE; }
  var rc: int32 = rc_session_begin(s, mode);
  if (rc != RC_OK) { return rc; }
  var out: int32 = body(ctx, s);
  if (out != RC_OK) {
    rc_session_rollback(s);
    return out;
  }
  return rc_session_commit(s);
}
