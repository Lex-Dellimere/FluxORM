// flux_orm/core/session.mettle — one connection and its transaction.
//
// A session is what owns "this connection, this transaction". It is not a
// global: a caller makes one per connection (and per thread, see below) and
// passes it. Everything that reads or writes takes the session's adapter.
//
// Nesting is flattened here, because neither the store nor the recording
// adapter nests: MeoSQL answers a nested begin with MEO_ERR_TX (DECISIONS.md
// D8), and so does adapter/mem. Only the outermost begin reaches the adapter.
// An inner begin/commit pair only counts depth. An inner rollback cannot undo
// part of a flat transaction, so it marks the whole transaction doomed: the
// outermost commit then rolls back instead and answers RC_ERR_TX, so the
// caller learns that nothing was written. Savepoints would allow a partial
// rollback; neither store has them yet.
//
//   begin   depth 0 -> adapter begin, depth 1     depth n -> n + 1
//   commit  depth 1 -> adapter commit (or rollback when doomed), depth 0
//           depth n -> n - 1                       depth 0 -> RC_ERR_TX
//   rollback depth 1 -> adapter rollback, depth 0
//           depth n -> n - 1, doomed               depth 0 -> RC_ERR_TX
//
// A failed commit leaves no transaction open: the session rolls back whatever
// the adapter still holds (ignoring a TX answer, which means there was nothing
// left) and returns the commit's code. With a distributed store a failed
// commit can be ambiguous (the write may have landed); the code says it
// failed, not that nothing changed.
//
// Threads: one session belongs to one thread while a transaction is open.
// MeoSQL's v1 lock is held by the thread that called begin, and a commit from
// another thread is MEO_ERR_TX.
//
// Still to come on this struct (architecture notes): the arena that loaded
// text points into, the identity map, hooks, and the statement cache.

import "status";
import "../adapter/adapter";

export struct RcSession {
  adapter: RcAdapter*;
  depth: int32;   // 0 = no transaction open; 1 = the adapter's transaction
  doomed: bool;   // an inner level rolled back: the outer commit rolls back
  mode: int32;    // RC_TX_* of the outermost begin
}

export fn rc_session_new(a: RcAdapter*) -> RcSession {
  var s: RcSession;
  s.adapter = a;
  s.depth = 0;
  s.doomed = false;
  s.mode = RC_TX_DEFAULT;
  return s;
}

export fn rc_session_adapter(s: RcSession*) -> RcAdapter* {
  if (s == 0) { return 0; }
  return s->adapter;
}

export fn rc_session_depth(s: RcSession*) -> int32 {
  if (s == 0) { return 0; }
  return s->depth;
}

export fn rc_session_in_tx(s: RcSession*) -> bool {
  if (s == 0) { return false; }
  if (s->depth > 0) { return true; }
  return false;
}

// True once an inner level has rolled back: the transaction can still run
// statements, but it will not commit.
export fn rc_session_doomed(s: RcSession*) -> bool {
  if (s == 0) { return false; }
  return s->doomed;
}

// The adapter's state is unknown after a failed commit or rollback; this puts
// the session back to "no transaction" either way.
fn rc_session_end(s: RcSession*) {
  s->depth = 0;
  s->doomed = false;
  s->mode = RC_TX_DEFAULT;
}

export fn rc_session_begin(s: RcSession*, mode: int32) -> int32 {
  if (s == 0 || s->adapter == 0) { return RC_ERR_USAGE; }
  if (mode != RC_TX_DEFAULT && mode != RC_TX_DEFERRED && mode != RC_TX_IMMEDIATE) {
    return RC_ERR_USAGE;
  }
  if (s->depth > 0) {
    if (s->depth == 2147483647) { return RC_ERR_TX; }
    s->depth = s->depth + 1;
    return RC_OK;
  }
  var rc: int32 = rc_adapter_begin(s->adapter, mode);
  if (rc != RC_OK) { return rc; }
  s->depth = 1;
  s->doomed = false;
  s->mode = mode;
  return RC_OK;
}

export fn rc_session_commit(s: RcSession*) -> int32 {
  if (s == 0 || s->adapter == 0) { return RC_ERR_USAGE; }
  if (s->depth == 0) { return RC_ERR_TX; }
  if (s->depth > 1) {
    s->depth = s->depth - 1;
    return RC_OK;
  }
  if (s->doomed) {
    rc_adapter_rollback(s->adapter);
    rc_session_end(s);
    return RC_ERR_TX;
  }
  var rc: int32 = rc_adapter_commit(s->adapter);
  if (rc != RC_OK) {
    rc_adapter_rollback(s->adapter);
  }
  rc_session_end(s);
  return rc;
}

export fn rc_session_rollback(s: RcSession*) -> int32 {
  if (s == 0 || s->adapter == 0) { return RC_ERR_USAGE; }
  if (s->depth == 0) { return RC_ERR_TX; }
  if (s->depth > 1) {
    s->depth = s->depth - 1;
    s->doomed = true;
    return RC_OK;
  }
  var rc: int32 = rc_adapter_rollback(s->adapter);
  rc_session_end(s);
  return rc;
}

// Runs `body(ctx, s)` inside a transaction: begin, the body, then commit when
// the body answers RC_OK and roll back otherwise. The body's own code wins over
// the rollback's, so a CONFLICT inside the body is what the caller sees.
// Inside an open transaction this nests like any other begin.
export fn rc_session_transaction(s: RcSession*, mode: int32,
                                 body: fn(rawptr, RcSession*) -> int32,
                                 ctx: rawptr) -> int32 {
  if (s == 0 || body == 0) { return RC_ERR_USAGE; }
  var rc: int32 = rc_session_begin(s, mode);
  if (rc != RC_OK) { return rc; }
  var out: int32 = body(ctx, s);
  if (out != RC_OK) {
    rc_session_rollback(s);
    return out;
  }
  return rc_session_commit(s);
}
