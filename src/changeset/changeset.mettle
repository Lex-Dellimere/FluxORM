// flux_orm/changeset/changeset.mettle — what the caller wants to write, and which
// columns that actually touches.
//
// RcEntity.state answers "does this row differ from the store". An UPDATE needs
// the stronger answer "which fields", which is the same shape as the null
// bitmap: one bit per field in a uint64, so a changeset is 64 fields wide. That
// ceiling is rc_meta_check's (RC_MAX_FIELDS); a meta with more fields is
// refused here rather than truncated, because a silently dropped column is a
// lost write.
//
// Why the per-field bit matters, in one sentence: if a caller loads a row, sets
// one field and saves, an UPDATE that rewrites every column clobbers whatever a
// concurrent writer changed in the meantime. So `put` compares against a bound
// baseline row (rc_changeset_bind) and *clears* the bit when the value is
// identical to what the row already holds — the "identical value is not dirty"
// test pins that.
//
// Ownership, same rule as RcEntity: text inputs are BORROWED. `RcText` is a
// 16-byte view with no owner, so rc_changeset_put / rc_changeset_put_text keep
// the caller's bytes and rc_changeset_free does NOT release the cells (they
// were never owned). A caller that keeps a changeset alive past the buffer it
// read the text from must keep that buffer alive too; a caller that needs the
// value to outlive it must rc_value_clone into its own storage. The
// "borrowed text is not copied" test asserts `.chars` pointer identity.
//
// Errors are collected, as in Ecto: a refused put records an error for its
// field and leaves the field unchanged, and later puts on other fields still
// work. Validations (validate.mettle) add more. rc_changeset_error_count and
// rc_changeset_error_at list them; rc_changeset_error_field/code/reason give
// the first. A changeset with any error is invalid, and apply and save refuse
// it with RC_ERR_USAGE before they write anything. reset and bind clear the
// errors.
//
// The SQL itself is query/'s: rc_changeset_save hands the mask to
// rc_query_update, so an UPDATE names exactly the dirty columns and nothing
// else.

import "std/mem";

import "../core/status";
import "../core/value";
import "../core/meta";
import "../core/entity";
import "../core/clock";
import "../adapter/adapter";
import "../query/builder";
import "cast";

// One recorded error. `reason` is a static string, never owned.
export struct RcFieldError {
  field: int32;   // -1 when the error is not about one field
  code: int32;    // RC_ERR_*
  reason: string;
}

export struct RcChangeset {
  meta: RcMeta;         // the table this changeset writes
  changes: uint64;      // bit i set = field i was written by the caller
  values: RcValue*;     // meta.n_fields cells, borrowed; 0 when unusable
  n_values: int32;      // == meta.n_fields, or 0 when values == 0
  base: rawptr;         // baseline model for dirty comparison, 0 = none
  base_nulls: uint64;
  err_field: int32;     // -1 when no error
  err_code: int32;      // RC_OK when no error
  err_reason: string;   // static string, never owned
  errors: RcFieldError*; // every error, in the order recorded
  n_errors: int32;
  cap_errors: int32;
  unique: uint64;       // fields a duplicate-key CONFLICT is reported on
}

// --- error bookkeeping -------------------------------------------------------

// The default short reason for a code, used when a site has nothing more
// specific to say. Always a literal: err_reason is never owned.
fn rc_changeset_reason(code: int32) -> string {
  if (code == RC_ERR_CAST) { return "cast"; }
  if (code == RC_ERR_RANGE) { return "range"; }
  if (code == RC_ERR_CONSTRAINT) { return "constraint"; }
  if (code == RC_ERR_UNSUPPORTED) { return "unsupported"; }
  if (code == RC_ERR_USAGE) { return "usage"; }
  if (code == RC_ERR_NOMEM) { return "nomem"; }
  return "error";
}

// Records a refusal and returns its code, so every refusal site is one line.
// This is the only writer of err_*; once set, the state stays until reset.
fn rc_changeset_note(cs: RcChangeset*, field: int32, code: int32,
                     why: string) -> int32 {
  if (cs == 0) { return code; }
  var reason: string = why;
  if (reason.length == (uint64)0) { reason = rc_changeset_reason(code); }
  if (cs->err_code == RC_OK) {
    cs->err_field = field;
    cs->err_code = code;
    cs->err_reason = reason;
  }
  if (cs->n_errors == cs->cap_errors) {
    var cap: int32 = cs->cap_errors * 2;
    if (cap < 4) { cap = 4; }
    var p: rawptr = realloc((rawptr)cs->errors, (int64)cap * (int64)sizeof(RcFieldError));
    if (p == 0) { return code; }  // the first error is still recorded above
    cs->errors = (RcFieldError*)p;
    cs->cap_errors = cap;
  }
  cs->errors[cs->n_errors].field = field;
  cs->errors[cs->n_errors].code = code;
  cs->errors[cs->n_errors].reason = reason;
  cs->n_errors = cs->n_errors + 1;
  return code;
}

// Records an error, as a validation does. Returns `code`.
export fn rc_changeset_add_error(cs: RcChangeset*, field: int32, code: int32,
                                 why: string) -> int32 {
  if (cs == 0) { return RC_ERR_USAGE; }
  if (cs->values == 0) { return cs->err_code; }
  return rc_changeset_note(cs, field, code, why);
}

export fn rc_changeset_error_count(cs: RcChangeset*) -> int32 {
  if (cs == 0) { return 0; }
  return cs->n_errors;
}

// Error i, or {-1, RC_ERR_USAGE, ""} when there is none.
export fn rc_changeset_error_at(cs: RcChangeset*, i: int32) -> RcFieldError {
  var e: RcFieldError;
  e.field = -1;
  e.code = RC_ERR_USAGE;
  e.reason = "";
  if (cs == 0 || i < 0 || i >= cs->n_errors) { return e; }
  return cs->errors[i];
}

// True when an error is recorded for `field`.
export fn rc_changeset_field_has_error(cs: RcChangeset*, field: int32) -> bool {
  if (cs == 0) { return false; }
  var i: int32 = 0;
  while (i < cs->n_errors) {
    if (cs->errors[i].field == field) { return true; }
    i = i + 1;
  }
  return false;
}

// Like Ecto's unique_constraint: when the store answers a write with
// RC_ERR_CONFLICT (a duplicate key), the error is recorded on `field` instead
// of on no field. With several unique fields registered the store does not say
// which one clashed, so the error goes on field -1.
export fn rc_changeset_unique(cs: RcChangeset*, field: int32) -> int32 {
  if (cs == 0) { return RC_ERR_USAGE; }
  if (cs->values == 0) { return cs->err_code; }
  if (field < 0 || field >= cs->meta.n_fields) { return RC_ERR_USAGE; }
  cs->unique = rc_nulls_set(cs->unique, field);
  return RC_OK;
}

// Records the store's duplicate-key CONFLICT on the registered unique field.
export fn rc_changeset_conflict(cs: RcChangeset*) {
  if (cs == 0 || cs->values == 0) { return; }
  var field: int32 = -1;
  var n: int32 = 0;
  var i: int32 = 0;
  while (i < cs->meta.n_fields) {
    if (rc_nulls_has(cs->unique, i)) {
      field = i;
      n = n + 1;
    }
    i = i + 1;
  }
  if (n != 1) { field = -1; }
  rc_changeset_note(cs, field, RC_ERR_CONFLICT, "has already been taken");
}

// True when the changeset carries no storage at all: a meta that failed
// rc_meta_check, more than RC_MAX_FIELDS fields, or a failed allocation. Such a
// changeset is permanently unusable and every call reports err_code.
fn rc_changeset_dead(cs: RcChangeset*) -> bool {
  if (cs == 0) { return true; }
  if (cs->values == 0) { return true; }
  return false;
}

// --- construction ------------------------------------------------------------

// A changeset over m, all cells RcNull, no bits set, no baseline. A meta that
// does not pass rc_meta_check (which includes n_fields > RC_MAX_FIELDS) yields
// a changeset with values == 0 and that error recorded: the caller may inspect
// it, and every later call keeps returning the same code. Never truncated.
export fn rc_changeset_new(m: RcMeta) -> RcChangeset {
  var cs: RcChangeset;
  cs.meta = m;
  cs.changes = 0;
  cs.values = 0;
  cs.n_values = 0;
  cs.base = 0;
  cs.base_nulls = (uint64)0;
  cs.err_field = -1;
  cs.err_code = RC_OK;
  cs.err_reason = "";
  cs.errors = 0;
  cs.n_errors = 0;
  cs.cap_errors = 0;
  cs.unique = (uint64)0;

  var bad: int32 = -1;
  var rc: int32 = rc_meta_check(m, &bad);
  if (rc != RC_OK) {
    cs.err_code = rc;
    cs.err_reason = "metadata failed rc_meta_check";
    return cs;
  }
  var bytes: int64 = (int64)sizeof(RcValue) * (int64)m.n_fields;
  if (bytes <= 0) {
    cs.err_code = RC_ERR_USAGE;
    cs.err_reason = "no fields to hold";
    return cs;
  }
  var p: uint8* = malloc(bytes);
  if (p == 0) {
    cs.err_code = RC_ERR_NOMEM;
    cs.err_reason = "no memory for the value cells";
    return cs;
  }
  memset((rawptr)p, 0, bytes);
  cs.values = (RcValue*)p;
  cs.n_values = m.n_fields;
  // Written explicitly, not left to "the zero tag happens to be RcNull".
  var i: int32 = 0;
  while (i < m.n_fields) {
    cs.values[i] = RcNull;
    i = i + 1;
  }
  return cs;
}

// Frees the cell array only. The cells hold borrowed text, so releasing them
// here would free the caller's buffers; they are views, and views do not own.
export fn rc_changeset_free(cs: RcChangeset*) {
  if (cs == 0) { return; }
  if (cs->values != 0) {
    free((rawptr)cs->values);
    cs->values = 0;
  }
  if (cs->errors != 0) {
    free((rawptr)cs->errors);
    cs->errors = 0;
  }
  cs->n_errors = 0;
  cs->cap_errors = 0;
  cs->changes = 0;
  cs->n_values = 0;
  cs->base = 0;
  cs->base_nulls = (uint64)0;
}

// Back to "nothing written": bits cleared, cells RcNull, baseline dropped,
// errors cleared. The meta, the allocation and the unique fields are kept.
export fn rc_changeset_reset(cs: RcChangeset*) -> int32 {
  if (cs == 0) { return RC_ERR_USAGE; }
  if (cs->values == 0) { return cs->err_code; }
  cs->changes = 0;
  var i: int32 = 0;
  while (i < cs->n_values) {
    cs->values[i] = RcNull;
    i = i + 1;
  }
  cs->base = 0;
  cs->base_nulls = (uint64)0;
  cs->err_field = -1;
  cs->err_code = RC_OK;
  cs->err_reason = "";
  cs->n_errors = 0;
  return RC_OK;
}

// Records the row the changeset came from, so `put` can tell a real edit from a
// rewrite of the same bytes. Binding starts a fresh edit (it resets), because a
// baseline from row A must never be compared against values put for row B. The
// model is borrowed: it must outlive the changeset, and it must be the model
// whose `nulls` mask is passed.
export fn rc_changeset_bind(cs: RcChangeset*, model: rawptr, nulls: uint64) -> int32 {
  if (cs == 0) { return RC_ERR_USAGE; }
  if (cs->values == 0) { return cs->err_code; }
  if (model == 0) {
    return rc_changeset_note(cs, -1, RC_ERR_USAGE, "null baseline model");
  }
  var rc: int32 = rc_changeset_reset(cs);
  if (rc != RC_OK) { return rc; }
  cs->base = model;
  cs->base_nulls = nulls;
  return RC_OK;
}

// --- dirty tracking ----------------------------------------------------------

// Is the cell identical to the baseline row's value for this field? Without a
// baseline there is nothing to compare against and every put counts as a
// change. RcNull vs RcNull is "identical" (rc_value_same is identity, not SQL
// three-valued logic), so a column that is NULL in the row and left NULL is not
// dirty.
fn rc_changeset_same_as_base(cs: RcChangeset*, field: int32) -> bool {
  if (cs->base == 0) { return false; }
  var base: RcValue = RcNull;
  var rc: int32 = rc_meta_get(cs->meta, cs->base, cs->base_nulls, field, &base);
  if (rc != RC_OK) { return false; }
  return rc_value_same(cs->values[field], base);
}

fn rc_changeset_bit(field: int32) -> uint64 {
  return (uint64)1 << (uint64)field;
}

// --- writing -----------------------------------------------------------------

// Puts one field. Strict: the arm must belong to the field's declared wire type
// (rc_cast_fits), so RcText into an RC_T_I64 column is RC_ERR_CAST — parsing
// user text is rc_changeset_put_text's job, and only its job. RcNull is allowed
// unless the column is RC_F_NOT_NULL (RC_ERR_CONSTRAINT).
//
// Last wins: putting field 2 twice keeps the second value and still counts the
// field once.
export fn rc_changeset_put(cs: RcChangeset*, field: int32, v: RcValue) -> int32 {
  if (cs == 0) { return RC_ERR_USAGE; }
  if (cs->values == 0) { return cs->err_code; }
  if (field < 0 || field >= cs->meta.n_fields) {
    return rc_changeset_note(cs, field, RC_ERR_USAGE, "field index out of range");
  }
  var f: RcField = rc_meta_field(cs->meta, field);
  if (rc_value_is_null(v)) {
    if ((f.flags & RC_F_NOT_NULL) != 0) {
      return rc_changeset_note(cs, field, RC_ERR_CONSTRAINT, "not null");
    }
  } else {
    var rc: int32 = rc_cast_fits(f, v);
    if (rc == RC_ERR_UNSUPPORTED) {
      return rc_changeset_note(cs, field, rc, "field type is not supported");
    }
    if (rc != RC_OK) {
      return rc_changeset_note(cs, field, rc,
                               "value arm does not fit the field type");
    }
  }
  cs->values[field] = v;
  if (rc_changeset_same_as_base(cs, field)) {
    cs->changes = cs->changes & ~rc_changeset_bit(field);
  } else {
    cs->changes = cs->changes | rc_changeset_bit(field);
  }
  return RC_OK;
}

// Puts by field *or* column name (rc_meta_find: name first, then column). An
// unknown name is RC_ERR_USAGE with err_field == -1, because there is no field
// index to report.
export fn rc_changeset_put_name(cs: RcChangeset*, name: string, v: RcValue) -> int32 {
  if (cs == 0) { return RC_ERR_USAGE; }
  if (cs->values == 0) { return cs->err_code; }
  var field: int32 = rc_meta_find(cs->meta, name);
  if (field < 0) {
    return rc_changeset_note(cs, -1, RC_ERR_USAGE, "unknown field name");
  }
  return rc_changeset_put(cs, field, v);
}

// Parses user text for the field's declared wire type and puts the result. This
// is the single parsing entry point; there is no put_text_i64/put_text_f64
// family, because the field's `ty` already says which arm to produce.
// rc_cast_text documents the matrix; the text is borrowed, never copied.
export fn rc_changeset_put_text(cs: RcChangeset*, field: int32, s: string) -> int32 {
  if (cs == 0) { return RC_ERR_USAGE; }
  if (cs->values == 0) { return cs->err_code; }
  if (field < 0 || field >= cs->meta.n_fields) {
    return rc_changeset_note(cs, field, RC_ERR_USAGE, "field index out of range");
  }
  var f: RcField = rc_meta_field(cs->meta, field);
  var v: RcValue = RcNull;
  var why: string = "";
  var rc: int32 = rc_cast_text(f, s, &v, &why);
  if (rc != RC_OK) {
    return rc_changeset_note(cs, field, rc, why);
  }
  return rc_changeset_put(cs, field, v);
}

// Explicit "this column becomes NULL". Same rules as put(cs, field, RcNull).
export fn rc_changeset_put_null(cs: RcChangeset*, field: int32) -> int32 {
  if (cs == 0) { return RC_ERR_USAGE; }
  return rc_changeset_put(cs, field, RcNull);
}

export fn rc_changeset_has(cs: RcChangeset*, field: int32) -> bool {
  if (cs == 0) { return false; }
  if (cs->values == 0) { return false; }
  if (field < 0 || field >= cs->meta.n_fields) { return false; }
  return rc_nulls_has(cs->changes, field);
}

export fn rc_changeset_n_dirty(cs: RcChangeset*) -> int32 {
  if (cs == 0) { return 0; }
  if (cs->values == 0) { return 0; }
  var n: int32 = 0;
  var i: int32 = 0;
  while (i < cs->meta.n_fields) {
    if (rc_nulls_has(cs->changes, i)) { n = n + 1; }
    i = i + 1;
  }
  return n;
}

// --- validation --------------------------------------------------------------

// The first dirty field that is NOT NULL in the metadata and null in the
// changeset, or -1. Shared by valid() (which must not mutate) and apply()
// (which records the violation). core/meta checks NOT NULL again on the write;
// this is the same rule asked one layer earlier, so a bad changeset never
// reaches a model.
fn rc_changeset_missing_required(cs: RcChangeset*) -> int32 {
  var i: int32 = 0;
  while (i < cs->meta.n_fields) {
    if (rc_nulls_has(cs->changes, i)) {
      var f: RcField = rc_meta_field(cs->meta, i);
      if ((f.flags & RC_F_NOT_NULL) != 0 && rc_value_is_null(cs->values[i])) {
        return i;
      }
    }
    i = i + 1;
  }
  return -1;
}

// True when nothing has been refused and every dirty NOT NULL field has a
// value. Pure: it records nothing.
export fn rc_changeset_valid(cs: RcChangeset*) -> bool {
  if (cs == 0) { return false; }
  if (cs->values == 0) { return false; }
  if (cs->err_code != RC_OK) { return false; }
  if (rc_changeset_missing_required(cs) >= 0) { return false; }
  return true;
}

export fn rc_changeset_error_field(cs: RcChangeset*) -> int32 {
  if (cs == 0) { return -1; }
  return cs->err_field;
}

export fn rc_changeset_error_code(cs: RcChangeset*) -> int32 {
  if (cs == 0) { return RC_ERR_USAGE; }
  return cs->err_code;
}

export fn rc_changeset_error_reason(cs: RcChangeset*) -> string {
  if (cs == 0) { return "null changeset"; }
  return cs->err_reason;
}

// --- apply -------------------------------------------------------------------

// Writes the dirty fields into e, in field order, through rc_entity_set — so
// the range checks, the narrowing and the null bits stay in core/meta and this
// phase does not re-implement them. A field whose bit is clear is not touched:
// the model keeps whatever a concurrent writer left there.
//
// Consequences (pinned by the tests):
//   - a RANGE from core/meta is returned unchanged with err_field set;
//   - e->state becomes RC_ST_DIRTY only through rc_entity_set's CLEAN -> DIRTY
//     rule, so a NEW entity stays NEW and a DELETED entity is refused;
//   - an invalid changeset writes nothing and returns RC_ERR_USAGE;
//   - the mask is NOT cleared on success: the caller still needs it to build
//     the UPDATE column list. Apply does not rebase the baseline either — bind
//     again if editing continues against the new values.
export fn rc_changeset_apply(cs: RcChangeset*, e: RcEntity*) -> int32 {
  if (cs == 0 || e == 0) { return RC_ERR_USAGE; }
  if (cs->values == 0) { return RC_ERR_USAGE; }
  if (cs->err_code != RC_OK) { return RC_ERR_USAGE; }
  if (e->state == RC_ST_DELETED) {
    return rc_changeset_note(cs, -1, RC_ERR_USAGE, "entity is deleted");
  }
  if (e->meta.n_fields != cs->meta.n_fields) {
    return rc_changeset_note(cs, -1, RC_ERR_USAGE,
                             "changeset and entity metadata disagree");
  }
  if (e->meta.table != cs->meta.table) {
    return rc_changeset_note(cs, -1, RC_ERR_USAGE,
                             "changeset and entity metadata disagree");
  }
  var missing: int32 = rc_changeset_missing_required(cs);
  if (missing >= 0) {
    rc_changeset_note(cs, missing, RC_ERR_CONSTRAINT, "not null");
    return RC_ERR_USAGE;
  }
  var i: int32 = 0;
  while (i < cs->meta.n_fields) {
    if (rc_nulls_has(cs->changes, i)) {
      var rc: int32 = rc_entity_set(e, i, cs->values[i]);
      if (rc != RC_OK) {
        return rc_changeset_note(cs, i, rc, "core/meta refused the write");
      }
    }
    i = i + 1;
  }
  return RC_OK;
}

// --- save --------------------------------------------------------------------

// Writes the dirty fields to the store as one UPDATE keyed by the primary key:
// `UPDATE "t" SET <dirty columns> = ? WHERE "pk" = ?`. The entity must already
// be in the store (CLEAN or DIRTY, with a key); a NEW one is inserted instead,
// so it is refused here.
//
// Order matters, and it is what keeps a refusal from leaving a half-written
// model:
//   1. the UPDATE is built from the mask first, so a mask query/ refuses (the
//      primary key, a read-only field) is refused before the model changes;
//   2. rc_changeset_apply writes the values through core/meta's range checks;
//   3. the SET values are read back from the model, so the store gets exactly
//      the narrowed values the model holds.
//
// Stale writes. A table with an RC_F_VERSION field is saved as
//   UPDATE "t" SET <dirty> = ?, "version" = ? WHERE "pk" = ? AND "version" = ?
// binding old + 1 and old. If another writer saved the row since this model
// was read, its version moved on, nothing matches and the answer is
// RC_ERR_CONFLICT: the other write is kept, not overwritten. On success the
// model's version becomes old + 1. A table without one is last-writer-wins.
//
// RC_F_UPDATED fields are set to core/clock's time on every save that writes
// something; without a clock such a save is refused before anything changes.
//
// An empty changeset writes nothing and does not call the adapter. An adapter
// failure is returned unchanged and the entity stays DIRTY: the model holds
// the new values, the store does not. Zero affected rows is RC_ERR_CONFLICT
// for a versioned table (stale, or deleted) and RC_ERR_NOT_FOUND otherwise
// (deleted, or its key changed, since it was loaded). On success the entity is
// CLEAN. The changeset is not reset; bind or reset it before the next round of
// edits.
export fn rc_changeset_save(a: RcAdapter*, cs: RcChangeset*, e: RcEntity*) -> int32 {
  if (a == 0 || cs == 0 || e == 0) { return RC_ERR_USAGE; }
  if (cs->values == 0) { return RC_ERR_USAGE; }
  if (cs->err_code != RC_OK) { return RC_ERR_USAGE; }
  if (e->state != RC_ST_CLEAN && e->state != RC_ST_DIRTY) {
    return rc_changeset_note(cs, -1, RC_ERR_USAGE, "entity is not in the store");
  }
  if (e->meta.pk < 0 || !rc_entity_has_pk(e)) {
    return rc_changeset_note(cs, -1, RC_ERR_USAGE, "entity has no primary key");
  }
  if (cs->changes == (uint64)0) { return RC_OK; }

  var q: RcQuery = rc_query_update(cs->meta, cs->changes);
  defer rc_query_free(&q);
  if (q.err != RC_OK) {
    return rc_changeset_note(cs, -1, q.err, "the update was refused");
  }
  var now: int64 = 0;
  var rc: int32 = RC_OK;
  var stamped: bool = rc_meta_any(cs->meta, RC_F_UPDATED);
  if (stamped) {
    rc = rc_clock_now(&now);
    if (rc != RC_OK) {
      return rc_changeset_note(cs, -1, rc, "no clock for the updated timestamp");
    }
  }
  // Read the version the model was loaded with before anything changes.
  var vf: int32 = rc_meta_version(cs->meta);
  var old_ver: int64 = 0;
  if (vf >= 0) {
    var cur: RcValue = RcNull;
    rc = rc_entity_get(e, vf, &cur);
    if (rc != RC_OK) { return rc; }
    rc = rc_value_as_i64(cur, &old_ver);
    if (rc != RC_OK) {
      return rc_changeset_note(cs, vf, RC_ERR_USAGE, "version is not set");
    }
    if (old_ver == (int64)9223372036854775807) {
      return rc_changeset_note(cs, vf, RC_ERR_RANGE, "version is at its maximum");
    }
  }
  rc = rc_changeset_apply(cs, e);
  if (rc != RC_OK) { return rc; }

  var i: int32 = 0;
  while (i < cs->meta.n_fields) {
    if (rc_nulls_has(cs->changes, i)) {
      var v: RcValue = RcNull;
      rc = rc_entity_get(e, i, &v);
      if (rc != RC_OK) { return rc; }
      rc = rc_query_push_arg(&q, v);
      if (rc != RC_OK) { return rc; }
    }
    i = i + 1;
  }
  i = 0;
  while (stamped && i < cs->meta.n_fields) {
    if ((cs->meta.fields[i].flags & RC_F_UPDATED) != 0) {
      rc = rc_query_push_arg(&q, RcTime(now));
      if (rc != RC_OK) { return rc; }
    }
    i = i + 1;
  }
  if (vf >= 0) {
    rc = rc_query_push_arg(&q, RcInt(old_ver + 1));
    if (rc != RC_OK) { return rc; }
  }
  rc = rc_query_where_eq(&q, e->meta.pk, rc_entity_pk(e));
  if (rc != RC_OK) { return rc; }
  if (vf >= 0) {
    rc = rc_query_where_eq(&q, vf, RcInt(old_ver));
    if (rc != RC_OK) { return rc; }
  }

  var res: RcResult;
  rc = rc_query_exec(&q, a, &res);
  if (rc == RC_ERR_CONFLICT) { rc_changeset_conflict(cs); }
  if (rc != RC_OK) { return rc; }
  var affected: int32 = res.affected;
  rc_result_free(&res);
  if (affected == 0) {
    if (vf >= 0) { return RC_ERR_CONFLICT; }
    return RC_ERR_NOT_FOUND;
  }
  if (vf >= 0) {
    rc = rc_meta_set(e->meta, e->model, &e->nulls, vf, RcInt(old_ver + 1));
    if (rc != RC_OK) { return rc; }
  }
  i = 0;
  while (stamped && i < e->meta.n_fields) {
    if ((e->meta.fields[i].flags & RC_F_UPDATED) != 0) {
      rc = rc_meta_set(e->meta, e->model, &e->nulls, i, RcTime(now));
      if (rc != RC_OK) { return rc; }
    }
    i = i + 1;
  }
  e->state = RC_ST_CLEAN;
  return RC_OK;
}
