// flux_orm/adapter/stmt.mettle — a statement as data, for stores without SQL.
//
// The builder, persist and migrations fill an RcStmt next to the SQL text. An
// adapter with a `query` slot (MeoSQL's typed API, and later its network
// server) runs the RcStmt; a text adapter runs the SQL. Both see the same
// argv: INSERT cells row-major, or SET values then the WHERE term arguments.
//
// Names are borrowed from RcMeta (static), the arrays are owned by the RcStmt
// and freed by rc_stmt_free, and `args` is borrowed from the caller.

import "std/mem";

import "../core/status";
import "../core/value";

export const RC_OP_CREATE: int32 = 1;
export const RC_OP_INSERT: int32 = 2;
export const RC_OP_SELECT: int32 = 3;
export const RC_OP_UPDATE: int32 = 4;
export const RC_OP_DELETE: int32 = 5;
export const RC_OP_COUNT: int32 = 6;

// Term operators. EQ..GE equal the builder's RC_CMP_*.
export const RC_W_EQ: int32 = 0;
export const RC_W_NE: int32 = 1;
export const RC_W_LT: int32 = 2;
export const RC_W_LE: int32 = 3;
export const RC_W_GT: int32 = 4;
export const RC_W_GE: int32 = 5;
export const RC_W_IN: int32 = 6;
export const RC_W_NULL: int32 = 7;
export const RC_W_NOT_NULL: int32 = 8;

// A column: CREATE definitions, INSERT columns, SELECT columns or UPDATE SET
// columns. `ty` is RC_T_*, `flags` RC_F_* (CREATE uses PK, NOT_NULL, UNIQUE).
export struct RcStmtCol {
  name: string;
  ty: int32;
  flags: int32;
}

// A WHERE term over args[arg0 .. arg0 + n_args).
export struct RcStmtTerm {
  col: string;
  op: int32;
  arg0: int32;
  n_args: int32;
}

export struct RcStmtOrder {
  col: string;
  desc: bool;
}

export struct RcStmt {
  op: int32;            // RC_OP_*, 0 = none
  table: string;
  if_not_exists: bool;
  cols: RcStmtCol*;
  n_cols: int32;
  cap_cols: int32;
  n_rows: int32;        // INSERT rows
  terms: RcStmtTerm*;
  n_terms: int32;
  cap_terms: int32;
  order: RcStmtOrder*;
  n_order: int32;
  cap_order: int32;
  limit: int64;         // -1 = none
  offset: int64;        // 0 = none
  n_joins: int32;       // a store without joins refuses > 0
  args: RcValue*;       // borrowed
  n_args: int32;
}

export fn rc_stmt_new(op: int32, table: string) -> RcStmt {
  var st: RcStmt;
  st.op = op;
  st.table = table;
  st.if_not_exists = false;
  st.cols = 0;
  st.n_cols = 0;
  st.cap_cols = 0;
  st.n_rows = 0;
  st.terms = 0;
  st.n_terms = 0;
  st.cap_terms = 0;
  st.order = 0;
  st.n_order = 0;
  st.cap_order = 0;
  st.limit = -1;
  st.offset = 0;
  st.n_joins = 0;
  st.args = 0;
  st.n_args = 0;
  return st;
}

export fn rc_stmt_free(st: RcStmt*) {
  if (st == 0) { return; }
  if (st->cols != 0) { free((rawptr)st->cols); }
  if (st->terms != 0) { free((rawptr)st->terms); }
  if (st->order != 0) { free((rawptr)st->order); }
  st->cols = 0;
  st->terms = 0;
  st->order = 0;
  st->n_cols = 0;
  st->n_terms = 0;
  st->n_order = 0;
  st->cap_cols = 0;
  st->cap_terms = 0;
  st->cap_order = 0;
}

// Grows an array of `size`-byte items to hold one more.
fn rc_stmt_grow(p: rawptr*, cap: int32*, n: int32, size: int64) -> int32 {
  if (n < *cap) { return RC_OK; }
  var c: int32 = *cap * 2;
  if (c < 8) { c = 8; }
  var q: rawptr = realloc(*p, (int64)c * size);
  if (q == 0) { return RC_ERR_NOMEM; }
  *p = q;
  *cap = c;
  return RC_OK;
}

export fn rc_stmt_col(st: RcStmt*, name: string, ty: int32, flags: int32) -> int32 {
  if (st == 0) { return RC_ERR_USAGE; }
  var p: rawptr = (rawptr)st->cols;
  var rc: int32 = rc_stmt_grow(&p, &st->cap_cols, st->n_cols, (int64)sizeof(RcStmtCol));
  if (rc != RC_OK) { return rc; }
  st->cols = (RcStmtCol*)p;
  st->cols[st->n_cols].name = name;
  st->cols[st->n_cols].ty = ty;
  st->cols[st->n_cols].flags = flags;
  st->n_cols = st->n_cols + 1;
  return RC_OK;
}

export fn rc_stmt_term(st: RcStmt*, col: string, op: int32, arg0: int32, n_args: int32) -> int32 {
  if (st == 0) { return RC_ERR_USAGE; }
  var p: rawptr = (rawptr)st->terms;
  var rc: int32 = rc_stmt_grow(&p, &st->cap_terms, st->n_terms, (int64)sizeof(RcStmtTerm));
  if (rc != RC_OK) { return rc; }
  st->terms = (RcStmtTerm*)p;
  st->terms[st->n_terms].col = col;
  st->terms[st->n_terms].op = op;
  st->terms[st->n_terms].arg0 = arg0;
  st->terms[st->n_terms].n_args = n_args;
  st->n_terms = st->n_terms + 1;
  return RC_OK;
}

export fn rc_stmt_order(st: RcStmt*, col: string, desc: bool) -> int32 {
  if (st == 0) { return RC_ERR_USAGE; }
  var p: rawptr = (rawptr)st->order;
  var rc: int32 = rc_stmt_grow(&p, &st->cap_order, st->n_order, (int64)sizeof(RcStmtOrder));
  if (rc != RC_OK) { return rc; }
  st->order = (RcStmtOrder*)p;
  st->order[st->n_order].col = col;
  st->order[st->n_order].desc = desc;
  st->n_order = st->n_order + 1;
  return RC_OK;
}
