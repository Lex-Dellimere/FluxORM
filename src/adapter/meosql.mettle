// flux_orm/adapter/meosql.mettle — the bridge to MeoSQL.
//
// Status: gated. MeoSQL (../meosql) has built its single-node storage layer:
// a pager (meo_pager_open/get/release/alloc/flush), a rollback journal behind
// meo_pager_begin/commit/rollback, and a B+ tree (meo_bt_seek/next/lookup/
// insert). There is no SQL surface and no row API yet. So this file defines
// the bridge and refuses to pretend. Every entry point returns
// RC_ERR_UNSUPPORTED and rc_meosql_supported() is false.
//
// What the bridge will call, and why each one matters. The meo_pager_* entries
// exist today; the meo_sql_* ones are the statement API flux_orm needs MeoSQL
// to provide (names provisional until MeoSQL ships them):
//
//   meo_pager_open(path, n_frames, flags)      one pager per connection
//   meo_pager_begin/commit/rollback            journalled transactions
//   meo_sql_prepare(pager, sql, len)           prepared statement
//   meo_sql_bind(stmt, i, arg)                 positional only
//   meo_sql_step(stmt) -> MEO_ROW | MEO_DONE   drives the row loop
//   meo_sql_column_count / column_type         fills RcResult.n_cols
//   meo_sql_column(stmt, i) -> type + bytes    the decode path
//   meo_sql_reset(stmt)                        statement reuse
//   meo_sql_finalize(stmt)                     frees the statement, not pages
//
// The three bridge obligations that are design, not plumbing:
//
// 1. Materialise. step() until MEO_DONE inside exec, copy into RcResult, then
//    finalize. No MeoSQL cursor ever leaves this file: a cursor pins pager
//    frames, and a pinned frame that outlives a callback is MEO_ERR_BUSY later.
//
// 2. Map status. MeoSQL's MEO_ERR_* collapse into RC_* here and only here.
//    MEO_ERR_NOMEM -> RC_ERR_NOMEM, MEO_ERR_USAGE -> RC_ERR_USAGE,
//    MEO_ERR_UNSUPPORTED -> RC_ERR_UNSUPPORTED, everything else
//    (IO, NOSPC, FULL, BUSY, RANGE, READONLY) -> RC_ERR_ADAPTER.
//    MEO_ERR_CORRUPT, MEO_ERR_NOT_A_DB and MEO_ERR_VERSION also mean the
//    connection must be discarded, not reused: a corrupt pager has no valid
//    cache. MeoSQL has no conflict or constraint codes yet; RC_ERR_CONFLICT and
//    RC_ERR_CONSTRAINT need them once unique keys and concurrent writers land.
//
// 3. Never encode. MeoSQL owns its varint/zigzag record codec. The ORM passes
//    typed RcValue arguments and reads typed columns; it must not build cell
//    bytes. That is the one place where an ORM normally duplicates the storage
//    engine by accident.

import "std/mem";

import "../core/status";
import "../core/value";
import "adapter";

// Same values as MeoSQL's MEO_OPEN_READ/WRITE/CREATE.
export const RC_MEOSQL_READ: int32 = 1;
export const RC_MEOSQL_WRITE: int32 = 2;
export const RC_MEOSQL_CREATE: int32 = 4;
export const RC_MEOSQL_N_FRAMES: int32 = 256; // 1 MiB of page cache per connection

// The affinity vocabulary the ORM will ask MeoSQL's type layer for.
// Provisional: MeoSQL has no column types yet, and this table is the contract
// the ORM needs from it. A mismatch is a build-time conversation, not a runtime
// coercion.
export fn rc_meosql_affinity(ty: int32) -> string {
  if (ty == RC_T_I64 || ty == RC_T_U64) { return "INTEGER"; }
  if (ty == RC_T_BOOL) { return "INTEGER"; } // stored 0/1, decoded as bool
  if (ty == RC_T_TIME) { return "INTEGER"; } // unix micros, UTC, never text
  if (ty == RC_T_F64) { return "REAL"; }
  if (ty == RC_T_TEXT) { return "TEXT"; }
  if (ty == RC_T_BLOB) { return "BLOB"; }
  return "";
}

// A declared timestamp is a plain int64 in Mettle. The model marks the column
// with RC_F_TIMESTAMP; this is the conversion both directions use.
export fn rc_meosql_time_from_micros(us: int64) -> RcValue { return RcTime(us); }

export struct RcMeosql {
  pager: rawptr; // MeoPager*, once the statement API exists
  path: string;
  flags: int32;
  depth: int32;
}

fn rc_meosql_open(ud: rawptr, dsn: string) -> int32 { return RC_ERR_UNSUPPORTED; }
fn rc_meosql_close(ud: rawptr) -> int32 { return RC_ERR_UNSUPPORTED; }
fn rc_meosql_exec(ud: rawptr, sql: string, args: RcValue*, n_args: int32,
                  out: RcResult*) -> int32 { return RC_ERR_UNSUPPORTED; }
fn rc_meosql_begin(ud: rawptr, mode: int32) -> int32 { return RC_ERR_UNSUPPORTED; }
fn rc_meosql_commit(ud: rawptr) -> int32 { return RC_ERR_UNSUPPORTED; }
fn rc_meosql_rollback(ud: rawptr) -> int32 { return RC_ERR_UNSUPPORTED; }
fn rc_meosql_ping(ud: rawptr) -> int32 { return RC_ERR_UNSUPPORTED; }

export fn rc_meosql_supported() -> bool { return false; }

export fn rc_meosql_adapter(path: string, flags: int32) -> RcAdapter* {
  var d: RcMeosql* = malloc(sizeof(RcMeosql));
  if (d == 0) { return 0; }
  d.pager = 0;
  d.path = path;
  d.flags = flags;
  d.depth = 0;
  var a: RcAdapter* = malloc(sizeof(RcAdapter));
  if (a == 0) {
    free(d);
    return 0;
  }
  a.name = "meosql";
  a.ud = (rawptr)d;
  a.open = &rc_meosql_open;
  a.close = &rc_meosql_close;
  a.exec = &rc_meosql_exec;
  a.begin = &rc_meosql_begin;
  a.commit = &rc_meosql_commit;
  a.rollback = &rc_meosql_rollback;
  a.ping = &rc_meosql_ping;
  return a;
}

export fn rc_meosql_adapter_free(a: RcAdapter*) {
  if (a == 0) { return; }
  var d: RcMeosql* = (RcMeosql*)a.ud;
  if (d != 0) { free(d); }
  free(a);
}
