// flux_orm/adapter/mem.mettle — the recording adapter.
//
// This is not a database. It is the seam's executable specification: it
// records the statement text and the bound arguments, and replays a scripted
// result. That is enough to pin down argument order, type preservation, NULL
// round-tripping, ownership, transaction states and error propagation without
// a single byte of MeoSQL existing yet — which matters, because MeoSQL's SQL
// surface is a later phase than this ORM's core.
//
// It is also the adapter the whole test suite runs against, so every ORM
// behaviour is verified twice: once against the seam, once against real MeoSQL
// once that lands.

import "std/mem";

import "../core/status";
import "../core/value";
import "adapter";

struct RcMemStep {
  values: RcValue*; // flat, row-major, owned
  n_rows: int32;
  n_cols: int32;
  affected: int32;
  last_id: int64;
}

struct RcMem {
  opened: bool;
  calls: int32;
  sql: string;      // owned copy of the last statement
  args: RcValue*;   // owned clones of the last bound arguments
  n_args: int32;
  steps: RcMemStep*;
  n_steps: int32;
  head: int32;
  tx_depth: int32;
  commits: int32;
  rollbacks: int32;
  fail_code: int32;
  fail_armed: bool;
}

fn rc_mem_of(ud: rawptr) -> RcMem* { return (RcMem*)ud; }

fn rc_mem_of_checked(a: RcAdapter*) -> RcMem* {
  if (a == 0) { return 0; }
  if (a.name != "mem") { return 0; }
  return rc_mem_of(a.ud);
}

fn rc_mem_args_free(m: RcMem*) {
  if (m == 0) { return; }
  if (m.args != 0) {
    var i: int32 = 0;
    while (i < m.n_args) {
      rc_value_release(m.args[i]);
      i = i + 1;
    }
    free(m.args);
  }
  m.args = 0;
  m.n_args = 0;
}

fn rc_mem_open(ud: rawptr, dsn: string) -> int32 {
  var m: RcMem* = rc_mem_of(ud);
  if (m == 0) { return RC_ERR_USAGE; }
  if (m.opened) { return RC_ERR_USAGE; }
  if (dsn.length == (uint64)0) { return RC_ERR_USAGE; }
  m.opened = true;
  return RC_OK;
}

fn rc_mem_close(ud: rawptr) -> int32 {
  var m: RcMem* = rc_mem_of(ud);
  if (m == 0) { return RC_ERR_USAGE; }
  if (!m.opened) { return RC_OK; }
  if (m.tx_depth > 0) { return RC_ERR_TX; }
  m.opened = false;
  return RC_OK;
}

fn rc_mem_exec(ud: rawptr, sql: string, args: RcValue*, n_args: int32,
               out: RcResult*) -> int32 {
  var m: RcMem* = rc_mem_of(ud);
  if (m == 0 || out == 0) { return RC_ERR_USAGE; }
  if (!m.opened) { return RC_ERR_CLOSED; }
  if (n_args < 0) { return RC_ERR_USAGE; }
  if (n_args > 0 && args == 0) { return RC_ERR_USAGE; }

  // Injected failure happens before anything is recorded, so a test can prove
  // a failed call left the seam untouched.
  if (m.fail_armed) {
    m.fail_armed = false;
    var code: int32 = m.fail_code;
    m.fail_code = 0;
    return code;
  }

  var text: string = rc_text_dup(sql);
  if (text.chars == 0 && sql.length > (uint64)0) { return RC_ERR_NOMEM; }
  rc_text_free(m.sql);
  m.sql = text;
  rc_mem_args_free(m);
  if (n_args > 0) {
    var copy: RcValue* = malloc((int64)n_args * (int64)sizeof(RcValue));
    if (copy == 0) { return RC_ERR_NOMEM; }
    var i: int32 = 0;
    while (i < n_args) {
      var v: RcValue = RcNull;
      var rc: int32 = rc_value_clone(args[i], &v);
      if (rc != RC_OK) {
        var k: int32 = 0;
        while (k < i) { rc_value_release(copy[k]); k = k + 1; }
        free(copy);
        return rc;
      }
      copy[i] = v;
      i = i + 1;
    }
    m.args = copy;
    m.n_args = n_args;
  }
  m.calls = m.calls + 1;

  if (m.head < m.n_steps) {
    var step: RcMemStep = m.steps[m.head];
    m.head = m.head + 1;
    var rc: int32 = rc_result_copy(out, step.values, step.n_rows, step.n_cols,
                                  step.affected, step.last_id);
    var i: int32 = 0;
    while (i < step.n_rows * step.n_cols) {
      rc_value_release(step.values[i]);
      i = i + 1;
    }
    free(step.values);
    return rc;
  }
  return RC_OK;
}

fn rc_mem_begin(ud: rawptr, mode: int32) -> int32 {
  var m: RcMem* = rc_mem_of(ud);
  if (m == 0) { return RC_ERR_USAGE; }
  if (!m.opened) { return RC_ERR_CLOSED; }
  if (mode != RC_TX_DEFAULT && mode != RC_TX_DEFERRED && mode != RC_TX_IMMEDIATE) {
    return RC_ERR_USAGE;
  }
  // No nesting, like MeoSQL: silent nesting hides a boundary bug in the caller.
  // core/session flattens nesting above this.
  if (m.tx_depth != 0) { return RC_ERR_TX; }
  m.tx_depth = 1;
  return RC_OK;
}

fn rc_mem_commit(ud: rawptr) -> int32 {
  var m: RcMem* = rc_mem_of(ud);
  if (m == 0) { return RC_ERR_USAGE; }
  if (!m.opened) { return RC_ERR_CLOSED; }
  if (m.tx_depth != 1) { return RC_ERR_TX; }
  m.tx_depth = 0;
  m.commits = m.commits + 1;
  return RC_OK;
}

fn rc_mem_rollback(ud: rawptr) -> int32 {
  var m: RcMem* = rc_mem_of(ud);
  if (m == 0) { return RC_ERR_USAGE; }
  if (!m.opened) { return RC_ERR_CLOSED; }
  if (m.tx_depth != 1) { return RC_ERR_TX; }
  m.tx_depth = 0;
  m.rollbacks = m.rollbacks + 1;
  return RC_OK;
}

fn rc_mem_ping(ud: rawptr) -> int32 {
  var m: RcMem* = rc_mem_of(ud);
  if (m == 0) { return RC_ERR_USAGE; }
  if (!m.opened) { return RC_ERR_CLOSED; }
  return RC_OK;
}

export fn rc_mem_adapter() -> RcAdapter* {
  var m: RcMem* = malloc(sizeof(RcMem));
  if (m == 0) { return 0; }
  m.opened = false;
  m.calls = 0;
  m.sql = str_from_bytes((cstring)0, 0);
  m.args = 0;
  m.n_args = 0;
  m.steps = 0;
  m.n_steps = 0;
  m.head = 0;
  m.tx_depth = 0;
  m.commits = 0;
  m.rollbacks = 0;
  m.fail_code = 0;
  m.fail_armed = false;

  var a: RcAdapter* = malloc(sizeof(RcAdapter));
  if (a == 0) {
    free(m);
    return 0;
  }
  a.name = "mem";
  a.ud = (rawptr)m;
  a.open = &rc_mem_open;
  a.close = &rc_mem_close;
  a.exec = &rc_mem_exec;
  a.begin = &rc_mem_begin;
  a.commit = &rc_mem_commit;
  a.rollback = &rc_mem_rollback;
  a.ping = &rc_mem_ping;
  return a;
}

export fn rc_mem_free(a: RcAdapter*) {
  if (a == 0) { return; }
  var m: RcMem* = rc_mem_of(a.ud);
  if (m != 0) {
    rc_text_free(m.sql);
    rc_mem_args_free(m);
    if (m.steps != 0) {
      var i: int32 = m.head;
      while (i < m.n_steps) {
        var step: RcMemStep = m.steps[i];
        var k: int32 = 0;
        while (k < step.n_rows * step.n_cols) {
          rc_value_release(step.values[k]);
          k = k + 1;
        }
        free(step.values);
        i = i + 1;
      }
      free(m.steps);
    }
    free(m);
  }
  free(a);
}

fn rc_mem_push_step(a: RcAdapter*, values: RcValue*, n_rows: int32,
                    n_cols: int32, affected: int32, last_id: int64) -> int32 {
  if (a == 0) { return RC_ERR_USAGE; }
  var m: RcMem* = rc_mem_of(a.ud);
  if (m == 0) { return RC_ERR_USAGE; }
  if (n_rows < 0 || n_cols < 0) { return RC_ERR_USAGE; }
  var owned: RcValue* = 0;
  var total: int32 = n_rows * n_cols;
  if (total > 0) {
    if (values == 0) { return RC_ERR_USAGE; }
    owned = malloc((int64)total * (int64)sizeof(RcValue));
    if (owned == 0) { return RC_ERR_NOMEM; }
    var i: int32 = 0;
    while (i < total) {
      var v: RcValue = RcNull;
      var rc: int32 = rc_value_clone(values[i], &v);
      if (rc != RC_OK) {
        var k: int32 = 0;
        while (k < i) { rc_value_release(owned[k]); k = k + 1; }
        free(owned);
        return rc;
      }
      owned[i] = v;
      i = i + 1;
    }
  }
  var next: RcMemStep* = realloc((rawptr)m.steps,
                                 (int64)(m.n_steps + 1) * (int64)sizeof(RcMemStep));
  if (next == 0) {
    if (owned != 0) {
      var i: int32 = 0;
      while (i < total) { rc_value_release(owned[i]); i = i + 1; }
      free(owned);
    }
    return RC_ERR_NOMEM;
  }
  m.steps = next;
  m.steps[m.n_steps].values = owned;
  m.steps[m.n_steps].n_rows = n_rows;
  m.steps[m.n_steps].n_cols = n_cols;
  m.steps[m.n_steps].affected = affected;
  m.steps[m.n_steps].last_id = last_id;
  m.n_steps = m.n_steps + 1;
  return RC_OK;
}

// Queue a result with no rows, e.g. for an INSERT.
export fn rc_mem_push_ok(a: RcAdapter*, affected: int32, last_id: int64) -> int32 {
  return rc_mem_push_step(a, 0, 0, 0, affected, last_id);
}

// Queue a result with rows. `values` is flat and row-major and is copied.
export fn rc_mem_push_rows(a: RcAdapter*, values: RcValue*, n_rows: int32,
                           n_cols: int32) -> int32 {
  return rc_mem_push_step(a, values, n_rows, n_cols, 0, 0);
}

// The next exec fails with `code` and records nothing.
export fn rc_mem_fail_next(a: RcAdapter*, code: int32) -> int32 {
  if (a == 0) { return RC_ERR_USAGE; }
  var m: RcMem* = rc_mem_of(a.ud);
  if (m == 0) { return RC_ERR_USAGE; }
  m.fail_code = code;
  m.fail_armed = true;
  return RC_OK;
}

export fn rc_mem_last_sql(a: RcAdapter*) -> string {
  var m: RcMem* = rc_mem_of_checked(a);
  if (m == 0) { return ""; }
  return m.sql;
}

export fn rc_mem_last_args(a: RcAdapter*) -> RcValue* {
  var m: RcMem* = rc_mem_of_checked(a);
  if (m == 0) { return 0; }
  return m.args;
}

export fn rc_mem_arg_count(a: RcAdapter*) -> int32 {
  var m: RcMem* = rc_mem_of_checked(a);
  if (m == 0) { return -1; }
  return m.n_args;
}

export fn rc_mem_call_count(a: RcAdapter*) -> int32 {
  var m: RcMem* = rc_mem_of_checked(a);
  if (m == 0) { return -1; }
  return m.calls;
}

export fn rc_mem_tx_depth(a: RcAdapter*) -> int32 {
  var m: RcMem* = rc_mem_of_checked(a);
  if (m == 0) { return -1; }
  return m.tx_depth;
}

export fn rc_mem_commits(a: RcAdapter*) -> int32 {
  var m: RcMem* = rc_mem_of_checked(a);
  if (m == 0) { return -1; }
  return m.commits;
}

export fn rc_mem_rollbacks(a: RcAdapter*) -> int32 {
  var m: RcMem* = rc_mem_of_checked(a);
  if (m == 0) { return -1; }
  return m.rollbacks;
}

export fn rc_mem_is_open(a: RcAdapter*) -> bool {
  var m: RcMem* = rc_mem_of_checked(a);
  if (m == 0) { return false; }
  return m.opened;
}
