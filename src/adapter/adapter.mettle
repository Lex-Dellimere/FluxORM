// flux_orm/adapter/adapter.mettle — the driver bridge contract.
//
// An adapter is a vtable of plain function pointers, not a trait and not an
// import cycle. The ORM never imports dacor; it holds an RcAdapter and calls
// through it. That is also why there is exactly one place to add a second
// store later.
//
// Two things in this file are load-bearing:
//
// 1. exec() materialises rows. It does not hand back a live cursor. dacor's
//    cursors pin pager frames (dacor/PHASE1.md §2.4); a cursor that escapes
//    into application code can exhaust the frame table and turn every later
//    alloc into DK_ERR_BUSY. Materialising at the adapter boundary is the only
//    way the ORM can promise it never holds a pin across user code. Result
//    sets are therefore owned, and freed with rc_result_free.
//
// 2. Arguments are RcValue, positionally bound. Placeholders are `?`. The
//    query builder emits them; the adapter never sees a literal value inside
//    statement text.

import "std/mem";

import "../core/status";
import "../core/value";

// Mettle has no async and no exceptions. Every call returns an RC_* code and
// writes results through out-parameters.
export const RC_TX_DEFAULT: int32 = 0;
export const RC_TX_DEFERRED: int32 = 1;
export const RC_TX_IMMEDIATE: int32 = 2; // single-writer stores (dacor)

export struct RcRow { values: RcValue*; n: int32; }

export struct RcResult {
  rows: RcRow*;
  n_rows: int32;
  n_cols: int32;
  affected: int32;  // rows changed by an INSERT/UPDATE/DELETE
  last_id: int64;   // assigned auto key, 0 when the statement assigned none
}

export struct RcAdapter {
  name: string;
  ud: rawptr;                                          // driver handle
  open: fn(rawptr, string) -> int32;                   // (ud, dsn) -> RC_*
  close: fn(rawptr) -> int32;
  exec: fn(rawptr, string, RcValue*, int32, RcResult*) -> int32;
  begin: fn(rawptr, int32) -> int32;                   // (ud, RC_TX_*)
  commit: fn(rawptr) -> int32;
  rollback: fn(rawptr) -> int32;
  ping: fn(rawptr) -> int32;
}

// A vtable with no capabilities. Every wrapper above answers
// RC_ERR_UNSUPPORTED, which is how a phase-gated feature behaves before the
// driver implements it.
//
// @noinline is required, not stylistic: on head 8f14c612, `--release` folds a
// *local* aggregate whose function-pointer fields are 0 and then fails to lower
// the indirect call ("call_indirect_unsupported"). Building it behind an
// opaque call keeps the optimizer from seeing the null. Debug is unaffected,
// which is exactly why release is in the test matrix.
@noinline export fn rc_adapter_empty() -> RcAdapter {
  var a: RcAdapter;
  a.name = "none";
  a.ud = 0;
  a.open = 0;
  a.close = 0;
  a.exec = 0;
  a.begin = 0;
  a.commit = 0;
  a.rollback = 0;
  a.ping = 0;
  return a;
}

// --- results -----------------------------------------------------------------

export fn rc_result_init(r: RcResult*) {
  if (r == 0) { return; }
  r.rows = 0;
  r.n_rows = 0;
  r.n_cols = 0;
  r.affected = 0;
  r.last_id = 0;
}

export fn rc_result_alloc(r: RcResult*, n_rows: int32, n_cols: int32) -> int32 {
  if (r == 0) { return RC_ERR_USAGE; }
  rc_result_init(r);
  if (n_rows <= 0 || n_cols <= 0) { return RC_OK; }
  var rows: RcRow* = malloc((int64)n_rows * (int64)sizeof(RcRow));
  if (rows == 0) { return RC_ERR_NOMEM; }
  r.rows = rows;
  r.n_rows = n_rows;
  r.n_cols = n_cols;
  var i: int32 = 0;
  while (i < n_rows) {
    rows[i].values = malloc((int64)n_cols * (int64)sizeof(RcValue));
    if (rows[i].values == 0) {
      // Free what was already built; leave the result empty and freeable.
      var k: int32 = 0;
      while (k < i) {
        free(rows[k].values);
        rows[k].values = 0;
        k = k + 1;
      }
      free(rows);
      r.rows = 0;
      r.n_rows = 0;
      r.n_cols = 0;
      return RC_ERR_NOMEM;
    }
    rows[i].n = n_cols;
    var j: int32 = 0;
    while (j < n_cols) {
      rows[i].values[j] = RcNull;
      j = j + 1;
    }
    i = i + 1;
  }
  return RC_OK;
}

export fn rc_result_free(r: RcResult*) {
  if (r == 0) { return; }
  if (r.rows != 0) {
    var i: int32 = 0;
    while (i < r.n_rows) {
      if (r.rows[i].values != 0) {
        var j: int32 = 0;
        while (j < r.rows[i].n) {
          rc_value_release(r.rows[i].values[j]);
          j = j + 1;
        }
        free(r.rows[i].values);
      }
      i = i + 1;
    }
    free(r.rows);
  }
  rc_result_init(r);
}

// Deep-copies a flat row-major value array into `out`. Used by adapters whose
// source buffers are shorter-lived than the result (and by the test double).
export fn rc_result_copy(out: RcResult*, src: RcValue*, n_rows: int32,
                         n_cols: int32, affected: int32, last_id: int64) -> int32 {
  var rc: int32 = rc_result_alloc(out, n_rows, n_cols);
  if (rc != RC_OK) { return rc; }
  out.affected = affected;
  out.last_id = last_id;
  var i: int32 = 0;
  while (i < n_rows) {
    var j: int32 = 0;
    while (j < n_cols) {
      var v: RcValue = RcNull;
      rc = rc_value_clone(src[i * n_cols + j], &v);
      if (rc != RC_OK) {
        rc_result_free(out);
        return rc;
      }
      out.rows[i].values[j] = v;
      j = j + 1;
    }
    i = i + 1;
  }
  return RC_OK;
}

export fn rc_result_get(r: RcResult*, row: int32, col: int32,
                        out: RcValue*) -> int32 {
  if (r == 0 || out == 0) { return RC_ERR_USAGE; }
  if (row < 0 || row >= r.n_rows) { return RC_ERR_USAGE; }
  if (col < 0 || col >= r.n_cols) { return RC_ERR_USAGE; }
  if (r.rows == 0 || r.rows[row].values == 0) { return RC_ERR_USAGE; }
  return rc_value_clone(r.rows[row].values[col], out);
}

// Borrowed cell, no clone. The returned text/blob is valid exactly as long as
// the result is; do not pass it to rc_value_release. This is what a model
// loader uses to adopt a cell without a copy, and why the result must outlive
// the model.
export fn rc_result_borrow(r: RcResult*, row: int32, col: int32) -> RcValue {
  if (r == 0) { return RcNull; }
  if (row < 0 || row >= r.n_rows) { return RcNull; }
  if (col < 0 || col >= r.n_cols) { return RcNull; }
  if (r.rows == 0 || r.rows[row].values == 0) { return RcNull; }
  return r.rows[row].values[col];
}

// Borrowed view of a text cell; valid until rc_result_free.
export fn rc_result_text(r: RcResult*, row: int32, col: int32,
                         out: string*) -> int32 {
  if (r == 0 || out == 0) { return RC_ERR_USAGE; }
  if (row < 0 || row >= r.n_rows) { return RC_ERR_USAGE; }
  if (col < 0 || col >= r.n_cols) { return RC_ERR_USAGE; }
  return rc_value_as_text(r.rows[row].values[col], out);
}

export fn rc_result_i64(r: RcResult*, row: int32, col: int32,
                        out: int64*) -> int32 {
  if (r == 0 || out == 0) { return RC_ERR_USAGE; }
  if (row < 0 || row >= r.n_rows) { return RC_ERR_USAGE; }
  if (col < 0 || col >= r.n_cols) { return RC_ERR_USAGE; }
  return rc_value_as_i64(r.rows[row].values[col], out);
}

// --- guarded calls -----------------------------------------------------------
// Every vtable entry is optional in principle; a phase-gated capability is a
// zero pointer, and the wrapper turns that into RC_ERR_UNSUPPORTED instead of a
// call through null. The vtable is a boundary, so it is checked.

export fn rc_adapter_open(a: RcAdapter*, dsn: string) -> int32 {
  if (a == 0) { return RC_ERR_USAGE; }
  if (a.open == 0) { return RC_ERR_UNSUPPORTED; }
  return a.open(a.ud, dsn);
}

export fn rc_adapter_close(a: RcAdapter*) -> int32 {
  if (a == 0) { return RC_ERR_USAGE; }
  if (a.close == 0) { return RC_ERR_UNSUPPORTED; }
  return a.close(a.ud);
}

export fn rc_adapter_exec(a: RcAdapter*, sql: string, args: RcValue*,
                          n_args: int32, out: RcResult*) -> int32 {
  if (a == 0 || out == 0) { return RC_ERR_USAGE; }
  rc_result_init(out);
  if (a.exec == 0) { return RC_ERR_UNSUPPORTED; }
  if (n_args < 0) { return RC_ERR_USAGE; }
  if (n_args > 0 && args == 0) { return RC_ERR_USAGE; }
  return a.exec(a.ud, sql, args, n_args, out);
}

export fn rc_adapter_begin(a: RcAdapter*, mode: int32) -> int32 {
  if (a == 0) { return RC_ERR_USAGE; }
  if (a.begin == 0) { return RC_ERR_UNSUPPORTED; }
  return a.begin(a.ud, mode);
}

export fn rc_adapter_commit(a: RcAdapter*) -> int32 {
  if (a == 0) { return RC_ERR_USAGE; }
  if (a.commit == 0) { return RC_ERR_UNSUPPORTED; }
  return a.commit(a.ud);
}

export fn rc_adapter_rollback(a: RcAdapter*) -> int32 {
  if (a == 0) { return RC_ERR_USAGE; }
  if (a.rollback == 0) { return RC_ERR_UNSUPPORTED; }
  return a.rollback(a.ud);
}

export fn rc_adapter_ping(a: RcAdapter*) -> int32 {
  if (a == 0) { return RC_ERR_USAGE; }
  if (a.ping == 0) { return RC_ERR_UNSUPPORTED; }
  return a.ping(a.ud);
}
