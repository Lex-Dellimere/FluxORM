// reach/adapter/dacor.mettle — the bridge to dacor.
//
// Status: gated. dacor's phase-1 contract (dacor/PHASE1.md §5) is a pager:
// dk_pager_open/get/release/alloc/flush and page/cell accessors. There is no
// SQL surface there, and there is no row API: `sql/` and `api/` are later
// phases of that project. So this file defines the bridge and refuses to
// pretend. Every entry point returns RC_ERR_UNSUPPORTED and
// rc_dacor_supported() is false.
//
// What the bridge will call, and why each one matters:
//
//   dk_pager_open(path, n_frames, flags)      one pager per connection
//   dk_pager_begin/commit/rollback            no-ops in phase 1, journal in 3
//   dk_sql_prepare(pager, sql, len)           api/ — prepared statement
//   dk_sql_bind(stmt, i, arg)                 positional only
//   dk_sql_step(stmt) -> DK_ROW | DK_DONE     drives the row loop
//   dk_sql_column_count / column_type         fills RcResult.n_cols
//   dk_sql_column(stmt, i) -> type + bytes    the decode path
//   dk_sql_reset(stmt)                        statement reuse
//   dk_sql_finalize(stmt)                     frees the statement, not pages
//
// The three bridge obligations that are design, not plumbing:
//
// 1. Materialise. step() until DK_DONE inside exec, copy into RcResult, then
//    finalize. No dk_sql_cursor ever leaves this file: a cursor pins pager
//    frames, and a pinned frame that outlives a callback is DK_ERR_BUSY later
//    (dacor/ARCHITECTURE.md §2.4).
//
// 2. Map status. dacor's DK_ERR_* collapse into RC_* here and only here.
//    DK_ERR_CONFLICT -> RC_ERR_CONFLICT, DK_ERR_RANGE -> RC_ERR_CONSTRAINT,
//    DK_ERR_CORRUPT -> RC_ERR_ADAPTER (and the connection must be discarded,
//    not reused: a corrupt pager has no valid cache).
//
// 3. Never encode. dacor owns its varint/zigzag record codec
//    (dacor/PHASE1.md §5.6). The ORM passes typed RcValue arguments and reads
//    typed columns; it must not build cell bytes. That is the one place where
//    an ORM normally duplicates the storage engine by accident.

import "std/mem";

import "../core/status";
import "../core/value";
import "adapter";

export const RC_DACOR_READ: int32 = 1;
export const RC_DACOR_WRITE: int32 = 2;
export const RC_DACOR_CREATE: int32 = 4;
export const RC_DACOR_N_FRAMES: int32 = 256; // 1 MiB of page cache per connection

// The affinity vocabulary the ORM will ask dacor's type layer for. Provisional:
// dacor's types/ module lands with its phase 4, and this table is the contract
// the ORM needs from it. A mismatch is a build-time conversation, not a runtime
// coercion.
export fn rc_dacor_affinity(ty: int32) -> string {
  if (ty == RC_T_I64 || ty == RC_T_U64) { return "INTEGER"; }
  if (ty == RC_T_BOOL) { return "INTEGER"; } // stored 0/1, decoded as bool
  if (ty == RC_T_TIME) { return "INTEGER"; } // unix micros, UTC, never text
  if (ty == RC_T_F64) { return "REAL"; }
  if (ty == RC_T_TEXT) { return "TEXT"; }
  if (ty == RC_T_BLOB) { return "BLOB"; }
  return "";
}

// A declared timestamp is a plain int64 in Mettle. The model marks the column
// with RC_F_TIMESTAMP; this is the conversion both directions use.
export fn rc_dacor_time_from_micros(us: int64) -> RcValue { return RcTime(us); }

export struct RcDacor {
  pager: rawptr; // DkPager*, once api/ exists
  path: string;
  flags: int32;
  depth: int32;
}

fn rc_dacor_open(ud: rawptr, dsn: string) -> int32 { return RC_ERR_UNSUPPORTED; }
fn rc_dacor_close(ud: rawptr) -> int32 { return RC_ERR_UNSUPPORTED; }
fn rc_dacor_exec(ud: rawptr, sql: string, args: RcValue*, n_args: int32,
                 out: RcResult*) -> int32 { return RC_ERR_UNSUPPORTED; }
fn rc_dacor_begin(ud: rawptr, mode: int32) -> int32 { return RC_ERR_UNSUPPORTED; }
fn rc_dacor_commit(ud: rawptr) -> int32 { return RC_ERR_UNSUPPORTED; }
fn rc_dacor_rollback(ud: rawptr) -> int32 { return RC_ERR_UNSUPPORTED; }
fn rc_dacor_ping(ud: rawptr) -> int32 { return RC_ERR_UNSUPPORTED; }

export fn rc_dacor_supported() -> bool { return false; }

export fn rc_dacor_adapter(path: string, flags: int32) -> RcAdapter* {
  var d: RcDacor* = malloc(sizeof(RcDacor));
  if (d == 0) { return 0; }
  d.pager = 0;
  d.path = path;
  d.flags = flags;
  d.depth = 0;
  var a: RcAdapter* = malloc(sizeof(RcAdapter));
  if (a == 0) {
    free(d);
    return 0;
  }
  a.name = "dacor";
  a.ud = (rawptr)d;
  a.open = &rc_dacor_open;
  a.close = &rc_dacor_close;
  a.exec = &rc_dacor_exec;
  a.begin = &rc_dacor_begin;
  a.commit = &rc_dacor_commit;
  a.rollback = &rc_dacor_rollback;
  a.ping = &rc_dacor_ping;
  return a;
}

export fn rc_dacor_adapter_free(a: RcAdapter*) {
  if (a == 0) { return; }
  var d: RcDacor* = (RcDacor*)a.ud;
  if (d != 0) { free(d); }
  free(a);
}
