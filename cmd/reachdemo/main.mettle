// reachdemo — the smallest end-to-end proof that the ORM works.
//
// Builds a model registry from a struct, opens the recording adapter, inserts
// one row, reads it back, and prints the statement text it emitted. No dacor:
// dacor's SQL surface lands in a later phase of that project, so this demo
// runs against the seam's executable specification.

import "std/io";
import "std/mem";

import "../../src/core/status";
import "../../src/core/value";
import "../../src/core/meta";
import "../../src/core/entity";
import "../../src/core/persist";
import "../../src/adapter/adapter";
import "../../src/adapter/mem";

enum Role { Admin = 1, Member = 2 }

struct User {
  id: int64;
  email: string;
  name: string;
  age: int32;
  active: bool;
  created_at: int64;
}

var FIELDS: RcField[6];
var META: RcMeta;
var READY: bool = false;

const COLS: RcColumn[6] = [
  { index: 0, column: "id", ty: RC_T_I64, flags: RC_F_PK | RC_F_AUTO | RC_F_NOT_NULL },
  { index: 1, column: "email", ty: RC_T_TEXT, flags: RC_F_NOT_NULL | RC_F_UNIQUE },
  { index: 2, column: "name", ty: RC_T_TEXT, flags: RC_F_NOT_NULL },
  { index: 3, column: "age", ty: RC_T_I64, flags: 0 },
  { index: 4, column: "active", ty: RC_T_BOOL, flags: RC_F_NOT_NULL },
  { index: 5, column: "created_at", ty: RC_T_TIME, flags: RC_F_TIMESTAMP | RC_F_NOT_NULL },
];

fn fields_into(out: RcField*) -> int32 {
  var i: int32 = 0;
  comptime for f in typeof(User).fields {
    out[i].name = f.name;
    out[i].column = f.name;
    out[i].kind = f.type.kind;
    out[i].ty = rc_kind_type(f.type.kind);
    out[i].offset = (int32)f.offset;
    out[i].size = (int32)f.type.size;
    out[i].flags = 0;
    i = i + 1;
  }
  return i;
}

fn meta() -> RcMeta {
  if (!READY) {
    var n: int32 = fields_into(&FIELDS[0]);
    META.table = "users";
    META.name = "User";
    META.size = (int32)sizeof(User);
    META.fields = &FIELDS[0];
    META.n_fields = n;
    META.pk = -1;
    var rc: int32 = rc_meta_finalize(&META, &COLS[0], 6);
    if (rc != RC_OK) { println("metadata invalid: {rc_status_name(rc)}"); }
    READY = true;
  }
  return META;
}

fn main() -> int32 {
  var m: RcMeta = meta();
  println("model {m.name} -> table \"{m.table}\"  fields={m.n_fields}  pk={m.pk}");

  var a: RcAdapter* = rc_mem_adapter();
  if (a == 0) { return 1; }
  defer rc_mem_free(a);
  if (rc_adapter_open(a, "mem://demo") != RC_OK) { return 2; }
  if (rc_mem_push_ok(a, 1, 42) != RC_OK) { return 3; }

  var u: User;
  memset((rawptr)&u, 0, (int64)sizeof(User));
  var e: RcEntity = rc_entity_new(m, (rawptr)&u);
  rc_entity_set(&e, 1, RcText("ada@example.com"));
  rc_entity_set(&e, 2, RcText("Ada"));
  rc_entity_set(&e, 3, RcNull);          // nullable: NULL, not 0
  rc_entity_set(&e, 4, RcBool(true));
  rc_entity_set(&e, 5, RcTime(1700000000000000));

  var rc: int32 = rc_persist_insert(a, &e);
  if (rc != RC_OK) {
    println("insert failed: {rc_status_name(rc)}");
    return 4;
  }
  println("sql:    {rc_mem_last_sql(a)}");
  println("args:   {rc_mem_arg_count(a)} (age bound as NULL)");
  println("id:     {u.id}  (from last_id)");
  println("state:  {rc_entity_state_name(e.state)}");

  var row: RcValue[6];
  row[0] = RcInt(42);
  row[1] = RcText("ada@example.com");
  row[2] = RcText("Ada");
  row[3] = RcNull;
  row[4] = RcBool(true);
  row[5] = RcTime(1700000000000000);
  rc_mem_push_rows(a, &row[0], 1, 6);

  var u2: User;
  memset((rawptr)&u2, 0, (int64)sizeof(User));
  var nulls: uint64 = 0;
  var owner: RcResult;
  rc = rc_persist_load(a, m, RcInt(42), (rawptr)&u2, &nulls, &owner);
  if (rc != RC_OK) {
    println("load failed: {rc_status_name(rc)}");
    return 5;
  }
  println("select: {rc_mem_last_sql(a)}");
  println("loaded: {u2.email} / {u2.name} / age_is_null={rc_nulls_has(nulls, 3)}");
  rc_result_free(&owner);
  return 0;
}
