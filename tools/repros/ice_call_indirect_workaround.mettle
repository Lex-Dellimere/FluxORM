import "std/io";

struct V { ud: rawptr; f: fn(rawptr) -> int32; g: fn(rawptr, int32) -> int32; }
fn real(ud: rawptr) -> int32 { return 1; }
fn call_f(v: V*) -> int32 { if (v.f == 0) { return -7; } return v.f(v.ud); }

@noinline fn bare() -> V {
  var v: V;
  v.ud = 0;
  v.f = 0;
  v.g = 0;
  return v;
}

fn main() -> int32 {
  var ok: V = { ud: 0, f: &real, g: 0 };
  println("ok={call_f(&ok)}");
  var b: V = bare();
  println("b={call_f(&b)}");
  return 0;
}
