// tests/t_integration.mettle — every layer in one binary.
//
// Each t_*.mettle tests one layer; this one drives migration/, core/persist,
// query/, changeset/ and relation/ together against one model set and one
// adapter, because a layer that passes alone can still fail at the seam.
//
// Notes on what is asserted where:
//
//   * adapter/mem replays scripted rows and does not evaluate SQL, so "the NULL
//     row is excluded" is asserted where the logic lives (the builder's
//     `IS NULL` and the entity's null bitmap), not in a result set.
//   * there is no cache, so a repeated preload is a second statement.
//   * an empty change set is not an error: rc_changeset_save writes nothing.
//
// Every statement is compared with `==` against a literal. The one substring
// helper only proves that `= NULL` never appears.
//
// mem replays a FIFO, so rows are pushed in call order and each statement is
// asserted right after the call that consumed them; the final call count
// catches a reordered statement.
//
// The @test entry calls main(): a direct call chain of the checks from a
// @test makes the head compiler's interpreter segfault while lowering IR.

import "std/io";
import "std/mem";

// Through the import root, as an app would.
import "../src/flux_orm";
import "../src/adapter/mem";
import "models";
import "harness";

// --- exact statements and DDL ------------------------------------------------
// Field indexes, used throughout: User = id 0, email 1, name 2, age 3,
// active 4, score 5, created_at 6, role 7. Post = id 0, user_id 1, title 2,
// body 3, published_at 4.

export const LEDGER_DDL: string = "CREATE TABLE IF NOT EXISTS \"_flux_orm_migrations\" (\"version\" INTEGER PRIMARY KEY, \"name\" TEXT NOT NULL, \"applied_at\" INTEGER NOT NULL)";
export const LEDGER_SELECT: string = "SELECT \"version\" FROM \"_flux_orm_migrations\" ORDER BY \"version\" ASC";
export const LEDGER_INSERT: string = "INSERT INTO \"_flux_orm_migrations\" (\"version\", \"name\", \"applied_at\") VALUES (?, ?, ?)";

export const USER_DDL: string = "CREATE TABLE IF NOT EXISTS \"users\" (\"id\" INTEGER PRIMARY KEY, \"email\" TEXT NOT NULL UNIQUE, \"name\" TEXT NOT NULL, \"age\" INTEGER, \"active\" INTEGER NOT NULL, \"score\" REAL, \"created_at\" INTEGER NOT NULL, \"role\" INTEGER NOT NULL)";
export const POST_DDL: string = "CREATE TABLE IF NOT EXISTS \"posts\" (\"id\" INTEGER PRIMARY KEY, \"user_id\" INTEGER NOT NULL, \"title\" TEXT NOT NULL, \"body\" TEXT, \"published_at\" INTEGER)";

export const INSERT_SQL: string = "INSERT INTO \"users\" (\"email\", \"name\", \"age\", \"active\", \"score\", \"created_at\", \"role\") VALUES (?, ?, ?, ?, ?, ?, ?)";
export const INSERT_KEYED_SQL: string = "INSERT INTO \"users\" (\"id\", \"email\", \"name\", \"age\", \"active\", \"score\", \"created_at\", \"role\") VALUES (?, ?, ?, ?, ?, ?, ?, ?)";
export const LOAD_SQL: string = "SELECT \"id\", \"email\", \"name\", \"age\", \"active\", \"score\", \"created_at\", \"role\" FROM \"users\" WHERE \"id\" = ? LIMIT 1";
export const FILTERED_SQL: string = "SELECT \"id\", \"email\", \"name\", \"age\", \"active\", \"score\", \"created_at\", \"role\" FROM \"users\" WHERE \"age\" IN (?, ?) ORDER BY \"name\" ASC LIMIT 10";
export const IS_NULL_SQL: string = "SELECT \"id\", \"email\", \"name\", \"age\", \"active\", \"score\", \"created_at\", \"role\" FROM \"users\" WHERE \"age\" IS NULL";
export const DELETE_SQL: string = "DELETE FROM \"users\" WHERE \"id\" = ?";

export const POSTS_BY_USER_SQL3: string = "SELECT \"id\", \"user_id\", \"title\", \"body\", \"published_at\" FROM \"posts\" WHERE \"user_id\" IN (?, ?, ?)";
export const POSTS_BY_USER_SQL4: string = "SELECT \"id\", \"user_id\", \"title\", \"body\", \"published_at\" FROM \"posts\" WHERE \"user_id\" IN (?, ?, ?, ?)";
export const USERS_BY_KEY_SQL3: string = "SELECT \"id\", \"email\", \"name\", \"age\", \"active\", \"score\", \"created_at\", \"role\" FROM \"users\" WHERE \"id\" IN (?, ?, ?)";

// The UPDATE rc_changeset_save sends for the two-field change in check 4.
export const UPDATE_SQL: string = "UPDATE \"users\" SET \"name\" = ?, \"age\" = ? WHERE \"id\" = ?";

export const CLOCK: int64 = 1700000000000123;

// --- helpers -----------------------------------------------------------------

// Negative assertion only: does `needle` occur in `hay`? Used to prove that a
// byte string is absent, which no `==` against a statement can show.
export fn has_text(hay: string, needle: string) -> bool {
  var hn: int64 = (int64)hay.length;
  var nn: int64 = (int64)needle.length;
  if (nn == 0) { return true; }
  if (nn > hn) { return false; }
  var i: int64 = 0;
  var found: bool = false;
  while (i + nn <= hn && !found) {
    var j: int64 = 0;
    var same: bool = true;
    while (j < nn) {
      if (hay.chars[i + j] != needle.chars[j]) {
        same = false;
        j = nn;
      } else {
        j = j + 1;
      }
    }
    if (same) { found = true; }
    i = i + 1;
  }
  return found;
}

export fn new_adapter(out: RcAdapter**) -> int32 {
  var a: RcAdapter* = rc_mem_adapter();
  if (a == 0) { return RC_ERR_NOMEM; }
  if (rc_adapter_open(a, "mem://flux_orm") != RC_OK) {
    rc_mem_free(a);
    return RC_ERR_ADAPTER;
  }
  *out = a;
  return RC_OK;
}

// HAS_MANY: User.id (NOT NULL, as the grouping key must be) -> Post.user_id.
export fn rel_posts() -> RcRelation {
  return rc_relation("posts", RC_REL_HAS_MANY, 0, "posts", 1);
}

// BELONGS_TO, declared from the other side: Post.user_id -> User.id.
export fn rel_user() -> RcRelation {
  return rc_relation("user", RC_REL_BELONGS_TO, 1, "users", 0);
}

// The six posts of three owners (7, 9, 11), two each, as one flat row-major
// array. Pushed more than once on purpose: rc_mem_push_rows copies, so the same
// values can script two different statements without aliasing the script.
export fn post_rows(out: RcValue*) -> int32 {
  out[0] = RcInt(1);
  out[1] = RcInt(7);
  out[2] = RcText("first");
  out[3] = RcText("body-1");
  out[4] = RcTime(10);
  out[5] = RcInt(2);
  out[6] = RcInt(7);
  out[7] = RcText("second");
  out[8] = RcNull;
  out[9] = RcTime(11);
  out[10] = RcInt(3);
  out[11] = RcInt(9);
  out[12] = RcText("third");
  out[13] = RcText("body-3");
  out[14] = RcTime(12);
  out[15] = RcInt(4);
  out[16] = RcInt(9);
  out[17] = RcText("fourth");
  out[18] = RcText("body-4");
  out[19] = RcTime(13);
  out[20] = RcInt(5);
  out[21] = RcInt(11);
  out[22] = RcText("fifth");
  out[23] = RcText("body-5");
  out[24] = RcTime(14);
  out[25] = RcInt(6);
  out[26] = RcInt(11);
  out[27] = RcText("sixth");
  out[28] = RcText("body-6");
  out[29] = RcTime(15);
  return 6;
}

// --- 1. schema: the ledger, then the migrations ------------------------------

fn check_migration() -> int32 {
  var a: RcAdapter* = 0;
  if (new_adapter(&a) != RC_OK) { return 1; }
  defer rc_mem_free(a);

  // The DDL is generated from the same RcMeta the write path uses, so the
  // schema cannot drift from the model. Asserted as text, and migration 1 then
  // runs exactly this text.
  var b: RcBuf = rc_buf_new(256);
  if (b.data == 0) { return 2; }
  defer rc_buf_free(&b);

  if (rc_migration_create_table(user_meta(), &b) != RC_OK) { return 3; }
  if (rc_buf_text(&b) != USER_DDL) { return 4; }
  rc_buf_clear(&b);
  if (rc_migration_create_table(post_meta(), &b) != RC_OK) { return 5; }
  if (rc_buf_text(&b) != POST_DDL) { return 6; }

  rc_buf_clear(&b);
  if (rc_migration_ledger_ddl(&b) != RC_OK) { return 7; }
  if (rc_buf_text(&b) != LEDGER_DDL) { return 8; }
  rc_buf_clear(&b);
  if (rc_migration_ledger_select(&b) != RC_OK) { return 9; }
  if (rc_buf_text(&b) != LEDGER_SELECT) { return 10; }
  rc_buf_clear(&b);
  if (rc_migration_ledger_insert(&b) != RC_OK) { return 11; }
  if (rc_buf_text(&b) != LEDGER_INSERT) { return 12; }

  // The script, in the order rc_migration_run issues it: ledger DDL, ledger
  // SELECT (empty on a first run), then up_sql + ledger INSERT per missing
  // version — eight execs for three migrations.
  if (rc_mem_push_ok(a, 0, 0) != RC_OK) { return 13; }   // 1. ledger DDL
  if (rc_mem_push_ok(a, 0, 0) != RC_OK) { return 14; }   // 2. ledger SELECT
  if (rc_mem_push_ok(a, 0, 0) != RC_OK) { return 15; }   // 3. v1 up_sql
  if (rc_mem_push_ok(a, 0, 0) != RC_OK) { return 16; }   // 4. v1 ledger row
  if (rc_mem_push_ok(a, 0, 0) != RC_OK) { return 17; }   // 5. v2 up_sql
  if (rc_mem_push_ok(a, 0, 0) != RC_OK) { return 18; }   // 6. v2 ledger row
  if (rc_mem_push_ok(a, 0, 0) != RC_OK) { return 19; }   // 7. v3 up_sql
  if (rc_mem_push_ok(a, 0, 0) != RC_OK) { return 20; }   // 8. v3 ledger row

  var items: RcMigration[3];
  items[0].version = 1;
  items[0].name = "create users";
  items[0].up_sql = USER_DDL;
  items[1].version = 2;
  items[1].name = "create posts";
  items[1].up_sql = POST_DDL;
  items[2].version = 3;
  items[2].name = "index users email";
  items[2].up_sql = "CREATE INDEX IF NOT EXISTS \"users_email\" ON \"users\" (\"email\")";

  var set: RcMigrationSet = rc_migration_set(&items[0], 3);
  if (rc_migration_check(set) != RC_OK) { return 21; }

  // applied_at is an injected seam, never wall time.
  rc_migration_set_clock(0);
  if (rc_migration_now_micros() != 0) { return 22; }
  rc_migration_set_clock(CLOCK);
  if (rc_migration_now_micros() != CLOCK) { return 23; }

  var rep: RcMigrationReport;
  var rc: int32 = rc_migration_run(a, &set, &rep);
  if (rc != RC_OK) { return 24; }
  if (rep.code != RC_OK) { return 25; }
  if (rep.applied != 3) { return 26; }
  if (rep.up_to != 3) { return 27; }
  if (rep.failed_version != 0) { return 28; }

  // One transaction per migration: three commits, no rollback, nothing open.
  if (rc_mem_commits(a) != 3) { return 29; }
  if (rc_mem_rollbacks(a) != 0) { return 30; }
  if (rc_mem_tx_depth(a) != 0) { return 31; }
  // 1 (DDL) + 1 (SELECT) + 3 * 2. A reordered sequence misaligns the FIFO and
  // changes this number, which is what makes the count an assertion about order.
  if (rc_mem_call_count(a) != 8) { return 32; }

  // The last exec is version 3's ledger row, bound in column order.
  if (rc_mem_last_sql(a) != LEDGER_INSERT) { return 33; }
  if (rc_mem_arg_count(a) != 3) { return 34; }
  var args: RcValue* = rc_mem_last_args(a);
  if (args == 0) { return 35; }
  if (!rc_value_same(args[0], RcInt(3))) { return 36; }
  if (!rc_value_same(args[1], RcText("index users email"))) { return 37; }
  if (!rc_value_same(args[2], RcTime(CLOCK))) { return 38; }

  // A second run over a full ledger: the two ledger statements and nothing
  // else. No migration DDL re-executes and no transaction starts.
  if (rc_mem_push_ok(a, 0, 0) != RC_OK) { return 39; }
  var ledger: RcValue[3];
  ledger[0] = RcInt(1);
  ledger[1] = RcInt(2);
  ledger[2] = RcInt(3);
  if (rc_mem_push_rows(a, &ledger[0], 3, 1) != RC_OK) { return 40; }

  rc = rc_migration_run(a, &set, &rep);
  if (rc != RC_OK) { return 41; }
  if (rep.applied != 0) { return 42; }
  if (rep.up_to != 3) { return 43; }
  if (rc_mem_commits(a) != 3) { return 44; }
  if (rc_mem_call_count(a) != 10) { return 45; }
  // The ledger SELECT is the last statement: nothing followed it, so no
  // `CREATE TABLE` for an applied version ran.
  if (rc_mem_last_sql(a) != LEDGER_SELECT) { return 46; }
  if (rc_mem_arg_count(a) != 0) { return 47; }

  rc_migration_set_clock(0);
  return 0;
}

// --- 2. insert: args in declaration order, the key comes back ----------------

fn check_insert() -> int32 {
  var a: RcAdapter* = 0;
  if (new_adapter(&a) != RC_OK) { return 1; }
  defer rc_mem_free(a);

  var m: RcMeta = user_meta();
  var u: User;
  memset((rawptr)&u, 0, (int64)sizeof(User));
  var e: RcEntity = rc_entity_new(m, (rawptr)&u);
  if (rc_entity_set(&e, 1, RcText("ada@example.com")) != RC_OK) { return 2; }
  if (rc_entity_set(&e, 2, RcText("Ada")) != RC_OK) { return 3; }
  if (rc_entity_set(&e, 3, RcNull) != RC_OK) { return 4; }   // nullable age
  if (rc_entity_set(&e, 4, RcBool(true)) != RC_OK) { return 5; }
  if (rc_entity_set(&e, 5, RcFloat(9.5)) != RC_OK) { return 6; }
  if (rc_entity_set(&e, 6, RcTime(1700000000000000)) != RC_OK) { return 7; }
  if (rc_entity_set(&e, 7, RcInt(2)) != RC_OK) { return 8; }
  if (e.state != RC_ST_NEW) { return 9; }
  if (!rc_null_is_keyless(&e)) { return 10; }

  // One step, for the INSERT: the AUTO key is omitted because this row has no
  // key, and the store hands one back.
  if (rc_mem_push_ok(a, 1, 42) != RC_OK) { return 11; }
  if (rc_persist_insert(a, &e) != RC_OK) { return 12; }
  if (rc_mem_call_count(a) != 1) { return 13; }
  if (rc_mem_last_sql(a) != INSERT_SQL) { return 14; }
  if (rc_mem_arg_count(a) != 7) { return 15; }
  var args: RcValue* = rc_mem_last_args(a);
  if (!rc_value_same(args[0], RcText("ada@example.com"))) { return 16; }
  if (!rc_value_same(args[1], RcText("Ada"))) { return 17; }
  if (!rc_value_is_null(args[2])) { return 18; }   // NULL binds, 0 would be a value
  if (!rc_value_same(args[3], RcBool(true))) { return 19; }
  if (!rc_value_same(args[4], RcFloat(9.5))) { return 20; }
  if (!rc_value_same(args[5], RcTime(1700000000000000))) { return 21; }
  if (!rc_value_same(args[6], RcInt(2))) { return 22; }

  // NEW -> CLEAN, with the store's key adopted into the model.
  if (u.id != 42) { return 23; }
  if (e.state != RC_ST_CLEAN) { return 24; }
  if (rc_nulls_has(e.nulls, 0)) { return 25; }
  if (!rc_value_same(rc_entity_pk(&e), RcInt(42))) { return 26; }

  // An explicit key is part of the statement: the AUTO rule drops only the key
  // this row does not have.
  var u2: User;
  memset((rawptr)&u2, 0, (int64)sizeof(User));
  var e2: RcEntity = rc_entity_new(m, (rawptr)&u2);
  if (rc_entity_set(&e2, 0, RcInt(7)) != RC_OK) { return 27; }
  if (rc_entity_set(&e2, 1, RcText("bob@example.com")) != RC_OK) { return 28; }
  if (rc_entity_set(&e2, 2, RcText("Bob")) != RC_OK) { return 29; }
  if (rc_entity_set(&e2, 4, RcBool(false)) != RC_OK) { return 30; }
  if (rc_entity_set(&e2, 6, RcTime(1)) != RC_OK) { return 31; }
  if (rc_entity_set(&e2, 7, RcInt(1)) != RC_OK) { return 32; }

  if (rc_mem_push_ok(a, 1, 0) != RC_OK) { return 33; }
  if (rc_persist_insert(a, &e2) != RC_OK) { return 34; }
  if (rc_mem_call_count(a) != 2) { return 35; }
  if (rc_mem_last_sql(a) != INSERT_KEYED_SQL) { return 36; }
  if (rc_mem_arg_count(a) != 8) { return 37; }
  if (!rc_value_same(rc_mem_last_args(a)[0], RcInt(7))) { return 38; }
  if (u2.id != 7) { return 39; }
  if (e2.state != RC_ST_CLEAN) { return 40; }
  return 0;
}

// A NEW entity with an AUTO key must not report a key yet.
export fn rc_null_is_keyless(e: RcEntity*) -> bool {
  if (rc_entity_has_pk(e)) { return false; }
  if (!rc_value_is_null(rc_entity_pk(e))) { return false; }
  if (!rc_nulls_has(e->nulls, 0)) { return false; }
  if (e->model == 0) { return false; }
  return true;
}

// --- 3. query: the statement, the argv, and three-valued NULL ----------------

fn check_query() -> int32 {
  var a: RcAdapter* = 0;
  if (new_adapter(&a) != RC_OK) { return 1; }
  defer rc_mem_free(a);

  var m: RcMeta = user_meta();
  if (rc_meta_find(m, "age") != 3) { return 2; }
  if (rc_meta_find(m, "name") != 2) { return 3; }

  // The age predicate is an IN list, built from field indexes.
  var ages: RcValue[2];
  ages[0] = RcInt(31);
  ages[1] = RcInt(32);
  var q: RcQuery = rc_query_select(m);
  defer rc_query_free(&q);
  if (rc_query_where_in(&q, 3, &ages[0], 2) != RC_OK) { return 4; }
  if (rc_query_order_by(&q, 2, true) != RC_OK) { return 5; }
  if (rc_query_limit(&q, 10) != RC_OK) { return 6; }
  if (rc_query_sql(&q) != FILTERED_SQL) { return 7; }
  if (rc_query_n_args(&q) != 2) { return 8; }
  if (!rc_value_same(rc_query_args(&q)[0], RcInt(31))) { return 9; }
  if (!rc_value_same(rc_query_args(&q)[1], RcInt(32))) { return 10; }

  // The pushed row belongs to this statement: index 0 of the FIFO, asserted
  // together with the text it was replayed for.
  var row: RcValue[8];
  row[0] = RcInt(1);
  row[1] = RcText("ada@example.com");
  row[2] = RcText("Ada");
  row[3] = RcInt(31);
  row[4] = RcBool(true);
  row[5] = RcFloat(9.5);
  row[6] = RcTime(1700000000000000);
  row[7] = RcInt(2);
  if (rc_mem_push_rows(a, &row[0], 1, 8) != RC_OK) { return 11; }

  var res: RcResult;
  if (rc_query_exec(&q, a, &res) != RC_OK) { return 12; }
  defer rc_result_free(&res);
  if (rc_mem_call_count(a) != 1) { return 13; }
  if (rc_mem_last_sql(a) != FILTERED_SQL) { return 14; }
  if (rc_mem_arg_count(a) != 2) { return 15; }
  if (!rc_value_same(rc_mem_last_args(a)[0], RcInt(31))) { return 16; }
  if (!rc_value_same(rc_mem_last_args(a)[1], RcInt(32))) { return 17; }
  if (res.n_rows != 1) { return 18; }
  if (res.n_cols != 8) { return 19; }
  var name: string;
  if (rc_result_text(&res, 0, 2, &name) != RC_OK) { return 20; }
  if (name != "Ada") { return 21; }
  var age: int64 = 0;
  if (rc_result_i64(&res, 0, 3, &age) != RC_OK) { return 22; }
  if (age != 31) { return 23; }

  // Three-valued logic, where it lives: a NULL equality is `IS NULL` and binds
  // nothing. `= NULL` cannot be produced at all.
  var qn: RcQuery = rc_query_select(m);
  defer rc_query_free(&qn);
  if (rc_query_where_eq(&qn, 3, RcNull) != RC_OK) { return 24; }
  if (rc_query_sql(&qn) != IS_NULL_SQL) { return 25; }
  if (rc_query_n_args(&qn) != 0) { return 26; }
  if (has_text(rc_query_sql(&qn), "= NULL")) { return 27; }
  if (rc_mem_push_ok(a, 0, 0) != RC_OK) { return 28; }
  var nres: RcResult;
  if (rc_query_exec(&qn, a, &nres) != RC_OK) { return 29; }
  rc_result_free(&nres);
  if (rc_mem_call_count(a) != 2) { return 30; }
  if (rc_mem_last_sql(a) != IS_NULL_SQL) { return 31; }
  if (rc_mem_arg_count(a) != 0) { return 32; }

  // adapter/mem replays rows and does not evaluate SQL, so "the NULL row is
  // excluded" is not observable as a result set. What *is* observable is the
  // distinction the predicate rests on: a NULL field reads back as RcNull while
  // its storage byte is 0, and 0 reads back as RcInt(0) with no null bit.
  var u: User;
  memset((rawptr)&u, 0, (int64)sizeof(User));
  var e: RcEntity = rc_entity_new(m, (rawptr)&u);
  if (rc_entity_set(&e, 3, RcNull) != RC_OK) { return 33; }
  if (u.age != 0) { return 34; }                  // storage is zeroed ...
  if (!rc_nulls_has(e.nulls, 3)) { return 35; }   // ... the bitmap is the truth
  var got: RcValue = RcInt(-1);
  if (rc_entity_get(&e, 3, &got) != RC_OK) { return 36; }
  if (!rc_value_is_null(got)) { return 37; }
  if (rc_entity_set(&e, 3, RcInt(0)) != RC_OK) { return 38; }
  if (rc_nulls_has(e.nulls, 3)) { return 39; }
  var zero: RcValue = RcNull;
  if (rc_entity_get(&e, 3, &zero) != RC_OK) { return 40; }
  if (rc_value_is_null(zero)) { return 41; }
  if (!rc_value_same(zero, RcInt(0))) { return 42; }
  return 0;
}

// --- 4. changeset: the two-field mask ---------------------------------------

fn check_changeset() -> int32 {
  var a: RcAdapter* = 0;
  if (new_adapter(&a) != RC_OK) { return 1; }
  defer rc_mem_free(a);

  var m: RcMeta = user_meta();

  // A row as the store hands it back. age holds a value, so setting it to NULL
  // is a real change: rc_changeset_put compares against the baseline row.
  var row: RcValue[8];
  row[0] = RcInt(42);
  row[1] = RcText("ada@example.com");
  row[2] = RcText("Ada");
  row[3] = RcInt(30);
  row[4] = RcBool(true);
  row[5] = RcFloat(9.5);
  row[6] = RcTime(1700000000000000);
  row[7] = RcInt(2);
  if (rc_mem_push_rows(a, &row[0], 1, 8) != RC_OK) { return 2; }

  var u: User;
  memset((rawptr)&u, 0, (int64)sizeof(User));
  var nulls: uint64 = 0;
  var owner: RcResult;
  if (rc_persist_load(a, m, RcInt(42), (rawptr)&u, &nulls, &owner) != RC_OK) {
    return 3;
  }
  defer rc_result_free(&owner);
  if (rc_mem_last_sql(a) != LOAD_SQL) { return 4; }
  if (rc_mem_arg_count(a) != 1) { return 5; }
  if (!rc_value_same(rc_mem_last_args(a)[0], RcInt(42))) { return 6; }
  if (u.name != "Ada") { return 7; }
  if (u.age != 30) { return 8; }
  if (rc_nulls_has(nulls, 3)) { return 9; }

  var e: RcEntity = rc_entity_new(m, (rawptr)&u);
  e.nulls = nulls;
  e.state = RC_ST_CLEAN;

  var cs: RcChangeset = rc_changeset_new(m);
  defer rc_changeset_free(&cs);
  if (rc_changeset_bind(&cs, (rawptr)&u, nulls) != RC_OK) { return 10; }
  if (rc_changeset_n_dirty(&cs) != 0) { return 11; }

  if (rc_changeset_put_name(&cs, "name", RcText("Ada L.")) != RC_OK) { return 12; }
  if (rc_changeset_put_null(&cs, 3) != RC_OK) { return 13; }

  // Exactly two bits — name and age — and no others.
  if (rc_changeset_n_dirty(&cs) != 2) { return 14; }
  var i: int32 = 0;
  while (i < m.n_fields) {
    var want: bool = false;
    if (i == 2 || i == 3) { want = true; }
    if (rc_changeset_has(&cs, i) != want) { return 15; }
    i = i + 1;
  }

  // The values an UPDATE would bind, in field order.
  if (!rc_value_same(cs.values[2], RcText("Ada L."))) { return 16; }
  if (!rc_value_is_null(cs.values[3])) { return 17; }

  // A put that restates the row's own value sets no bit, so the column list
  // cannot grow to include a column nobody touched.
  if (rc_changeset_put(&cs, 1, RcText("ada@example.com")) != RC_OK) { return 18; }
  if (rc_changeset_has(&cs, 1)) { return 19; }
  if (rc_changeset_n_dirty(&cs) != 2) { return 20; }

  // save writes exactly those two fields: one UPDATE, the dirty columns in
  // field order, the key last.
  if (rc_mem_push_ok(a, 1, 0) != RC_OK) { return 21; }
  if (rc_changeset_save(a, &cs, &e) != RC_OK) { return 22; }
  if (rc_mem_last_sql(a) != UPDATE_SQL) { return 23; }
  if (rc_mem_arg_count(a) != 3) { return 24; }
  var sent: RcValue* = rc_mem_last_args(a);
  if (!rc_value_same(sent[0], RcText("Ada L."))) { return 25; }
  if (!rc_value_is_null(sent[1])) { return 26; }
  if (!rc_value_same(sent[2], RcInt(42))) { return 27; }
  if (e.state != RC_ST_CLEAN) { return 28; }
  if (u.name != "Ada L.") { return 29; }
  if (!rc_nulls_has(e.nulls, 3)) { return 30; }
  if (u.age != 0) { return 31; }
  if (rc_mem_call_count(a) != 2) { return 48; }   // the load and the update

  // Zero and NULL are never conflated. Against a baseline age of 30, a 0 is a
  // change and the cell binds RcInt(0).
  if (rc_changeset_reset(&cs) != RC_OK) { return 32; }
  if (rc_entity_set(&e, 3, RcInt(30)) != RC_OK) { return 33; }
  if (rc_changeset_bind(&cs, (rawptr)&u, e.nulls) != RC_OK) { return 34; }
  if (rc_changeset_put(&cs, 3, RcInt(0)) != RC_OK) { return 35; }
  if (!rc_changeset_has(&cs, 3)) { return 36; }
  if (rc_changeset_n_dirty(&cs) != 1) { return 37; }
  if (!rc_value_same(cs.values[3], RcInt(0))) { return 38; }
  if (rc_value_is_null(cs.values[3])) { return 39; }

  // And against a baseline age of 0, a NULL is a change whose cell binds
  // RcNull — the two are one bit apart in the mask, not the same value.
  if (rc_changeset_reset(&cs) != RC_OK) { return 40; }
  if (rc_entity_set(&e, 3, RcInt(0)) != RC_OK) { return 41; }
  if (rc_changeset_bind(&cs, (rawptr)&u, e.nulls) != RC_OK) { return 42; }
  if (rc_changeset_put_null(&cs, 3) != RC_OK) { return 43; }
  if (!rc_changeset_has(&cs, 3)) { return 44; }
  if (!rc_value_is_null(cs.values[3])) { return 45; }
  if (rc_changeset_n_dirty(&cs) != 1) { return 46; }
  if (rc_mem_call_count(a) != 2) { return 47; }
  return 0;
}

// --- 5. relations: one statement per relation, and no N+1 --------------------

fn check_relations() -> int32 {
  var a: RcAdapter* = 0;
  if (new_adapter(&a) != RC_OK) { return 1; }
  defer rc_mem_free(a);

  var um: RcMeta = user_meta();
  var pm: RcMeta = post_meta();
  var rel: RcRelation = rel_posts();

  var rows: RcValue[30];
  if (post_rows(&rows[0]) != 6) { return 2; }

  // Three owners, two posts each: one statement, and the rows are pushed for
  // that statement's index.
  var keys: RcValue[3];
  keys[0] = RcInt(7);
  keys[1] = RcInt(9);
  keys[2] = RcInt(11);
  if (rc_mem_push_rows(a, &rows[0], 6, 5) != RC_OK) { return 3; }

  var out: RcRelationResult;
  var rc: int32 = rc_relation_load(a, &rel, um, pm, 0, &keys[0], 3, &out);
  if (rc != RC_OK) { return 4; }
  defer rc_relation_free(&out);

  if (rc_mem_call_count(a) != 1) { return 5; }
  if (out.n_execs != 1) { return 6; }
  if (rc_mem_last_sql(a) != POSTS_BY_USER_SQL3) { return 7; }
  if (rc_mem_arg_count(a) != 3) { return 8; }
  var bound: RcValue* = rc_mem_last_args(a);
  if (!rc_value_same(bound[0], RcInt(7))) { return 9; }
  if (!rc_value_same(bound[1], RcInt(9))) { return 10; }
  if (!rc_value_same(bound[2], RcInt(11))) { return 11; }

  // 2 / 2 / 2, in owner order, and the row indexes line up with the rows.
  if (out.n_keys != 3) { return 12; }
  if (rc_relation_group(&out, 7) != 0) { return 13; }
  if (rc_relation_group(&out, 9) != 1) { return 14; }
  if (rc_relation_group(&out, 11) != 2) { return 15; }
  if (rc_relation_count(&out, 0) != 2) { return 16; }
  if (rc_relation_count(&out, 1) != 2) { return 17; }
  if (rc_relation_count(&out, 2) != 2) { return 18; }
  if (out.off[0] != 0) { return 19; }
  if (out.off[1] != 2) { return 20; }
  if (out.off[2] != 4) { return 21; }
  if (out.off[3] != 6) { return 22; }
  if (out.idx[0] != 0) { return 23; }
  if (out.idx[2] != 2) { return 24; }
  if (out.idx[5] != 5) { return 25; }

  // The owner attachment, proved by hydrating a model out of a group.
  var p: Post;
  var pn: uint64 = 0;
  if (rc_relation_hydrate(&out, 1, 0, (rawptr)&p, &pn) != RC_OK) { return 26; }
  if (p.user_id != 9) { return 27; }
  if (p.title != "third") { return 28; }
  if (rc_nulls_has(pn, 3)) { return 29; }   // this post has a body

  // An owner with zero posts. Three placeholders cannot carry a fourth owner,
  // so this is a second load:
  // four keys, still one exec, and group 3 is an empty slice inside a non-null
  // index array — not a null pointer.
  var keys4: RcValue[4];
  keys4[0] = RcInt(7);
  keys4[1] = RcInt(9);
  keys4[2] = RcInt(11);
  keys4[3] = RcInt(13);
  if (rc_mem_push_rows(a, &rows[0], 6, 5) != RC_OK) { return 30; }

  var out4: RcRelationResult;
  rc = rc_relation_load(a, &rel, um, pm, 0, &keys4[0], 4, &out4);
  if (rc != RC_OK) { return 31; }
  defer rc_relation_free(&out4);
  if (rc_mem_call_count(a) != 2) { return 32; }
  if (out4.n_execs != 1) { return 33; }
  if (rc_mem_last_sql(a) != POSTS_BY_USER_SQL4) { return 34; }
  if (rc_mem_arg_count(a) != 4) { return 35; }
  if (!rc_value_same(rc_mem_last_args(a)[3], RcInt(13))) { return 36; }
  if (rc_relation_group(&out4, 13) != 3) { return 37; }
  if (rc_relation_count(&out4, 3) != 0) { return 38; }
  if (out4.idx == 0) { return 39; }                 // rows exist, so the slice is real
  if (out4.off[3] != out4.off[4]) { return 40; }    // and the empty group is empty

  // belongs-to from the other side: three posts, one exec, the owners attached.
  var b: RcAdapter* = 0;
  if (new_adapter(&b) != RC_OK) { return 41; }
  defer rc_mem_free(b);

  var users: RcValue[24];
  users[0] = RcInt(7);
  users[1] = RcText("a@example.com");
  users[2] = RcText("A");
  users[3] = RcInt(30);
  users[4] = RcBool(true);
  users[5] = RcFloat(1.5);
  users[6] = RcTime(100);
  users[7] = RcInt(2);
  users[8] = RcInt(9);
  users[9] = RcText("b@example.com");
  users[10] = RcText("B");
  users[11] = RcInt(31);
  users[12] = RcBool(true);
  users[13] = RcFloat(2.5);
  users[14] = RcTime(101);
  users[15] = RcInt(1);
  users[16] = RcInt(11);
  users[17] = RcText("c@example.com");
  users[18] = RcText("C");
  users[19] = RcInt(32);
  users[20] = RcBool(false);
  users[21] = RcFloat(3.5);
  users[22] = RcTime(102);
  users[23] = RcInt(2);
  if (rc_mem_push_rows(b, &users[0], 3, 8) != RC_OK) { return 42; }

  var bel: RcRelation = rel_user();
  var pkeys: RcValue[3];
  pkeys[0] = RcInt(7);
  pkeys[1] = RcInt(9);
  pkeys[2] = RcInt(11);
  var outb: RcRelationResult;
  rc = rc_relation_load(b, &bel, pm, um, 0, &pkeys[0], 3, &outb);
  if (rc != RC_OK) { return 43; }
  defer rc_relation_free(&outb);
  if (rc_mem_call_count(b) != 1) { return 44; }
  if (outb.n_execs != 1) { return 45; }
  if (rc_mem_last_sql(b) != USERS_BY_KEY_SQL3) { return 46; }
  if (rc_mem_arg_count(b) != 3) { return 47; }
  var pb: RcValue* = rc_mem_last_args(b);
  if (!rc_value_same(pb[0], RcInt(7))) { return 48; }
  if (!rc_value_same(pb[1], RcInt(9))) { return 49; }
  if (!rc_value_same(pb[2], RcInt(11))) { return 50; }
  if (rc_relation_count(&outb, 0) != 1) { return 51; }
  if (rc_relation_count(&outb, 2) != 1) { return 52; }
  var u: User;
  var un: uint64 = 0;
  if (rc_relation_hydrate(&outb, 0, 0, (rawptr)&u, &un) != RC_OK) { return 53; }
  if (u.id != 7) { return 54; }
  if (u.email != "a@example.com") { return 55; }
  if (rc_nulls_has(un, 1)) { return 56; }   // the email came back
  return 0;
}

// --- 6. delete, and a conflict that leaves no state -------------------------

fn check_delete_and_conflict() -> int32 {
  var a: RcAdapter* = 0;
  if (new_adapter(&a) != RC_OK) { return 1; }
  defer rc_mem_free(a);

  var m: RcMeta = user_meta();
  var u: User;
  memset((rawptr)&u, 0, (int64)sizeof(User));
  var e: RcEntity = rc_entity_new(m, (rawptr)&u);
  if (rc_entity_set(&e, 0, RcInt(42)) != RC_OK) { return 2; }
  e.state = RC_ST_CLEAN;

  // One statement, one bound key.
  if (rc_mem_push_ok(a, 1, 0) != RC_OK) { return 3; }
  if (rc_persist_delete(a, &e) != RC_OK) { return 4; }
  if (rc_mem_call_count(a) != 1) { return 5; }
  if (rc_mem_last_sql(a) != DELETE_SQL) { return 6; }
  if (rc_mem_arg_count(a) != 1) { return 7; }
  if (!rc_value_same(rc_mem_last_args(a)[0], RcInt(42))) { return 8; }
  if (e.state != RC_ST_DELETED) { return 9; }

  // A second delete is refused before the store sees it.
  if (rc_persist_delete(a, &e) != RC_ERR_USAGE) { return 10; }
  if (rc_mem_call_count(a) != 1) { return 11; }

  var b: RcAdapter* = 0;
  if (new_adapter(&b) != RC_OK) { return 12; }
  defer rc_mem_free(b);

  var u2: User;
  memset((rawptr)&u2, 0, (int64)sizeof(User));
  var e2: RcEntity = rc_entity_new(m, (rawptr)&u2);
  if (rc_entity_set(&e2, 1, RcText("dup@example.com")) != RC_OK) { return 13; }
  if (rc_entity_set(&e2, 2, RcText("Dup")) != RC_OK) { return 14; }
  if (rc_entity_set(&e2, 4, RcBool(true)) != RC_OK) { return 15; }
  if (rc_entity_set(&e2, 6, RcTime(5)) != RC_OK) { return 16; }
  if (rc_entity_set(&e2, 7, RcInt(2)) != RC_OK) { return 17; }

  // Every field as it was written, so a partial mutation cannot hide.
  var before: RcValue[8];
  var i: int32 = 0;
  while (i < m.n_fields) {
    if (rc_entity_get(&e2, i, &before[i]) != RC_OK) { return 18; }
    i = i + 1;
  }
  var nulls_before: uint64 = e2.nulls;

  if (rc_mem_fail_next(b, RC_ERR_CONFLICT) != RC_OK) { return 19; }
  if (rc_persist_insert(b, &e2) != RC_ERR_CONFLICT) { return 20; }
  // The injected failure records nothing: the counter did not move and there is
  // no statement text, which is the whole point of asserting it here.
  if (rc_mem_call_count(b) != 0) { return 21; }
  // No partial mutation: still NEW, still keyless, every field as written.
  if (e2.state != RC_ST_NEW) { return 22; }
  if (!rc_null_is_keyless(&e2)) { return 23; }
  if (u2.id != 0) { return 24; }
  if (e2.nulls != nulls_before) { return 25; }
  var after: RcValue = RcNull;
  i = 0;
  while (i < m.n_fields) {
    if (rc_entity_get(&e2, i, &after) != RC_OK) { return 26; }
    if (!rc_value_same(before[i], after)) { return 27; }
    i = i + 1;
  }
  if (u2.email != "dup@example.com") { return 28; }

  // The retry is a fresh statement, and it lands.
  if (rc_mem_push_ok(b, 1, 77) != RC_OK) { return 29; }
  if (rc_persist_insert(b, &e2) != RC_OK) { return 30; }
  if (rc_mem_call_count(b) != 1) { return 31; }
  if (rc_mem_last_sql(b) != INSERT_SQL) { return 32; }
  if (u2.id != 77) { return 33; }
  if (e2.state != RC_ST_CLEAN) { return 34; }
  if (!rc_value_same(rc_entity_pk(&e2), RcInt(77))) { return 35; }
  return 0;
}

// --- 7. the failure matrix --------------------------------------------------

fn check_failure_matrix() -> int32 {
  var a: RcAdapter* = 0;
  if (new_adapter(&a) != RC_OK) { return 1; }
  defer rc_mem_free(a);

  var m: RcMeta = user_meta();
  var pm: RcMeta = post_meta();

  // 1. NULL into a NOT NULL column: RC_ERR_CONSTRAINT from core/meta ...
  var u: User;
  memset((rawptr)&u, 0, (int64)sizeof(User));
  var e: RcEntity = rc_entity_new(m, (rawptr)&u);
  if (rc_entity_set(&e, 2, RcNull) != RC_ERR_CONSTRAINT) { return 2; }
  if (rc_mem_call_count(a) != 0) { return 3; }

  // ... and from changeset one layer earlier, with the offending field index.
  var cs: RcChangeset = rc_changeset_new(m);
  defer rc_changeset_free(&cs);
  if (rc_changeset_put(&cs, 2, RcNull) != RC_ERR_CONSTRAINT) { return 4; }
  if (rc_changeset_error_field(&cs) != 2) { return 5; }
  if (rc_changeset_error_reason(&cs) != "not null") { return 6; }
  if (rc_changeset_error_code(&cs) != RC_ERR_CONSTRAINT) { return 7; }
  if (rc_mem_call_count(a) != 0) { return 8; }

  // 2. Unknown changeset field name: RC_ERR_USAGE, no field index (there is no
  // index to report), and the static reason.
  var cs2: RcChangeset = rc_changeset_new(m);
  defer rc_changeset_free(&cs2);
  if (rc_changeset_put_name(&cs2, "nope", RcInt(1)) != RC_ERR_USAGE) { return 9; }
  if (rc_changeset_error_field(&cs2) != -1) { return 10; }
  if (rc_changeset_error_reason(&cs2) != "unknown field name") { return 11; }
  if (rc_changeset_error_code(&cs2) != RC_ERR_USAGE) { return 12; }
  if (rc_changeset_valid(&cs2)) { return 13; }
  if (rc_mem_call_count(a) != 0) { return 14; }

  // 3. A model whose field type the wire cannot carry: refused at startup, so
  // the statement is never built.
  if (doc_meta_status() != RC_ERR_UNSUPPORTED) { return 15; }
  var d: Doc;
  memset((rawptr)&d, 0, (int64)sizeof(Doc));
  var de: RcEntity = rc_entity_new(doc_meta(), (rawptr)&d);
  if (rc_entity_set(&de, 0, RcInt(1)) != RC_OK) { return 16; }
  if (rc_persist_insert(a, &de) != RC_ERR_UNSUPPORTED) { return 17; }
  if (rc_mem_call_count(a) != 0) { return 18; }

  // 4. An empty change set. Saving it writes no field and never reaches the
  // store, which is the "never a full-row rewrite" property, asserted directly.
  var cs3: RcChangeset = rc_changeset_new(m);
  defer rc_changeset_free(&cs3);
  if (rc_changeset_n_dirty(&cs3) != 0) { return 19; }
  if (!rc_changeset_valid(&cs3)) { return 20; }
  var clean: User;
  memset((rawptr)&clean, 0, (int64)sizeof(User));
  var ce: RcEntity = rc_entity_new(m, (rawptr)&clean);
  if (rc_entity_set(&ce, 0, RcInt(5)) != RC_OK) { return 21; }
  ce.state = RC_ST_CLEAN;
  if (rc_changeset_save(a, &cs3, &ce) != RC_OK) { return 22; }
  if (ce.state != RC_ST_CLEAN) { return 23; }     // CLEAN -> DIRTY needs a write
  if (clean.id != 5) { return 24; }
  if (rc_mem_call_count(a) != 0) { return 25; }

  // 5. A relation whose key field is not RC_T_I64: RC_ERR_CAST, and the loader
  // refuses before it emits anything.
  var wrong: RcRelation = rc_relation("posts", RC_REL_HAS_MANY, 1, "posts", 1);
  if (rc_relation_check(&wrong, m, pm, 0) != RC_ERR_CAST) { return 26; }
  var keys: RcValue[1];
  keys[0] = RcInt(7);
  var out: RcRelationResult;
  if (rc_relation_load(a, &wrong, m, pm, 0, &keys[0], 1, &out) != RC_ERR_CAST) {
    return 27;
  }
  rc_relation_free(&out);
  if (rc_mem_call_count(a) != 0) { return 28; }

  // 6. Duplicate migration version: RC_ERR_USAGE before any exec, and no
  // transaction state to unwind.
  var dup: RcMigration[2];
  dup[0].version = 1;
  dup[0].name = "one";
  dup[0].up_sql = "CREATE TABLE a";
  dup[1].version = 1;
  dup[1].name = "one again";
  dup[1].up_sql = "CREATE TABLE b";
  var ds: RcMigrationSet = rc_migration_set(&dup[0], 2);
  if (rc_migration_check(ds) != RC_ERR_USAGE) { return 29; }
  var rep: RcMigrationReport;
  if (rc_migration_run(a, &ds, &rep) != RC_ERR_USAGE) { return 30; }
  if (rep.code != RC_ERR_USAGE) { return 31; }
  if (rep.applied != 0) { return 32; }
  if (rep.failed_version != 0) { return 33; }
  if (rc_mem_call_count(a) != 0) { return 34; }
  if (rc_mem_commits(a) != 0) { return 35; }
  if (rc_mem_rollbacks(a) != 0) { return 36; }
  if (rc_mem_tx_depth(a) != 0) { return 37; }
  return 0;
}

// --- runner -----------------------------------------------------------------
//
// One table of checks, walked by main(). The @test entry goes through the same
// table: on head 8f14c612 the compile-time interpreter segfaults in "IR
// lowering" when a @test *calls* these seven functions directly — the callees
// are merged into one IR unit and the lowering crashes. A function-pointer cell
// is the barrier that keeps each check its own unit; the checks, their order and
// their report lines are unchanged. Reported, not papered over.

const RC_CHECK_NAMES: string[7] = [
  "integration: migration creates the ledger and the schema",
  "integration: insert binds args and adopts the key",
  "integration: query builds the statement and binds in order",
  "integration: changeset yields a two-field update",
  "integration: relation preloads in one exec for three owners",
  "integration: delete and a conflict leave no state",
  "integration: the failure matrix never reaches the store",
];

var RC_CHECKS: (fn() -> int32)[7];

export fn rc_checks_load() {
  RC_CHECKS[0] = &check_migration;
  RC_CHECKS[1] = &check_insert;
  RC_CHECKS[2] = &check_query;
  RC_CHECKS[3] = &check_changeset;
  RC_CHECKS[4] = &check_relations;
  RC_CHECKS[5] = &check_delete_and_conflict;
  RC_CHECKS[6] = &check_failure_matrix;
}

export fn main() -> int32 {
  rc_checks_load();
  var failures: int32 = 0;
  var i: int32 = 0;
  while (i < 7) {
    var run: fn() -> int32 = RC_CHECKS[i];
    if (!rc_report(RC_CHECK_NAMES[i], run())) { failures = failures + 1; }
    i = i + 1;
  }
  return rc_summary(failures, 7);
}

@test fn t_integration() -> int32 {
  return main();
}
