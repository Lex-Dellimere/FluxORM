// tests/t_relation.mettle — Phase 4: relations and the batch loader.
//
// The assertion that matters in this file is not the SQL text (though every
// statement is compared with `==` against a literal, never "contains"); it is
// the exec count. `rc_mem_call_count(a)` is the adapter's own counter, so
// "three owners, one statement" is measured at the seam instead of being
// inferred from the code.
//
//   1 / 1 / 2 / 0   has-many / belongs-to / through / no owners
//
// The double's row scripts are intentionally not constrained by primary-key
// uniqueness or by the foreign keys they carry: the mem adapter is the seam's
// executable spec, and grouping is a value comparison. A belongs-to group
// holding two rows with the same key proves that grouping does not depend on
// the store having deduplicated.

import "std/io";

import "../src/core/status";
import "../src/core/value";
import "../src/core/meta";
import "../src/adapter/adapter";
import "../src/adapter/mem";
import "../src/relation/relation";
import "../src/relation/load";
import "models";
import "harness";

// --- UserPost: the through table, declared here (models.mettle is frozen) ----
//
// Same `comptime for` shape as tests/models.mettle: the compiler reports the
// offsets, one override table records the two NOT NULL keys, one finalize call.
// No primary key: a mapping row is a pair, and the loader never selects it by
// key. The field *order* is the contract rc_relation_check enforces — field 0
// is the owner column, field 1 the target column — which is what lets the
// loader project `SELECT "user_id", "post_id"` without a column list.

export struct UserPost {
  user_id: int64;
  post_id: int64;
}

var USER_POST_FIELDS: RcField[2];
var USER_POST_META: RcMeta;
var USER_POST_READY: bool = false;

fn user_post_fields(out: RcField*) -> int32 {
  var i: int32 = 0;
  comptime for f in typeof(UserPost).fields {
    out[i].name = f.name;
    out[i].column = f.name;
    out[i].kind = f.type.kind;
    out[i].ty = rc_kind_type(f.type.kind);
    out[i].offset = (int32)f.offset;
    out[i].size = (int32)f.type.size;
    out[i].flags = 0;
    i = i + 1;
  }
  return i;
}

fn user_post_build() -> int32 {
  var i: int32 = user_post_fields(&USER_POST_FIELDS[0]);
  USER_POST_META.table = "user_posts";
  USER_POST_META.name = "UserPost";
  USER_POST_META.size = (int32)sizeof(UserPost);
  USER_POST_META.fields = &USER_POST_FIELDS[0];
  USER_POST_META.n_fields = i;
  USER_POST_META.pk = -1;
  USER_POST_FIELDS[0].flags = RC_F_NOT_NULL;
  USER_POST_FIELDS[1].flags = RC_F_NOT_NULL;
  return rc_meta_check(USER_POST_META, 0);
}

export fn user_post_meta() -> RcMeta {
  if (!USER_POST_READY) {
    user_post_build();
    USER_POST_READY = true;
  }
  return USER_POST_META;
}

// --- exact statements --------------------------------------------------------
// Every one of these is the whole statement. A substring assertion would let a
// quoting change through; `==` would not.

const POSTS_BY_USER_SQL3: string = "SELECT \"id\", \"user_id\", \"title\", \"body\", \"published_at\" FROM \"posts\" WHERE \"user_id\" IN (?, ?, ?)";
const POSTS_BY_PK_SQL3: string = "SELECT \"id\", \"user_id\", \"title\", \"body\", \"published_at\" FROM \"posts\" WHERE \"id\" IN (?, ?, ?)";
const USERS_BY_PK_SQL3: string = "SELECT \"id\", \"email\", \"name\", \"age\", \"active\", \"score\", \"created_at\", \"role\" FROM \"users\" WHERE \"id\" IN (?, ?, ?)";
const USERS_BY_PK_SQL2: string = "SELECT \"id\", \"email\", \"name\", \"age\", \"active\", \"score\", \"created_at\", \"role\" FROM \"users\" WHERE \"id\" IN (?, ?)";
const THROUGH_BY_OWNER_SQL3: string = "SELECT \"user_id\", \"post_id\" FROM \"user_posts\" WHERE \"user_id\" IN (?, ?, ?)";

fn new_adapter(out: RcAdapter**) -> int32 {
  var a: RcAdapter* = rc_mem_adapter();
  if (a == 0) { return RC_ERR_NOMEM; }
  if (rc_adapter_open(a, "mem://reach") != RC_OK) {
    rc_mem_free(a);
    return RC_ERR_ADAPTER;
  }
  *out = a;
  return RC_OK;
}

// The three relation declarations the tests use, in one place so a test cannot
// accidentally assert against a different shape than the one it loaded.
fn rel_posts() -> RcRelation {
  return rc_relation("posts", RC_REL_HAS_MANY, 0, "posts", 1);
}

fn rel_user() -> RcRelation {
  return rc_relation("user", RC_REL_BELONGS_TO, 1, "users", 0);
}

fn rel_post_tags() -> RcRelation {
  return rc_relation_through("posts", 0, "posts", 0, "user_posts", "user_id",
                             "post_id");
}

// --- 1. startup refuses bad metadata ----------------------------------------

// Every refusal is a declaration bug, so every one of them is refused here and
// not at query time. One wrong thing per case: the code is the diagnosis.
fn check_startup() -> int32 {
  var um: RcMeta = user_meta();
  var pm: RcMeta = post_meta();
  var tm: RcMeta = user_post_meta();
  if (rc_meta_check(tm, 0) != RC_OK) { return 1; }
  if (tm.n_fields != 2) { return 2; }
  if (tm.table != "user_posts") { return 3; }
  if (tm.fields[0].name != "user_id") { return 4; }
  if (tm.fields[1].name != "post_id") { return 5; }

  // The three shapes that must pass.
  var ok1: RcRelation = rel_posts();
  if (rc_relation_check(&ok1, um, pm, 0) != RC_OK) { return 6; }
  var ok2: RcRelation = rel_user();
  if (rc_relation_check(&ok2, pm, um, 0) != RC_OK) { return 7; }
  var ok3: RcRelation = rel_post_tags();
  if (rc_relation_check(&ok3, um, pm, &tm) != RC_OK) { return 8; }

  // No relation at all.
  if (rc_relation_check(0, um, pm, 0) != RC_ERR_USAGE) { return 9; }

  // Unknown kind.
  var bad_kind: RcRelation = rc_relation("posts", 9, 0, "posts", 1);
  if (rc_relation_check(&bad_kind, um, pm, 0) != RC_ERR_UNSUPPORTED) { return 10; }
  // Empty name.
  var no_name: RcRelation = rc_relation("", RC_REL_HAS_MANY, 0, "posts", 1);
  if (rc_relation_check(&no_name, um, pm, 0) != RC_ERR_USAGE) { return 11; }

  // local_field outside the owner table, on both ends.
  var local_hi: RcRelation = rc_relation("posts", RC_REL_HAS_MANY, 8, "posts", 1);
  if (rc_relation_check(&local_hi, um, pm, 0) != RC_ERR_USAGE) { return 12; }
  var local_lo: RcRelation = rc_relation("posts", RC_REL_HAS_MANY, -1, "posts", 1);
  if (rc_relation_check(&local_lo, um, pm, 0) != RC_ERR_USAGE) { return 13; }

  // Owner side key is not an int64 field ("email" is TEXT).
  var local_ty: RcRelation = rc_relation("posts", RC_REL_HAS_MANY, 1, "posts", 1);
  if (rc_relation_check(&local_ty, um, pm, 0) != RC_ERR_CAST) { return 14; }
  // Target side key is not an int64 field ("title" is TEXT).
  var foreign_ty: RcRelation = rc_relation("posts", RC_REL_HAS_MANY, 0, "posts", 2);
  if (rc_relation_check(&foreign_ty, um, pm, 0) != RC_ERR_CAST) { return 15; }

  // A foreign table that is not the target model's table.
  var wrong_table: RcRelation = rc_relation("posts", RC_REL_HAS_MANY, 0, "postz", 1);
  if (rc_relation_check(&wrong_table, um, pm, 0) != RC_ERR_USAGE) { return 16; }
  // HAS_MANY foreign field outside the target table.
  var foreign_hi: RcRelation = rc_relation("posts", RC_REL_HAS_MANY, 0, "posts", 5);
  if (rc_relation_check(&foreign_hi, um, pm, 0) != RC_ERR_USAGE) { return 17; }

  // BELONGS_TO must point at the target primary key, not just any int64 field
  // ("age" is int64 and is not the key).
  var not_pk: RcRelation = rc_relation("user", RC_REL_BELONGS_TO, 1, "users", 3);
  if (rc_relation_check(&not_pk, pm, um, 0) != RC_ERR_USAGE) { return 18; }

  // THROUGH: no metadata, wrong shape, wrong table, wrong column names,
  // non-int64 columns.
  if (rc_relation_check(&ok3, um, pm, 0) != RC_ERR_USAGE) { return 19; }
  if (rc_relation_check(&ok3, um, pm, &pm) != RC_ERR_USAGE) { return 20; }

  var swapped_table: RcMeta = tm;
  swapped_table.table = "other_posts";
  if (rc_relation_check(&ok3, um, pm, &swapped_table) != RC_ERR_USAGE) { return 21; }

  var swapped_fields: RcField[2];
  swapped_fields[0].name = "post_id";
  swapped_fields[0].column = "post_id";
  swapped_fields[0].kind = Kind.Int64;
  swapped_fields[0].ty = RC_T_I64;
  swapped_fields[0].offset = 0;
  swapped_fields[0].size = 8;
  swapped_fields[0].flags = RC_F_NOT_NULL;
  swapped_fields[1].name = "user_id";
  swapped_fields[1].column = "user_id";
  swapped_fields[1].kind = Kind.Int64;
  swapped_fields[1].ty = RC_T_I64;
  swapped_fields[1].offset = 8;
  swapped_fields[1].size = 8;
  swapped_fields[1].flags = RC_F_NOT_NULL;
  var swapped_meta: RcMeta;
  swapped_meta.table = "user_posts";
  swapped_meta.name = "Swapped";
  swapped_meta.size = 16;
  swapped_meta.fields = &swapped_fields[0];
  swapped_meta.n_fields = 2;
  swapped_meta.pk = -1;
  if (rc_relation_check(&ok3, um, pm, &swapped_meta) != RC_ERR_USAGE) { return 22; }

  var text_fields: RcField[2];
  text_fields[0].name = "user_id";
  text_fields[0].column = "user_id";
  text_fields[0].kind = Kind.Int64;
  text_fields[0].ty = RC_T_I64;
  text_fields[0].offset = 0;
  text_fields[0].size = 8;
  text_fields[0].flags = RC_F_NOT_NULL;
  text_fields[1].name = "post_id";
  text_fields[1].column = "post_id";
  text_fields[1].kind = Kind.String;
  text_fields[1].ty = RC_T_TEXT;
  text_fields[1].offset = 8;
  text_fields[1].size = 8;
  text_fields[1].flags = RC_F_NOT_NULL;
  var text_meta: RcMeta;
  text_meta.table = "user_posts";
  text_meta.name = "TextKey";
  text_meta.size = 16;
  text_meta.fields = &text_fields[0];
  text_meta.n_fields = 2;
  text_meta.pk = -1;
  if (rc_relation_check(&ok3, um, pm, &text_meta) != RC_ERR_USAGE) { return 23; }

  // A mapping table declared on a two-table relation: the author believes the
  // through table is used, the loader would ignore it.
  var stray_through: RcRelation = rel_post_tags();
  stray_through.kind = RC_REL_HAS_MANY;
  if (rc_relation_check(&stray_through, um, pm, &tm) != RC_ERR_USAGE) { return 24; }

  // HAS_MANY groups by the owner's local field, so a nullable local field is
  // refused (a NULL grouping key would silently drop owners).
  var nullable_fields: RcField[2];
  nullable_fields[0].name = "id";
  nullable_fields[0].column = "id";
  nullable_fields[0].kind = Kind.Int64;
  nullable_fields[0].ty = RC_T_I64;
  nullable_fields[0].offset = 0;
  nullable_fields[0].size = 8;
  nullable_fields[0].flags = 0;
  nullable_fields[1].name = "name";
  nullable_fields[1].column = "name";
  nullable_fields[1].kind = Kind.String;
  nullable_fields[1].ty = RC_T_TEXT;
  nullable_fields[1].offset = 8;
  nullable_fields[1].size = 16;
  nullable_fields[1].flags = 0;
  var nullable_meta: RcMeta;
  nullable_meta.table = "users";
  nullable_meta.name = "NullableOwner";
  nullable_meta.size = 24;
  nullable_meta.fields = &nullable_fields[0];
  nullable_meta.n_fields = 2;
  nullable_meta.pk = -1;
  var next_owner_ok: RcRelation = rc_relation("posts", RC_REL_HAS_MANY, 0, "posts", 1);
  if (rc_relation_check(&next_owner_ok, nullable_meta, pm, 0) != RC_ERR_USAGE) {
    return 25;
  }

  // The loader checks too: bad metadata runs no statement at all.
  var a: RcAdapter* = 0;
  if (new_adapter(&a) != RC_OK) { return 26; }
  defer rc_mem_free(a);
  var keys: RcValue[1];
  keys[0] = RcInt(7);
  var out: RcRelationResult;
  var bad: RcRelation = rc_relation("posts", RC_REL_HAS_MANY, 8, "posts", 1);
  if (rc_relation_load(a, &bad, um, pm, 0, &keys[0], 1, &out) != RC_ERR_USAGE) {
    return 27;
  }
  if (rc_mem_call_count(a) != 0) { return 28; }
  if (out.n_keys != 0) { return 29; }
  rc_relation_free(&out);
  return 0;
}

// --- 2. has-many: one exec for three owners ---------------------------------

fn check_has_many() -> int32 {
  var a: RcAdapter* = 0;
  if (new_adapter(&a) != RC_OK) { return 1; }
  defer rc_mem_free(a);

  // Three posts, two for user 7, none for user 9, one for user 11.
  var rows: RcValue[15];
  rows[0] = RcInt(1);
  rows[1] = RcInt(7);
  rows[2] = RcText("first");
  rows[3] = RcText("body-1");
  rows[4] = RcTime(10);
  rows[5] = RcInt(2);
  rows[6] = RcInt(7);
  rows[7] = RcText("second");
  rows[8] = RcNull;
  rows[9] = RcTime(11);
  rows[10] = RcInt(3);
  rows[11] = RcInt(11);
  rows[12] = RcText("third");
  rows[13] = RcText("body-3");
  rows[14] = RcTime(12);
  if (rc_mem_push_rows(a, &rows[0], 3, 5) != RC_OK) { return 2; }

  var um: RcMeta = user_meta();
  var pm: RcMeta = post_meta();
  var rel: RcRelation = rel_posts();
  var keys: RcValue[3];
  keys[0] = RcInt(7);
  keys[1] = RcInt(9);
  keys[2] = RcInt(11);

  var out: RcRelationResult;
  var rc: int32 = rc_relation_load(a, &rel, um, pm, 0, &keys[0], 3, &out);
  if (rc != RC_OK) { return 3; }
  defer rc_relation_free(&out);

  // The whole point: three owners, one statement.
  if (rc_mem_call_count(a) != 1) { return 4; }
  if (out.n_execs != 1) { return 5; }
  if (rc_mem_last_sql(a) != POSTS_BY_USER_SQL3) { return 6; }
  if (rc_mem_arg_count(a) != 3) { return 7; }
  var bound: RcValue* = rc_mem_last_args(a);
  if (!rc_value_same(bound[0], RcInt(7))) { return 8; }
  if (!rc_value_same(bound[1], RcInt(9))) { return 9; }
  if (!rc_value_same(bound[2], RcInt(11))) { return 10; }

  if (out.n_keys != 3) { return 11; }
  if (out.keys[0] != 7) { return 12; }
  if (out.keys[1] != 9) { return 13; }
  if (out.keys[2] != 11) { return 14; }
  if (out.res.n_rows != 3) { return 15; }
  if (rc_relation_group(&out, 9) != 1) { return 16; }
  if (rc_relation_group(&out, 8) != -1) { return 17; }

  // 2 / 0 / 1 across the three keys.
  if (rc_relation_count(&out, 0) != 2) { return 18; }
  if (rc_relation_count(&out, 1) != 0) { return 19; }
  if (rc_relation_count(&out, 2) != 1) { return 20; }
  if (rc_relation_count(&out, 3) != -1) { return 21; }
  if (rc_relation_count(&out, -1) != -1) { return 22; }

  // off is n_keys + 1 and ascending; group 0 is res rows 0 and 1, group 2 is
  // res row 2, and the row for key 11 is not reachable from group 1.
  if (out.off[0] != 0) { return 23; }
  if (out.off[1] != 2) { return 24; }
  if (out.off[2] != 2) { return 25; }
  if (out.off[3] != 3) { return 26; }
  if (out.idx[0] != 0) { return 27; }
  if (out.idx[1] != 1) { return 28; }
  if (out.idx[2] != 2) { return 29; }
  return 0;
}

// --- 3. belongs-to: the owner key dedupes into the target key ----------------

fn check_belongs_to() -> int32 {
  var a: RcAdapter* = 0;
  if (new_adapter(&a) != RC_OK) { return 1; }
  defer rc_mem_free(a);

  // Two rows with id 7 on purpose: grouping is a value comparison, so a group
  // can hold every row the store returned for that key.
  var rows: RcValue[24];
  rows[0] = RcInt(7);
  rows[1] = RcText("a@example.com");
  rows[2] = RcText("A");
  rows[3] = RcInt(30);
  rows[4] = RcBool(true);
  rows[5] = RcFloat(1.5);
  rows[6] = RcTime(100);
  rows[7] = RcInt(2);
  rows[8] = RcInt(7);
  rows[9] = RcText("b@example.com");
  rows[10] = RcText("B");
  rows[11] = RcInt(31);
  rows[12] = RcBool(true);
  rows[13] = RcFloat(2.5);
  rows[14] = RcTime(101);
  rows[15] = RcInt(2);
  rows[16] = RcInt(9);
  rows[17] = RcText("c@example.com");
  rows[18] = RcText("C");
  rows[19] = RcInt(32);
  rows[20] = RcBool(false);
  rows[21] = RcFloat(3.5);
  rows[22] = RcTime(102);
  rows[23] = RcInt(1);
  if (rc_mem_push_rows(a, &rows[0], 3, 8) != RC_OK) { return 2; }

  var pm: RcMeta = post_meta();
  var um: RcMeta = user_meta();
  var rel: RcRelation = rel_user();

  // Three owners, one of them repeated: the IN list is two keys wide, because
  // BELONGS_TO binds the *target* key (the owner's foreign key value), and the
  // duplicate collapses.
  var keys: RcValue[3];
  keys[0] = RcInt(7);
  keys[1] = RcInt(9);
  keys[2] = RcInt(7);

  var out: RcRelationResult;
  var rc: int32 = rc_relation_load(a, &rel, pm, um, 0, &keys[0], 3, &out);
  if (rc != RC_OK) { return 3; }
  defer rc_relation_free(&out);

  if (rc_mem_call_count(a) != 1) { return 4; }
  if (out.n_execs != 1) { return 5; }
  if (rc_mem_last_sql(a) != USERS_BY_PK_SQL2) { return 6; }
  if (rc_mem_arg_count(a) != 2) { return 7; }
  var bound: RcValue* = rc_mem_last_args(a);
  if (!rc_value_same(bound[0], RcInt(7))) { return 8; }
  if (!rc_value_same(bound[1], RcInt(9))) { return 9; }

  if (out.n_keys != 2) { return 10; }
  if (out.keys[0] != 7) { return 11; }
  if (out.keys[1] != 9) { return 12; }
  // Group 7 holds both rows the statement returned for key 7.
  if (rc_relation_count(&out, 0) != 2) { return 13; }
  if (rc_relation_count(&out, 1) != 1) { return 14; }
  if (out.off[1] != 2) { return 15; }
  if (out.idx[0] != 0) { return 16; }
  if (out.idx[1] != 1) { return 17; }
  if (out.idx[2] != 2) { return 18; }

  // The three-distinct-key shape, so the exact three-placeholder statement the
  // directive pins is also asserted (a second statement, still one exec).
  if (rc_mem_push_ok(a, 0, 0) != RC_OK) { return 19; }
  var keys3: RcValue[3];
  keys3[0] = RcInt(7);
  keys3[1] = RcInt(9);
  keys3[2] = RcInt(11);
  var out3: RcRelationResult;
  rc = rc_relation_load(a, &rel, pm, um, 0, &keys3[0], 3, &out3);
  if (rc != RC_OK) { return 20; }
  defer rc_relation_free(&out3);
  if (out3.n_execs != 1) { return 21; }
  if (run_sql_is(a, USERS_BY_PK_SQL3) != true) { return 22; }
  if (rc_mem_arg_count(a) != 3) { return 23; }
  if (rc_mem_call_count(a) != 2) { return 24; }
  if (out3.res.n_rows != 0) { return 25; }
  if (rc_relation_count(&out3, 0) != 0) { return 26; }
  return 0;
}

// Thin named predicate so an `==` on a borrowed string reads as one check.
fn run_sql_is(a: RcAdapter*, want: string) -> bool {
  if (rc_mem_last_sql(a) != want) { return false; }
  return true;
}

// --- 4. through: two statements, and a row shared by two groups -------------

fn check_through() -> int32 {
  var um: RcMeta = user_meta();
  var pm: RcMeta = post_meta();
  var tm: RcMeta = user_post_meta();
  var rel: RcRelation = rel_post_tags();
  var keys: RcValue[3];
  keys[0] = RcInt(7);
  keys[1] = RcInt(9);
  keys[2] = RcInt(11);

  // 4a. An empty mapping table: the first statement is the *only* statement,
  // and this is where the mapping SQL is read back exactly (the adapter keeps
  // only the last statement, and there is no last-but-one).
  var a1: RcAdapter* = 0;
  if (new_adapter(&a1) != RC_OK) { return 1; }
  defer rc_mem_free(a1);
  var out1: RcRelationResult;
  var rc: int32 = rc_relation_load(a1, &rel, um, pm, &tm, &keys[0], 3, &out1);
  if (rc != RC_OK) { return 2; }
  defer rc_relation_free(&out1);
  if (rc_mem_call_count(a1) != 1) { return 3; }
  if (out1.n_execs != 1) { return 4; }
  if (rc_mem_last_sql(a1) != THROUGH_BY_OWNER_SQL3) { return 5; }
  if (rc_mem_arg_count(a1) != 3) { return 6; }
  var bound: RcValue* = rc_mem_last_args(a1);
  if (!rc_value_same(bound[0], RcInt(7))) { return 7; }
  if (!rc_value_same(bound[1], RcInt(9))) { return 8; }
  if (!rc_value_same(bound[2], RcInt(11))) { return 9; }
  if (out1.n_keys != 3) { return 10; }
  if (out1.through.n_rows != 0) { return 11; }
  if (out1.res.n_rows != 0) { return 12; }
  if (rc_relation_count(&out1, 0) != 0) { return 13; }
  if (rc_relation_count(&out1, 2) != 0) { return 14; }

  // 4b. The real shape. Mapping rows: 7 -> {100, 101}, 9 -> {101}, 11 -> {102}.
  // Post 101 is shared by owners 7 and 9, so the same res row index appears in
  // two groups.
  var a: RcAdapter* = 0;
  if (new_adapter(&a) != RC_OK) { return 15; }
  defer rc_mem_free(a);

  var map_rows: RcValue[8];
  map_rows[0] = RcInt(7);
  map_rows[1] = RcInt(100);
  map_rows[2] = RcInt(7);
  map_rows[3] = RcInt(101);
  map_rows[4] = RcInt(9);
  map_rows[5] = RcInt(101);
  map_rows[6] = RcInt(11);
  map_rows[7] = RcInt(102);
  if (rc_mem_push_rows(a, &map_rows[0], 4, 2) != RC_OK) { return 16; }

  var post_rows: RcValue[15];
  post_rows[0] = RcInt(100);
  post_rows[1] = RcInt(7);
  post_rows[2] = RcText("p100");
  post_rows[3] = RcText("b100");
  post_rows[4] = RcTime(20);
  post_rows[5] = RcInt(101);
  post_rows[6] = RcInt(7);
  post_rows[7] = RcText("p101");
  post_rows[8] = RcNull;
  post_rows[9] = RcTime(21);
  post_rows[10] = RcInt(102);
  post_rows[11] = RcInt(11);
  post_rows[12] = RcText("p102");
  post_rows[13] = RcText("b102");
  post_rows[14] = RcTime(22);
  if (rc_mem_push_rows(a, &post_rows[0], 3, 5) != RC_OK) { return 17; }

  var out: RcRelationResult;
  rc = rc_relation_load(a, &rel, um, pm, &tm, &keys[0], 3, &out);
  if (rc != RC_OK) { return 18; }
  defer rc_relation_free(&out);

  if (rc_mem_call_count(a) != 2) { return 19; }
  if (out.n_execs != 2) { return 20; }
  if (rc_mem_last_sql(a) != POSTS_BY_PK_SQL3) { return 21; }
  // The second IN list is the deduped target keys: three, not four.
  if (rc_mem_arg_count(a) != 3) { return 22; }
  if (out.through.n_rows != 4) { return 23; }
  if (out.res.n_rows != 3) { return 24; }
  if (out.n_keys != 3) { return 25; }

  // 7 -> {100, 101} (res rows 0, 1); 9 -> {101} (res row 1); 11 -> {102}.
  if (rc_relation_count(&out, 0) != 2) { return 26; }
  if (rc_relation_count(&out, 1) != 1) { return 27; }
  if (rc_relation_count(&out, 2) != 1) { return 28; }
  if (out.off[1] != 2) { return 29; }
  if (out.off[2] != 3) { return 30; }
  if (out.off[3] != 4) { return 31; }
  if (out.idx[0] != 0) { return 32; }
  if (out.idx[1] != 1) { return 33; }
  // The share: group 9's only row is the same res row group 7 already holds.
  if (out.idx[2] != 1) { return 34; }
  if (out.idx[2] != out.idx[1]) { return 35; }
  if (out.idx[3] != 2) { return 36; }
  return 0;
}

// --- 5. no owners means no statement ----------------------------------------

fn check_no_owners() -> int32 {
  var a: RcAdapter* = 0;
  if (new_adapter(&a) != RC_OK) { return 1; }
  defer rc_mem_free(a);

  var um: RcMeta = user_meta();
  var pm: RcMeta = post_meta();
  var tm: RcMeta = user_post_meta();
  var rel: RcRelation = rel_posts();

  // All-NULL key array.
  var nulls: RcValue[2];
  nulls[0] = RcNull;
  nulls[1] = RcNull;
  var out: RcRelationResult;
  var rc: int32 = rc_relation_load(a, &rel, um, pm, 0, &nulls[0], 2, &out);
  if (rc != RC_OK) { return 2; }
  defer rc_relation_free(&out);
  if (out.n_keys != 0) { return 3; }
  if (out.n_execs != 0) { return 4; }
  if (out.keys != 0) { return 5; }
  if (out.off != 0) { return 6; }
  if (rc_mem_call_count(a) != 0) { return 7; }

  // Zero-length key array.
  var out0: RcRelationResult;
  rc = rc_relation_load(a, &rel, um, pm, 0, 0, 0, &out0);
  if (rc != RC_OK) { return 8; }
  rc_relation_free(&out0);
  if (out0.n_keys != 0) { return 9; }
  if (out0.n_execs != 0) { return 10; }
  if (rc_mem_call_count(a) != 0) { return 11; }

  // The same rule for the through shape: no owner keys, no mapping statement.
  var through_rel: RcRelation = rel_post_tags();
  var outt: RcRelationResult;
  rc = rc_relation_load(a, &through_rel, um, pm, &tm, &nulls[0], 2, &outt);
  if (rc != RC_OK) { return 12; }
  rc_relation_free(&outt);
  if (outt.n_execs != 0) { return 13; }
  if (rc_mem_call_count(a) != 0) { return 14; }

  // A key that is not an int64 is a cast error before any statement.
  var bad: RcValue[1];
  bad[0] = RcText("7");
  var outb: RcRelationResult;
  rc = rc_relation_load(a, &rel, um, pm, 0, &bad[0], 1, &outb);
  if (rc != RC_ERR_CAST) { return 15; }
  rc_relation_free(&outb);
  if (outb.n_keys != 0) { return 16; }
  if (rc_mem_call_count(a) != 0) { return 17; }

  // A NULL key next to a real one is skipped, not bound: one statement, one
  // placeholder.
  var mixed: RcValue[2];
  mixed[0] = RcNull;
  mixed[1] = RcInt(7);
  if (rc_mem_push_rows(a, 0, 0, 0) != RC_OK) { return 18; }
  var outm: RcRelationResult;
  rc = rc_relation_load(a, &rel, um, pm, 0, &mixed[0], 2, &outm);
  if (rc != RC_OK) { return 19; }
  defer rc_relation_free(&outm);
  if (outm.n_keys != 1) { return 20; }
  if (outm.n_execs != 1) { return 21; }
  if (rc_mem_call_count(a) != 1) { return 22; }
  if (rc_mem_arg_count(a) != 1) { return 23; }
  if (!rc_value_same(rc_mem_last_args(a)[0], RcInt(7))) { return 24; }
  return 0;
}

// --- 6. hydrate borrows the result ------------------------------------------

fn check_hydrate() -> int32 {
  var a: RcAdapter* = 0;
  if (new_adapter(&a) != RC_OK) { return 1; }
  defer rc_mem_free(a);

  var rows: RcValue[10];
  rows[0] = RcInt(1);
  rows[1] = RcInt(7);
  rows[2] = RcText("first");
  rows[3] = RcText("body-1");
  rows[4] = RcTime(10);
  rows[5] = RcInt(2);
  rows[6] = RcInt(7);
  rows[7] = RcText("second");
  rows[8] = RcNull;
  rows[9] = RcTime(11);
  if (rc_mem_push_rows(a, &rows[0], 2, 5) != RC_OK) { return 2; }

  var um: RcMeta = user_meta();
  var pm: RcMeta = post_meta();
  var rel: RcRelation = rel_posts();
  var keys: RcValue[1];
  keys[0] = RcInt(7);
  var out: RcRelationResult;
  var rc: int32 = rc_relation_load(a, &rel, um, pm, 0, &keys[0], 1, &out);
  if (rc != RC_OK) { return 3; }
  defer rc_relation_free(&out);

  var p: Post;
  var nulls: uint64 = 0;
  rc = rc_relation_hydrate(&out, 0, 0, (rawptr)&p, &nulls);
  if (rc != RC_OK) { return 4; }
  if (p.id != 1) { return 5; }
  if (p.user_id != 7) { return 6; }
  if (p.title != "first") { return 7; }
  if (p.body != "body-1") { return 8; }
  if (rc_nulls_has(nulls, 2)) { return 9; }
  if (rc_nulls_has(nulls, 3)) { return 10; }

  // Borrowed, not copied: the model's title points at the same bytes as the
  // result cell, and the value is still readable through both.
  var cell: RcValue = rc_result_borrow(&out.res, out.idx[0], 2);
  var s: string;
  if (rc_value_as_text(cell, &s) != RC_OK) { return 11; }
  if (p.title.chars != s.chars) { return 12; }
  if (p.title.length != s.length) { return 13; }
  if (s != "first") { return 14; }

  // A NULL cell sets the null bit and leaves the storage zeroed.
  var p2: Post;
  var nulls2: uint64 = 0;
  rc = rc_relation_hydrate(&out, 0, 1, (rawptr)&p2, &nulls2);
  if (rc != RC_OK) { return 15; }
  if (!rc_nulls_has(nulls2, 3)) { return 16; }
  if (p2.title != "second") { return 17; }

  // Out of range: group, entry.
  var dummy: Post;
  var dn: uint64 = 0;
  if (rc_relation_hydrate(&out, 1, 0, (rawptr)&dummy, &dn) != RC_ERR_USAGE) {
    return 18;
  }
  if (rc_relation_hydrate(&out, -1, 0, (rawptr)&dummy, &dn) != RC_ERR_USAGE) {
    return 19;
  }
  if (rc_relation_hydrate(&out, 0, 2, (rawptr)&dummy, &dn) != RC_ERR_USAGE) {
    return 20;
  }
  if (rc_relation_hydrate(&out, 0, -1, (rawptr)&dummy, &dn) != RC_ERR_USAGE) {
    return 21;
  }
  if (rc_relation_hydrate(0, 0, 0, (rawptr)&dummy, &dn) != RC_ERR_USAGE) {
    return 22;
  }

  // rc_meta_set's range check still applies to a hydrated cell: age 5000000000
  // does not fit an int32 field, and the loader does not bypass that.
  var urows: RcValue[8];
  urows[0] = RcInt(7);
  urows[1] = RcText("a@example.com");
  urows[2] = RcText("A");
  urows[3] = RcInt(5000000000);
  urows[4] = RcBool(true);
  urows[5] = RcFloat(1.5);
  urows[6] = RcTime(100);
  urows[7] = RcInt(2);
  if (rc_mem_push_rows(a, &urows[0], 1, 8) != RC_OK) { return 23; }

  var bel: RcRelation = rel_user();
  var bkeys: RcValue[1];
  bkeys[0] = RcInt(7);
  var out2: RcRelationResult;
  rc = rc_relation_load(a, &bel, pm, um, 0, &bkeys[0], 1, &out2);
  if (rc != RC_OK) { return 24; }
  defer rc_relation_free(&out2);
  var u: User;
  var un: uint64 = 0;
  if (rc_relation_hydrate(&out2, 0, 0, (rawptr)&u, &un) != RC_ERR_RANGE) {
    return 25;
  }
  // The zeroing happened before the failing field, so no stale null bits from
  // the caller's variable survive into the half-filled model.
  if (un != 0) { return 26; }
  return 0;
}

// --- 7. a failing exec changes nothing --------------------------------------

fn check_fail_exec() -> int32 {
  var a: RcAdapter* = 0;
  if (new_adapter(&a) != RC_OK) { return 1; }
  defer rc_mem_free(a);

  var um: RcMeta = user_meta();
  var pm: RcMeta = post_meta();
  var tm: RcMeta = user_post_meta();
  var rel: RcRelation = rel_posts();
  var keys: RcValue[3];
  keys[0] = RcInt(7);
  keys[1] = RcInt(9);
  keys[2] = RcInt(11);

  if (rc_mem_fail_next(a, RC_ERR_CONFLICT) != RC_OK) { return 2; }
  var out: RcRelationResult;
  var rc: int32 = rc_relation_load(a, &rel, um, pm, 0, &keys[0], 3, &out);
  if (rc != RC_ERR_CONFLICT) { return 3; }
  if (rc_mem_call_count(a) != 0) { return 4; }
  if (out.n_execs != 0) { return 5; }
  // Keys were resolved before the statement; that is what was decided.
  if (out.n_keys != 3) { return 6; }
  if (out.keys[0] != 7) { return 7; }
  if (out.keys[2] != 11) { return 8; }
  // No half-filled groups and no partial rows.
  if (out.idx != 0) { return 9; }
  if (out.off != 0) { return 10; }
  if (out.res.n_rows != 0) { return 11; }
  if (rc_relation_count(&out, 0) != -1) { return 12; }
  rc_relation_free(&out);
  if (out.n_keys != 0) { return 13; }
  if (out.keys != 0) { return 14; }

  // The through shape fails at its first statement: still no grouping, still
  // zero execs executed (the double fails before it records the call).
  var through_rel: RcRelation = rel_post_tags();
  if (rc_mem_fail_next(a, RC_ERR_TX) != RC_OK) { return 15; }
  var outt: RcRelationResult;
  rc = rc_relation_load(a, &through_rel, um, pm, &tm, &keys[0], 3, &outt);
  if (rc != RC_ERR_TX) { return 16; }
  if (rc_mem_call_count(a) != 0) { return 17; }
  if (outt.n_execs != 0) { return 18; }
  if (outt.through.n_rows != 0) { return 19; }
  if (outt.res.n_rows != 0) { return 20; }
  if (outt.idx != 0) { return 21; }
  if (outt.off != 0) { return 22; }
  rc_relation_free(&outt);
  return 0;
}

export fn main() -> int32 {
  var failures: int32 = 0;
  if (!rc_report("relation: startup check refuses bad metadata", check_startup())) { failures = failures + 1; }
  if (!rc_report("relation: has many is one exec for three owners", check_has_many())) { failures = failures + 1; }
  if (!rc_report("relation: belongs to dedupes keys", check_belongs_to())) { failures = failures + 1; }
  if (!rc_report("relation: through is two statements and shares rows", check_through())) { failures = failures + 1; }
  if (!rc_report("relation: no owners means no statement", check_no_owners())) { failures = failures + 1; }
  if (!rc_report("relation: hydrate borrows the result", check_hydrate())) { failures = failures + 1; }
  if (!rc_report("relation: a failing exec changes nothing", check_fail_exec())) { failures = failures + 1; }
  return rc_summary(failures, 7);
}

@test fn t_relation() -> int32 {
  if (check_startup() != 0) { return 1; }
  if (check_has_many() != 0) { return 2; }
  if (check_belongs_to() != 0) { return 3; }
  if (check_through() != 0) { return 4; }
  if (check_no_owners() != 0) { return 5; }
  if (check_hydrate() != 0) { return 6; }
  if (check_fail_exec() != 0) { return 7; }
  return 0;
}
