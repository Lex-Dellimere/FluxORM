// tests/models.mettle — the models the tests use, in the shape an app copies.
//
// A model is a plain struct, an override table for what a struct cannot say
// (column names, keys, NOT NULL, unique, timestamps, version), a field function
// with one `comptime for`, and a `*_meta()` that builds the metadata once
// (core/schema.mettle). Field names, offsets and types come from the compiler.

import "../src/core/status";
import "../src/core/value";
import "../src/core/meta";
import "../src/core/schema";

// --- User --------------------------------------------------------------------

export enum Role { Admin = 1, Member = 2 }

export struct User {
  id: int64;
  email: string;
  name: string;
  age: int32;
  active: bool;
  score: float64;
  created_at: int64;
  role: Role;
}

const USER_COLS: RcColumn[8] = [
  { index: 0, column: "id", ty: RC_T_I64, flags: RC_F_PK | RC_F_AUTO | RC_F_NOT_NULL },
  { index: 1, column: "email", ty: RC_T_TEXT, flags: RC_F_NOT_NULL | RC_F_UNIQUE },
  { index: 2, column: "name", ty: RC_T_TEXT, flags: RC_F_NOT_NULL },
  { index: 3, column: "age", ty: RC_T_I64, flags: 0 },
  { index: 4, column: "active", ty: RC_T_BOOL, flags: RC_F_NOT_NULL },
  { index: 5, column: "score", ty: RC_T_F64, flags: 0 },
  { index: 6, column: "created_at", ty: RC_T_TIME, flags: RC_F_TIMESTAMP | RC_F_NOT_NULL },
  { index: 7, column: "role", ty: RC_T_I64, flags: RC_F_NOT_NULL },
];

var USER: RcSchema;

fn user_fields(s: RcSchema*) {
  comptime for f in typeof(User).fields {
    rc_schema_field(s, f.name, f.type.kind, (int64)f.offset, (int64)f.type.size);
  }
}

export fn user_meta() -> RcMeta {
  return rc_schema_meta(&USER, &user_fields, "users", "User", (int64)sizeof(User),
                        &USER_COLS[0], 8);
}

export fn user_meta_status() -> int32 {
  user_meta();
  return rc_schema_status(&USER);
}

// --- Post --------------------------------------------------------------------

export struct Post {
  id: int64;
  user_id: int64;
  title: string;
  body: string;
  published_at: int64;
}

const POST_COLS: RcColumn[5] = [
  { index: 0, column: "id", ty: RC_T_I64, flags: RC_F_PK | RC_F_AUTO | RC_F_NOT_NULL },
  { index: 1, column: "user_id", ty: RC_T_I64, flags: RC_F_NOT_NULL },
  { index: 2, column: "title", ty: RC_T_TEXT, flags: RC_F_NOT_NULL },
  { index: 3, column: "body", ty: RC_T_TEXT, flags: 0 },
  { index: 4, column: "published_at", ty: RC_T_TIME, flags: RC_F_TIMESTAMP },
];

var POST: RcSchema;

fn post_fields(s: RcSchema*) {
  comptime for f in typeof(Post).fields {
    rc_schema_field(s, f.name, f.type.kind, (int64)f.offset, (int64)f.type.size);
  }
}

export fn post_meta() -> RcMeta {
  return rc_schema_meta(&POST, &post_fields, "posts", "Post", (int64)sizeof(Post),
                        &POST_COLS[0], 5);
}

export fn post_meta_status() -> int32 {
  post_meta();
  return rc_schema_status(&POST);
}

// --- Note: a versioned table (RC_F_VERSION) -----------------------------------

export struct Note {
  id: int64;
  text: string;
  version: int64;
}

const NOTE_COLS: RcColumn[3] = [
  { index: 0, column: "id", ty: RC_T_I64, flags: RC_F_PK | RC_F_AUTO | RC_F_NOT_NULL },
  { index: 1, column: "text", ty: RC_T_TEXT, flags: RC_F_NOT_NULL },
  { index: 2, column: "version", ty: RC_T_I64, flags: RC_F_VERSION | RC_F_NOT_NULL },
];

var NOTE: RcSchema;

fn note_fields(s: RcSchema*) {
  comptime for f in typeof(Note).fields {
    rc_schema_field(s, f.name, f.type.kind, (int64)f.offset, (int64)f.type.size);
  }
}

export fn note_meta() -> RcMeta {
  return rc_schema_meta(&NOTE, &note_fields, "notes", "Note", (int64)sizeof(Note),
                        &NOTE_COLS[0], 3);
}

export fn note_meta_status() -> int32 {
  note_meta();
  return rc_schema_status(&NOTE);
}

// --- Task: created/updated timestamps --------------------------------------

export struct Task {
  id: int64;
  title: string;
  created_at: int64;
  updated_at: int64;
}

const TASK_COLS: RcColumn[4] = [
  { index: 0, column: "id", ty: RC_T_I64, flags: RC_F_PK | RC_F_AUTO | RC_F_NOT_NULL },
  { index: 1, column: "title", ty: RC_T_TEXT, flags: RC_F_NOT_NULL },
  { index: 2, column: "created_at", ty: RC_T_TIME, flags: RC_F_CREATED | RC_F_NOT_NULL },
  { index: 3, column: "updated_at", ty: RC_T_TIME, flags: RC_F_UPDATED | RC_F_NOT_NULL },
];

var TASK: RcSchema;

fn task_fields(s: RcSchema*) {
  comptime for f in typeof(Task).fields {
    rc_schema_field(s, f.name, f.type.kind, (int64)f.offset, (int64)f.type.size);
  }
}

export fn task_meta() -> RcMeta {
  return rc_schema_meta(&TASK, &task_fields, "tasks", "Task", (int64)sizeof(Task),
                        &TASK_COLS[0], 4);
}

export fn task_meta_status() -> int32 {
  task_meta();
  return rc_schema_status(&TASK);
}

// A fixed clock for the timestamp tests.
export var TEST_NOW: int64 = 1700000000000000;
export fn test_clock() -> int64 { return TEST_NOW; }

// --- Doc: a field type the wire cannot carry --------------------------------
// `uint8[]` is a slice, kind Slice. MeoDB's record codec has a BLOB, but a
// Mettle slice is a (ptr,len) view with no owner, so mapping it silently would
// be a lifetime bug. The metadata validator must refuse it at startup.

export struct Doc {
  id: int64;
  attachment: uint8[];
}

const DOC_COLS: RcColumn[1] = [
  { index: 0, column: "id", ty: RC_T_I64, flags: RC_F_PK | RC_F_NOT_NULL },
];

var DOC: RcSchema;

fn doc_fields(s: RcSchema*) {
  comptime for f in typeof(Doc).fields {
    rc_schema_field(s, f.name, f.type.kind, (int64)f.offset, (int64)f.type.size);
  }
}

export fn doc_meta() -> RcMeta {
  return rc_schema_meta(&DOC, &doc_fields, "docs", "Doc", (int64)sizeof(Doc),
                        &DOC_COLS[0], 1);
}

export fn doc_meta_status() -> int32 {
  doc_meta();
  return rc_schema_status(&DOC);
}

export fn doc_field_count() -> int32 { return doc_meta().n_fields; }
