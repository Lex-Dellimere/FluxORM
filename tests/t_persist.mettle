// tests/t_persist.mettle — core + adapter, together.
//
// A real model, generated metadata, the write path, and the adapter boundary. The statement text is asserted
// exactly, because "close enough SQL" is how an ORM ends up quoting an
// identifier with user data in it.

import "std/io";
import "std/mem";

import "../src/core/status";
import "../src/core/value";
import "../src/core/meta";
import "../src/core/entity";
import "../src/core/persist";
import "../src/adapter/adapter";
import "../src/adapter/mem";
import "models";
import "harness";

const INSERT_SQL: string = "INSERT INTO \"users\" (\"email\", \"name\", \"age\", \"active\", \"score\", \"created_at\", \"role\") VALUES (?, ?, ?, ?, ?, ?, ?)";
const SELECT_SQL: string = "SELECT \"id\", \"email\", \"name\", \"age\", \"active\", \"score\", \"created_at\", \"role\" FROM \"users\" WHERE \"id\" = ? LIMIT 1";
const DELETE_SQL: string = "DELETE FROM \"users\" WHERE \"id\" = ?";

fn new_adapter(out: RcAdapter**) -> int32 {
  var a: RcAdapter* = rc_mem_adapter();
  if (a == 0) { return RC_ERR_NOMEM; }
  if (rc_adapter_open(a, "mem://flux_orm") != RC_OK) {
    rc_mem_free(a);
    return RC_ERR_ADAPTER;
  }
  *out = a;
  return RC_OK;
}

fn check_insert() -> int32 {
  var a: RcAdapter* = 0;
  if (new_adapter(&a) != RC_OK) { return 1; }
  defer rc_mem_free(a);

  var m: RcMeta = user_meta();
  var u: User;
  memset((rawptr)&u, 0, (int64)sizeof(User));
  var e: RcEntity = rc_entity_new(m, (rawptr)&u);

  if (rc_entity_set(&e, 1, RcText("ada@example.com")) != RC_OK) { return 2; }
  if (rc_entity_set(&e, 2, RcText("Ada")) != RC_OK) { return 3; }
  if (rc_entity_set(&e, 3, RcNull) != RC_OK) { return 4; }   // nullable age
  if (rc_entity_set(&e, 4, RcBool(true)) != RC_OK) { return 5; }
  if (rc_entity_set(&e, 5, RcFloat(9.5)) != RC_OK) { return 6; }
  if (rc_entity_set(&e, 6, RcTime(1700000000000000)) != RC_OK) { return 7; }
  if (rc_entity_set(&e, 7, RcInt(2)) != RC_OK) { return 8; }

  if (rc_mem_push_ok(a, 1, 42) != RC_OK) { return 9; }
  if (rc_persist_insert(a, &e) != RC_OK) { return 10; }

  // The auto key is omitted, the other columns keep declaration order.
  if (rc_mem_last_sql(a) != INSERT_SQL) { return 11; }
  if (rc_mem_call_count(a) != 1) { return 12; }
  if (rc_mem_arg_count(a) != 7) { return 13; }
  var args: RcValue* = rc_mem_last_args(a);
  if (!rc_value_same(args[0], RcText("ada@example.com"))) { return 14; }
  if (!rc_value_same(args[1], RcText("Ada"))) { return 15; }
  if (!rc_value_is_null(args[2])) { return 16; }
  if (!rc_value_same(args[3], RcBool(true))) { return 17; }
  if (!rc_value_same(args[4], RcFloat(9.5))) { return 18; }
  if (!rc_value_same(args[5], RcTime(1700000000000000))) { return 19; }
  if (!rc_value_same(args[6], RcInt(2))) { return 20; }

  // The key came back and the entity is now in the store.
  if (u.id != 42) { return 21; }
  if (e.state != RC_ST_CLEAN) { return 22; }
  if (rc_nulls_has(e.nulls, 0)) { return 23; }
  if (!rc_value_same(rc_entity_pk(&e), RcInt(42))) { return 24; }

  // Inserting a non-new entity is a caller bug, not a second row.
  if (rc_persist_insert(a, &e) != RC_ERR_USAGE) { return 25; }
  if (rc_mem_call_count(a) != 1) { return 26; }
  return 0;
}

fn check_insert_explicit_key() -> int32 {
  var a: RcAdapter* = 0;
  if (new_adapter(&a) != RC_OK) { return 1; }
  defer rc_mem_free(a);

  var m: RcMeta = user_meta();
  var u: User;
  memset((rawptr)&u, 0, (int64)sizeof(User));
  var e: RcEntity = rc_entity_new(m, (rawptr)&u);
  if (rc_entity_set(&e, 0, RcInt(7)) != RC_OK) { return 2; }
  if (rc_entity_set(&e, 1, RcText("b@example.com")) != RC_OK) { return 3; }
  if (rc_entity_set(&e, 2, RcText("Bob")) != RC_OK) { return 4; }
  if (rc_entity_set(&e, 4, RcBool(false)) != RC_OK) { return 5; }
  if (rc_entity_set(&e, 6, RcTime(1)) != RC_OK) { return 6; }
  if (rc_entity_set(&e, 7, RcInt(1)) != RC_OK) { return 7; }

  if (rc_mem_push_ok(a, 1, 0) != RC_OK) { return 8; }
  if (rc_persist_insert(a, &e) != RC_OK) { return 9; }

  // An explicit key is written; only the auto-assigned one is omitted.
  if (rc_mem_arg_count(a) != 8) { return 10; }
  if (rc_mem_last_sql(a) != "INSERT INTO \"users\" (\"id\", \"email\", \"name\", \"age\", \"active\", \"score\", \"created_at\", \"role\") VALUES (?, ?, ?, ?, ?, ?, ?, ?)") {
    return 11;
  }
  if (!rc_value_same(rc_mem_last_args(a)[0], RcInt(7))) { return 12; }
  if (u.id != 7) { return 13; }
  if (e.state != RC_ST_CLEAN) { return 14; }
  return 0;
}

fn check_load() -> int32 {
  var a: RcAdapter* = 0;
  if (new_adapter(&a) != RC_OK) { return 1; }
  defer rc_mem_free(a);

  var m: RcMeta = user_meta();
  var row: RcValue[8];
  row[0] = RcInt(42);
  row[1] = RcText("ada@example.com");
  row[2] = RcText("Ada");
  row[3] = RcNull;                       // nullable age stays null
  row[4] = RcBool(true);
  row[5] = RcFloat(9.5);
  row[6] = RcTime(1700000000000000);
  row[7] = RcInt(2);
  if (rc_mem_push_rows(a, &row[0], 1, 8) != RC_OK) { return 2; }

  var u: User;
  memset((rawptr)&u, 0, (int64)sizeof(User));
  var nulls: uint64 = 0;
  var owner: RcResult;
  if (rc_persist_load(a, m, RcInt(42), (rawptr)&u, &nulls, &owner) != RC_OK) { return 3; }

  if (rc_mem_last_sql(a) != SELECT_SQL) { return 4; }
  if (rc_mem_arg_count(a) != 1) { return 5; }
  if (!rc_value_same(rc_mem_last_args(a)[0], RcInt(42))) { return 6; }

  if (u.id != 42) { return 7; }
  if (u.email != "ada@example.com") { return 8; }
  if (u.name != "Ada") { return 9; }
  if (u.age != 0) { return 10; }
  if (!u.active) { return 11; }
  if (u.score != 9.5) { return 12; }
  if (u.created_at != 1700000000000000) { return 13; }
  if (!rc_nulls_has(nulls, 3)) { return 14; }
  if (rc_nulls_has(nulls, 1)) { return 15; }

  // A row that is not there is NOT_FOUND, not a zero-valued model.
  var absent: RcResult;
  if (rc_persist_load(a, m, RcInt(999), (rawptr)&u, &nulls, &absent) != RC_ERR_NOT_FOUND) {
    return 16;
  }
  rc_result_free(&absent);

  // A store that returns the wrong column count is an adapter fault, and it is
  // caught rather than silently shifted into the struct.
  row[0] = RcInt(1);
  if (rc_mem_push_rows(a, &row[0], 1, 3) != RC_OK) { return 17; }
  var short_row: RcResult;
  if (rc_persist_load(a, m, RcInt(1), (rawptr)&u, &nulls, &short_row) != RC_ERR_ADAPTER) {
    return 18;
  }
  rc_result_free(&short_row);

  // The last use of the borrowed text, then the owner goes away.
  if (u.email != "ada@example.com") { return 19; }
  rc_result_free(&owner);
  return 0;
}

fn check_delete() -> int32 {
  var a: RcAdapter* = 0;
  if (new_adapter(&a) != RC_OK) { return 1; }
  defer rc_mem_free(a);

  var m: RcMeta = user_meta();
  var u: User;
  memset((rawptr)&u, 0, (int64)sizeof(User));
  var e: RcEntity = rc_entity_new(m, (rawptr)&u);
  if (rc_entity_set(&e, 0, RcInt(42)) != RC_OK) { return 2; }
  e.state = RC_ST_CLEAN;

  if (rc_mem_push_ok(a, 1, 0) != RC_OK) { return 3; }
  if (rc_persist_delete(a, &e) != RC_OK) { return 4; }
  if (rc_mem_last_sql(a) != DELETE_SQL) { return 5; }
  if (rc_mem_arg_count(a) != 1) { return 6; }
  if (!rc_value_same(rc_mem_last_args(a)[0], RcInt(42))) { return 7; }
  if (e.state != RC_ST_DELETED) { return 8; }

  // Deleting twice is refused before it reaches the store.
  if (rc_persist_delete(a, &e) != RC_ERR_USAGE) { return 9; }
  if (rc_mem_call_count(a) != 1) { return 10; }

  // Deleting a row that was never stored has no key to bind.
  var u2: User;
  memset((rawptr)&u2, 0, (int64)sizeof(User));
  var e2: RcEntity = rc_entity_new(m, (rawptr)&u2);
  if (rc_persist_delete(a, &e2) != RC_ERR_USAGE) { return 11; }
  if (rc_mem_call_count(a) != 1) { return 12; }
  return 0;
}

fn check_insert_conflict_keeps_state() -> int32 {
  var a: RcAdapter* = 0;
  if (new_adapter(&a) != RC_OK) { return 1; }
  defer rc_mem_free(a);

  var m: RcMeta = user_meta();
  var u: User;
  memset((rawptr)&u, 0, (int64)sizeof(User));
  var e: RcEntity = rc_entity_new(m, (rawptr)&u);
  if (rc_entity_set(&e, 1, RcText("dup@example.com")) != RC_OK) { return 2; }
  if (rc_entity_set(&e, 2, RcText("Dup")) != RC_OK) { return 3; }
  if (rc_entity_set(&e, 4, RcBool(true)) != RC_OK) { return 4; }
  if (rc_entity_set(&e, 6, RcTime(5)) != RC_OK) { return 5; }
  if (rc_entity_set(&e, 7, RcInt(2)) != RC_OK) { return 6; }

  if (rc_mem_fail_next(a, RC_ERR_CONFLICT) != RC_OK) { return 7; }
  if (rc_persist_insert(a, &e) != RC_ERR_CONFLICT) { return 8; }
  // Nothing about the entity changed: still new, still keyless.
  if (e.state != RC_ST_NEW) { return 9; }
  if (rc_entity_has_pk(&e)) { return 10; }
  if (u.id != 0) { return 11; }
  var kept: RcValue = RcNull;
  if (rc_entity_get(&e, 1, &kept) != RC_OK) { return 12; }
  if (!rc_value_same(kept, RcText("dup@example.com"))) { return 21; }

  // The retry is a fresh statement and succeeds.
  if (rc_mem_push_ok(a, 1, 77) != RC_OK) { return 13; }
  if (rc_persist_insert(a, &e) != RC_OK) { return 14; }
  if (u.id != 77) { return 15; }
  if (e.state != RC_ST_CLEAN) { return 16; }

  // A table with a field the wire cannot carry never reaches the store.
  var dm: RcMeta = doc_meta();
  var d: Doc;
  memset((rawptr)&d, 0, (int64)sizeof(Doc));
  var de: RcEntity = rc_entity_new(dm, (rawptr)&d);
  if (rc_entity_set(&de, 0, RcInt(1)) != RC_OK) { return 17; }
  var before: int32 = rc_mem_call_count(a);
  if (rc_persist_insert(a, &de) != RC_ERR_UNSUPPORTED) { return 18; }
  if (rc_mem_call_count(a) != before) { return 19; }
  return 0;
}

fn check_versioned() -> int32 {
  var a: RcAdapter* = 0;
  if (new_adapter(&a) != RC_OK) { return 1; }
  defer rc_mem_free(a);
  var m: RcMeta = note_meta();

  // Insert writes version 1, whatever the model held.
  var n: Note;
  memset((rawptr)&n, 0, (int64)sizeof(Note));
  n.version = 9;
  var e: RcEntity = rc_entity_new(m, (rawptr)&n);
  if (rc_entity_set(&e, 1, RcText("hi")) != RC_OK) { return 2; }
  if (rc_mem_push_ok(a, 1, 5) != RC_OK) { return 3; }
  if (rc_persist_insert(a, &e) != RC_OK) { return 4; }
  if (rc_mem_last_sql(a) != "INSERT INTO \"notes\" (\"text\", \"version\") VALUES (?, ?)") { return 5; }
  if (!rc_value_same(rc_mem_last_args(a)[1], RcInt(1))) { return 6; }
  if (n.version != 1) { return 7; }

  // Delete matches the version too; a moved-on row is kept.
  var del: string = "DELETE FROM \"notes\" WHERE \"id\" = ? AND \"version\" = ?";
  if (rc_mem_push_ok(a, 0, 0) != RC_OK) { return 8; }
  if (rc_persist_delete(a, &e) != RC_ERR_CONFLICT) { return 9; }
  if (rc_mem_last_sql(a) != del) { return 10; }
  if (!rc_value_same(rc_mem_last_args(a)[0], RcInt(5))) { return 11; }
  if (!rc_value_same(rc_mem_last_args(a)[1], RcInt(1))) { return 12; }
  if (e.state != RC_ST_CLEAN) { return 13; }
  if (rc_mem_push_ok(a, 1, 0) != RC_OK) { return 14; }
  if (rc_persist_delete(a, &e) != RC_OK) { return 15; }
  if (e.state != RC_ST_DELETED) { return 16; }
  return 0;
}

export fn main() -> int32 {
  var failures: int32 = 0;
  if (!rc_report("persist: insert builds args and takes the key", check_insert())) { failures = failures + 1; }
  if (!rc_report("persist: an explicit key is written", check_insert_explicit_key())) { failures = failures + 1; }
  if (!rc_report("persist: load sets fields and nulls", check_load())) { failures = failures + 1; }
  if (!rc_report("persist: delete binds the key once", check_delete())) { failures = failures + 1; }
  if (!rc_report("persist: conflict keeps entity state", check_insert_conflict_keeps_state())) { failures = failures + 1; }
  if (!rc_report("persist: versioned insert and delete", check_versioned())) { failures = failures + 1; }
  return rc_summary(failures, 6);
}

@test fn t_persist() -> int32 {
  if (check_insert() != 0) { return 1; }
  if (check_insert_explicit_key() != 0) { return 2; }
  if (check_load() != 0) { return 3; }
  if (check_delete() != 0) { return 4; }
  if (check_insert_conflict_keeps_state() != 0) { return 5; }
  if (check_versioned() != 0) { return 6; }
  return 0;
}
