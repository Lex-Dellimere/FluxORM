// flux_raize_auth: a raize_auth store (RaStore) on flux_orm and MeoDB, as a
// library: no mb_bin. tests/store_live.mettle needs a running meodb, so it is
// not an mbuild test program; README.md says how to run it.
import "mbuild/api";

fn project() {
  mb_package("flux_raize_auth", "0.1.0");
  mb_meta("license", "Apache-2.0");
  mb_import_root("src");
  mb_targets("linux");
  // Live against meodb on 127.0.0.1:5491; skips when none is listening.
  mb_test_bin("store_live", "tests/store_live.mettle");
}

fn deps() {
  mb_dep_path("flux_orm", "../..");
  mb_dep_path("raize_auth", "../../../raize_auth");
  mb_dep_path("crypto", "../../../cryptex");
}
